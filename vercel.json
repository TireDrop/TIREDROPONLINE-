{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/tires/p/:sku", "destination": "/spa" },
    { "source": "/api/geo", "destination": "/api/status?geo=1" }
  ],
  "crons": [{ "path": "/api/cron/atd-sweep", "schedule": "0 12 * * *" }],
  "functions": {
    "api/cron/atd-sweep.js": { "maxDuration": 60 },
    "api/webhooks/shopify.js": { "maxDuration": 60 },
    "api/scan-tire-size.js": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "Permissions-Policy",
          "value": "accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), geolocation=(self), gyroscope=(), hid=(), magnetometer=(), microphone=(), midi=(), payment=(), publickey-credentials-get=(), screen-wake-lock=(), serial=(), usb=(), xr-spatial-tracking=(), browsing-topics=()"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'sha256-YCFAwUhB8u5u5zIHyMq5nc8xBtOkFKcU1+lKl6T4zLI=' https://*.googletagmanager.com https://translate.google.com https://translate.googleapis.com https://translate-pa.googleapis.com https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://translate.googleapis.com https://www.gstatic.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://api.bigdatacloud.net https://vpic.nhtsa.dot.gov https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://translate.google.com https://translate.googleapis.com https://translate-pa.googleapis.com; frame-src https://translate.google.com https://translate.googleapis.com; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; report-uri /api/csp-report"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "(.*)\\.vercel\\.app" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/brand/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/api/checkout",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/api/scan-tire-size",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/api/cron/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/(robots.txt|sitemap.xml)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=300" }]
    }
  ],
  "redirects": [
    { "source": "/coupons", "destination": "/tires", "statusCode": 301 },
    { "source": "/deals", "destination": "/tires", "statusCode": 301 },
    { "source": "/track-order", "destination": "/track", "statusCode": 301 },
    { "source": "/collections/tires", "destination": "/tires", "statusCode": 301 },
    { "source": "/collections/wheels", "destination": "/wheels", "statusCode": 301 },
    { "source": "/collections/tires/:path+", "destination": "/tires", "statusCode": 301 },
    { "source": "/collections/wheels/:path+", "destination": "/wheels", "statusCode": 301 },
    { "source": "/collections", "destination": "/tires", "statusCode": 301 },
    { "source": "/collections/:path*", "destination": "/tires", "statusCode": 301 },
    { "source": "/products", "destination": "/tires", "statusCode": 301 },
    { "source": "/products/:path*", "destination": "/tires", "statusCode": 301 },
    {
      "source": "/pages/:page(about|shipping|install|mobile-service|auto-service|commercial-tires|locations|contact|reviews|financing|terms|privacy|accessibility|find-my-tires|tire-size|tire-check)",
      "destination": "/:page",
      "statusCode": 301
    },
    { "source": "/gallery", "destination": "/about", "statusCode": 302 },
    { "source": "/pages/gallery", "destination": "/about", "statusCode": 302 },
    { "source": "/pages/tire-care", "destination": "/learn", "statusCode": 301 },
    { "source": "/tire-care", "destination": "/learn", "statusCode": 301 },
    {
      "source": "/tools/:tool(tire-size|tire-check|find-my-tires|tire-size-finder)",
      "destination": "/:tool",
      "statusCode": 301
    },
    { "source": "/tools/tread-gauge", "destination": "/tire-check", "statusCode": 301 },
    { "source": "/tools/load-speed-check", "destination": "/load-speed-check", "statusCode": 301 },
    { "source": "/tools/plus-size-speedo", "destination": "/plus-size-calculator", "statusCode": 301 },
    { "source": "/tools/plus-size", "destination": "/plus-size-calculator", "statusCode": 301 },
    { "source": "/tools/pressure-temp", "destination": "/tire-pressure-temperature", "statusCode": 301 },
    { "source": "/tools/pressure-temperature", "destination": "/tire-pressure-temperature", "statusCode": 301 },
    { "source": "/tools/damage-map", "destination": "/can-my-tire-be-repaired", "statusCode": 301 },
    { "source": "/tools/noise-vibration", "destination": "/car-shaking-checker", "statusCode": 301 },
    { "source": "/tools/rotation-pattern", "destination": "/tire-rotation-pattern", "statusCode": 301 },
    { "source": "/pages", "destination": "/", "statusCode": 301 },
    { "source": "/pages/:path*", "destination": "/", "statusCode": 301 },
    {
      "source": "/cart/c/:path*",
      "destination": "https://shop.tiredroponline.com/cart/c/:path*",
      "statusCode": 301
    },
    { "source": "/cart/:path+", "destination": "/cart", "statusCode": 301 },
    {
      "source": "/policies/privacy-policy",
      "destination": "/privacy",
      "statusCode": 301
    },
    { "source": "/policies/refund-policy", "destination": "/terms#returns", "statusCode": 301 },
    { "source": "/policies/shipping-policy", "destination": "/terms#shipping", "statusCode": 301 },
    { "source": "/policies/terms-of-service", "destination": "/terms", "statusCode": 301 },
    { "source": "/policies/contact-information", "destination": "/contact", "statusCode": 301 },
    { "source": "/policies/:path*", "destination": "/terms", "statusCode": 301 },
    { "source": "/blogs", "destination": "/blog", "statusCode": 301 },
    { "source": "/blogs/:path*", "destination": "/blog", "statusCode": 301 },
    {
      "source": "/account",
      "destination": "https://shop.tiredroponline.com/account",
      "statusCode": 301
    },
    {
      "source": "/account/:path*",
      "destination": "https://shop.tiredroponline.com/account/:path*",
      "statusCode": 301
    },
    {
      "source": "/checkouts/:path*",
      "destination": "https://shop.tiredroponline.com/checkouts/:path*",
      "statusCode": 301
    },
    {
      "source": "/:shopId(\\d+)/:kind(invoices|orders|checkouts)/:path*",
      "destination": "https://shop.tiredroponline.com/:shopId/:kind/:path*",
      "statusCode": 301
    }
  ]
}
