# Copy to `.env` and fill in. `.env` is gitignored, so real values never land
# in the repository. Vite only exposes variables it loads from a .env file —
# exporting these in the shell silently does nothing.
#
# Both are read at BUILD time, not run time, so changing either means a rebuild
# and a redeploy. Leaving them empty is a supported state: the forms then say
# plainly that nothing was sent and point at the phone, rather than claiming a
# reply nobody will send.

# Where the five forms POST. Any endpoint that accepts a JSON body works —
# Formspree, Basin, Netlify Forms, a Cloudflare Worker.
# Formspree: create a form at https://formspree.io, then paste the endpoint it
# gives you, which looks like https://formspree.io/f/xxxxxxxx
VITE_FORM_ENDPOINT=

# The address the confirmations quote back to the visitor. Defaults to
# BUSINESS.email (info@tiredroponline.com) when empty; set it to that same
# address so the deploy says so explicitly. It does not turn the forms on —
# only VITE_FORM_ENDPOINT does.
VITE_CONTACT_EMAIL=

# ---------------------------------------------------------------------------
# Server-side (Vercel Functions in api/). Set these in the Vercel dashboard:
# Project -> Settings -> Environment Variables. They are read at RUN time by
# the functions, never bundled into the browser, and need no rebuild — but
# Vercel only applies changed values to new deployments, so redeploy after
# editing. Leave a whole group empty to keep that integration off.
# Details: docs/integrations/atd.md, docs/integrations/shopify-checkout.md
# and docs/integrations/atd-forwarder.md.
# ---------------------------------------------------------------------------

# ATD (American Tire Distributors) "Ship to Home": tire data, dealer cost and
# stock. All empty = SAMPLE mode (the catalog in src/data/products.js).
# Setting ANY ATD_* variable in this group switches to LIVE (the forwarder's
# ATD_ORDERING_ENABLED / ATD_FORWARD_TEST_ORDERS below do not), and then every variable in this
# group plus PRICE_MARKUP_PCT and FREIGHT_PER_TIRE must be set, or tire search
# returns 503 naming what is missing. The request code is still unconfirmed
# against ATD's docs (see docs/integrations/atd.md).
ATD_API_BASE=
ATD_API_KEY=
ATD_API_SECRET=
ATD_ACCOUNT_NUMBER=
ATD_SHIP_TO=

# Retail pricing over ATD dealer cost (live mode only; sample prices are
# already retail). Required once ATD is live — "0" is allowed but must be
# explicit, so the store never sells at cost or eats freight by accident.
# price per tire = cost x (1 + PRICE_MARKUP_PCT / 100) + FREIGHT_PER_TIRE
PRICE_MARKUP_PCT=
FREIGHT_PER_TIRE=

# Shopify: hosted checkout through draft orders, and the ATD forwarder's
# access to the paid orders. All empty = OFF (checkout sends an order request
# instead of taking payment). Setting ANY SHOPIFY_* variable switches it on,
# and then the store domain plus exactly ONE way to authenticate must be set,
# or checkout returns 503 naming what is missing:
#   * SHOPIFY_ADMIN_TOKEN (shpat_...) from an existing admin-created custom
#     app, OR
#   * SHOPIFY_CLIENT_ID + SHOPIFY_CLIENT_SECRET from a Dev Dashboard app (the
#     API exchanges them for a 24-hour token itself).
# App scopes: write_draft_orders (+ read_draft_orders) for checkout; for the
# ATD forwarder also read_orders, write_orders,
# read_merchant_managed_fulfillment_orders and
# write_merchant_managed_fulfillment_orders.
# Payment is only taken once ATD is ALSO live; until then checkout stays in
# request mode so no card is charged against sample prices.
# The store's xxx.myshopify.com domain, not tiredroponline.com.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Optional. Default 2026-07; must be 2026-07 or newer.
SHOPIFY_API_VERSION=

# ATD forwarder: a Vercel Cron job (every 5 minutes, needs Vercel Pro) that
# places PAID Shopify orders with ATD and copies tracking back to Shopify.
# See docs/integrations/atd-forwarder.md.
# Kill switch, default off. Exactly "true" turns ordering on (it also needs
# Shopify checkout on and ATD live). Set it to anything else to stop ATD
# ordering at once without touching search or checkout. This switch does
# not count as an ATD credential: it never turns ATD's catalog on by itself.
ATD_ORDERING_ENABLED=
# Random string of 16+ characters. Vercel Cron sends it as
# "Authorization: Bearer <CRON_SECRET>"; /api/cron/atd-sweep answers 401 to
# anything else, and to everything while it is empty.
CRON_SECRET=
# ATD sandbox testing only: "true" also forwards Shopify TEST orders (Bogus
# Gateway). Leave empty in production, where a test order would buy real
# tires.
ATD_FORWARD_TEST_ORDERS=

# Where order REQUESTS go while payment is not live: any https endpoint that
# accepts a JSON POST (Formspree: https://formspree.io/f/xxxxxxxx). Empty =
# the order is only written to the function log, and checkout tells the
# shopper plainly that it was not sent.
ORDER_WEBHOOK_URL=
