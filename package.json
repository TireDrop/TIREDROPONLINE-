{
  "name": "tiredrop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender.mjs && node scripts/vpic-snapshot.mjs",
    "build:preview": "vite build --mode preview",
    "build:hubs": "node scripts/build-delivery-hubs.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "audit:mobile": "node scripts/mobile-audit.mjs",
    "check:newsletter": "node scripts/newsletter-signup-check.mjs",
    "check:forms": "node scripts/forms-keep-values-check.mjs",
    "check:prerender": "node scripts/prerender-check.mjs",
    "check:schema": "node scripts/schema-check.mjs",
    "check:docs": "node scripts/docs-links-check.mjs",
    "check:ga": "node scripts/ga-events-check.mjs",
    "check:remember": "node scripts/remember-check.mjs",
    "check:search": "node scripts/search-check.mjs",
    "check:a11y": "node scripts/a11y-check.mjs",
    "check:scanner": "node scripts/scanner-check.mjs",
    "check:home": "node scripts/home-check.mjs",
    "check:footer": "node scripts/footer-check.mjs",
    "check:sources": "node scripts/sources-check.mjs",
    "check:links": "node scripts/links-check.mjs",
    "check:local-delivery": "node scripts/local-delivery-check.mjs",
    "test:api": "node --test \"api/_lib/*.test.mjs\"",
    "test:content": "node --test \"src/content/*.test.mjs\"",
    "test:lib": "node --test \"src/lib/*.test.mjs\"",
    "test:sources": "node --test src/sourcesRule.test.mjs",
    "check:translate": "node scripts/translate-check.mjs",
    "test:data": "node --test \"src/data/*.test.mjs\"",
    "test:fitment": "node --test \"src/data/fitment*.test.mjs\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "js-yaml": "^4.3.2",
    "lucide-react": "^0.383.0",
    "marked": "^18.0.14",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "axe-core": "^4.13.0",
    "d3-geo": "^3.1.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "playwright": "^1.47.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "topojson-client": "^3.1.0",
    "us-atlas": "^3.0.1",
    "vite": "^5.1.4",
    "zipcodes": "^8.0.0"
  }
}
