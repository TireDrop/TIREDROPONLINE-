<!doctype html>
<html
  {% if request.design_mode %}
    class="shopify-design-mode"
  {% endif %}
  lang="{{ request.locale.iso_code }}"
>
  <head>
    {%- comment -%}
      TD-REDIRECT: shop.tiredroponline.com is checkout-only. The storefront
      lives on the Vercel site at tiredroponline.com, so any theme page served
      on shop.tiredroponline.com sends the visitor to the same path there
      (Vercel 301s the old /collections, /products, /pages, /policies, /blogs
      and /search paths to its own pages; / and /cart map 1:1).
      Runs first in <head> so nothing else loads before the jump.
      Never redirects:
      - other domains (etwheelz.com, account.etwheelz.com, *.myshopify.com)
      - the theme editor (design_mode / visual_preview_mode)
      - theme previews (?preview_theme_id=..., checked in JS)
      - customers/* (account, login, register, order, addresses, activate,
        reset_password), password and gift_card: Vercel sends /account back
        here, so redirecting them would loop.
      Checkout, invoices and order status are not theme pages and are never
      touched. The path goes through | json for the script and | escape for
      attributes; < and > are percent-encoded first so a crafted path cannot
      close the <script>. JS carries over the query string and hash.
    {%- endcomment -%}
    {%- liquid
      assign td_offsite = false
      if request.host == 'shop.tiredroponline.com'
        assign td_offsite = true
        if request.design_mode or request.visual_preview_mode
          assign td_offsite = false
        endif
        if template.directory == 'customers' or template.name == 'password' or template.name == 'gift_card'
          assign td_offsite = false
        endif
      endif
    -%}
    {%- if td_offsite -%}
      {%- assign td_path = request.path | default: '/' | replace: '<', '%3C' | replace: '>', '%3E' -%}
      {%- assign td_target = 'https://tiredroponline.com' | append: td_path -%}
      <script>
        if (!/[?&]preview_theme_id=/.test(location.search)) {
          location.replace('https://tiredroponline.com' + {{ td_path | json }} + location.search + location.hash);
        }
      </script>
      <noscript><meta http-equiv="refresh" content="0;url={{ td_target | escape }}"></noscript>
      <link rel="canonical" href="{{ td_target | escape }}">
      <meta name="robots" content="noindex">
    {%- endif -%}
    {%- if settings.favicon != blank -%}
      <link
        rel="icon"
        type="image/png"
        href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
      >
    {%- endif -%}

    {%- render 'view-transition-opt-in' -%}

    {%- render 'meta-tags' -%}
    {%- render 'stylesheets' -%}
    {%- render 'card-hover-effect-styles' -%}
    {%- render 'fonts' -%}
    {%- render 'scripts' -%}
    {%- render 'theme-styles-variables' -%}
    {%- render 'color-palette' -%}

    <style>
      /* TD-FIX: typography orphans. Storefront headings balance their lines;
         paragraphs and list items avoid a one-word last line. Headings take
         the shorthand as specified. p/li use the text-wrap-style longhand so
         they do NOT reset text-wrap-mode: a `white-space: nowrap` on a p/li
         (e.g. an ellipsis meta line, a chip) keeps working. Browsers without
         the longhand get the shorthand at zero specificity, so any class rule
         still wins. Header nav links, buttons and chips are a/button/span
         and are not targeted. */
      .page-wrapper :is(h1, h2, h3, h4) { text-wrap: balance; }
      .page-wrapper :is(p, li) { text-wrap-style: pretty; }
      @supports not (text-wrap-style: pretty) {
        :where(.page-wrapper) :where(p, li) { text-wrap: pretty; }
      }

      /* TD-FIX: Shopify's privacy opt-out form (/pages/data-sharing-opt-out)
         rendered with a grey 3px square "Opt out" outline, a round
         appearance:none checkbox floated off its label and a bare email
         field. Restyled to the site's primary button, a native square
         checkbox and the site's 44px field. Scoped to the form container. */
      #pc--optOutFormContainer {
        font-family: var(--font-body--family, Inter, system-ui, sans-serif);
        color: #070E1A;
      }
      #pc--optOutFormContainer .pc--show-email-field { margin: 1rem 0 0; }
      #pc--optOutFormContainer .pc--show-email-field label {
        position: static !important; display: inline-flex !important; align-items: center; gap: 10px;
        min-height: 44px; margin: 0 !important; padding: 0 !important;
        font-size: 15px; line-height: 1.4; color: #070E1A; cursor: pointer;
      }
      #pc--optOutFormContainer .pc--show-email-field label::before,
      #pc--optOutFormContainer .pc--show-email-field label::after { content: none !important; display: none !important; }
      #pc--optOutFormContainer .pc--show-email-field input[type="checkbox"] {
        -webkit-appearance: checkbox !important; appearance: auto !important;
        position: static !important; display: inline-block !important; flex: none;
        width: 18px !important; height: 18px !important; min-width: 18px; margin: 0 !important; padding: 0 !important;
        border-radius: 3px !important; opacity: 1 !important; visibility: visible !important; clip: auto !important;
        accent-color: #0068E8; cursor: pointer;
      }
      #pc--optOutFormContainer .pc--opt-out-form-field { display: grid; gap: 6px; max-width: 24rem; margin-top: .75rem; }
      #pc--optOutFormContainer .pc--opt-out-form-field label {
        position: static !important; font-size: 14px; font-weight: 600; color: #070E1A;
      }
      #pc--optOutFormContainer #pc--opt-out-email_input {
        box-sizing: border-box; width: 100%; height: 44px; margin: 0; padding: 0 14px;
        border: 1px solid rgba(7,14,26,.15) !important; border-radius: 6px !important;
        background: #FFFFFF; color: #070E1A; box-shadow: inset 0 1px 2px rgba(7,14,26,.04);
        font: inherit; font-size: 16px; -webkit-appearance: none; appearance: none; outline: none;
      }
      #pc--optOutFormContainer #pc--opt-out-email_input:focus {
        border-color: #0068E8 !important; box-shadow: 0 0 0 2px rgba(0,104,232,.15);
      }
      #pc--optOutFormContainer #pc--opt-out-button {
        display: inline-flex; align-items: center; justify-content: center; min-height: 44px;
        margin-top: 1rem; padding: 12px 24px !important;
        border: 0 !important; border-radius: 6px !important; outline: none;
        background: #0068E8 !important; color: #FFFFFF !important;
        box-shadow: 0 4px 14px -2px rgba(0,104,232,.35);
        font-family: var(--font-heading--family, "Archivo", system-ui, sans-serif);
        font-size: 15px; font-weight: 700; line-height: 1; letter-spacing: -0.005em; text-transform: none;
        cursor: pointer; transition: background-color .15s, box-shadow .15s;
      }
      #pc--optOutFormContainer #pc--opt-out-button:hover { background: #0053C4 !important; box-shadow: none; }
      #pc--optOutFormContainer #pc--opt-out-button:focus-visible { outline: 2px solid #0068E8; outline-offset: 2px; }
      #pc--optOutFormContainer #pc--opt-out-button::before,
      #pc--optOutFormContainer #pc--opt-out-button::after { content: none !important; }
    </style>

    {% if request.design_mode %}
      {%- render 'theme-editor' -%}
    {% endif %}

    {{ content_for_header }}
  </head>

  <body class="page-width-{{ settings.page_width }} card-hover-effect-{{ settings.card_hover_effect }}">
    {% render 'skip-to-content-link', href: '#MainContent', text: 'accessibility.skip_to_text' %}

    {% render 'chat-drawer' %}

    <div class="page-wrapper">
      <div id="header-group">
        {% sections 'header-group' %}
      </div>

      <script>
        /**
         * Sets `--header-height` and `--header-group-height` to measured values before first paint.
         *
         * A few CSS rules position content relative to the header at first paint — a hero sized to
         * the remaining viewport, a transparent header's negative margin. Without a measured value
         * those rules use the `60px` fallback from `sections/header.liquid`, and the content visibly
         * jumps once `header.js` corrects the values after load.
         *
         * Measuring forces layout mid-parse, so it only runs where a consuming rule exists.
         * Callers opt in: the transparent-header branch below, or `snippets/measure-header-heights.liquid`,
         * which any new first-paint consumer must render too.
         *
         * Measures once per page; after load, header.js's ResizeObservers keep the values fresh.
         * The group-height walk mimics calculateHeaderGroupHeight() in utilities.js — keep them
         * in sync.
         */
        window.measureHeaderHeights = (function () {
          let measured = false;

          return function measureHeaderHeights() {
            if (measured) return;

            const header = document.querySelector('#header-component');
            const headerGroup = document.querySelector('#header-group');

            if (!header || !headerGroup) return;
            measured = true;

            const headerHeight = header.offsetHeight;

            let headerGroupHeight = 0;
            for (const element of headerGroup.children) {
              if (element instanceof HTMLElement) headerGroupHeight += element.offsetHeight;
            }

            /**
             * A transparent header is absolutely positioned, so the loop above counts its section
             * wrapper as 0px. When a section follows it in the group, header.liquid pushes that
             * section down by the header's height using a margin, which offsetHeight also
             * excludes — so the header's height has to be added back manually.
             */
            if (header.hasAttribute('transparent') && header.parentElement?.nextElementSibling) {
              headerGroupHeight += headerHeight;
            }

            document.body.style.setProperty('--header-height', `${headerHeight}px`);
            document.body.style.setProperty('--header-group-height', `${headerGroupHeight}px`);
          };
        })();

        /**
         * Transparent-header rules consume the measured heights at first paint on every
         * template, so the transparent case opts in globally here instead of per-section.
         */
        if (document.querySelector('#header-component')?.hasAttribute('transparent')) {
          measureHeaderHeights();
        }

        /**
         * Sets `--top-row-height`, consumed by the header underlays and submenus. Deferred to a
         * rAF so the height read doesn't force layout mid-parse, and scoped to the
         * header, where all consumers live, so the write only invalidates the header subtree.
         * Mimics the `--top-row-height` write in updateHeaderHeights() in utilities.js
         */
        (function setTopRowHeight() {
          const header = document.querySelector('#header-component');
          const headerTopRow = header?.querySelector('.header__row--top');
          if (!headerTopRow) return;

          window.requestAnimationFrame(function () {
            header.style.setProperty('--top-row-height', `${headerTopRow.getBoundingClientRect().height}px`);
          });
        })();

        /**
         * Sets `--transparent-header-offset-boolean` when the first section must offset itself
         * under a transparent header. The non-offset case relies on the `0` default declared in
         * sections/header.liquid — unlike updateTransparentHeaderOffset() in utilities.js, which
         * re-runs on editor changes and must write '0' to reset a previously written '1'.
         */
        (function updateTransparentHeaderOffset() {
          const header = document.querySelector('#header-component');
          const headerSection = document.querySelector('#header-group .header-section');
          if (!headerSection || !header?.hasAttribute('transparent')) return;

          const hasImmediateSection = headerSection.nextElementSibling?.classList.contains('shopify-section');
          if (!hasImmediateSection) {
            document.body.style.setProperty('--transparent-header-offset-boolean', '1');
          }
        })();

        /**
         * Sets the initial menu style (inline menu vs. drawer) on the header component.
         * Mimics setHeaderMenuStyle() in utilities.js
         */
        (function setHeaderMenuStyle() {
          const headerComponent = document.querySelector('#header-component');
          if (headerComponent) {
            const isTouchDevice = 'ontouchstart' in window && navigator.maxTouchPoints > 0;
            const overflowList = headerComponent.querySelector('overflow-list');
            const hasReachedMinimum = overflowList && overflowList.hasAttribute('minimum-reached');
            headerComponent.dataset.menuStyle = isTouchDevice || hasReachedMinimum ? 'drawer' : 'menu';
          }
        })();
      </script>

      <main
        id="MainContent"
        class="content-for-layout"
        role="main"
        data-page-transition-enabled="{{ settings.page_transition_enabled }}"
        data-product-transition="{{ settings.transition_to_main_product }}"
        data-template="{{ template }}"
      >
        {{ content_for_layout }}
      </main>

      <footer>
        {% sections 'footer-group' %}
      </footer>
    </div>

    {% render 'cart-drawer', render_wrapper: true %}
    {% render 'theme-drawer' %}

    {% render 'search-modal' %}

    {% if settings.quick_add or settings.mobile_quick_add %}
      {% render 'quick-add-modal' %}
    {% endif %}

    {% render 'td-table-stack' %}
  </body>
</html>
