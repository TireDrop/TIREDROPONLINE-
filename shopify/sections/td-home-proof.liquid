{% comment %}
  "Why TireDrop" (React HomePage <Proof>), ported without anything the store
  cannot stand behind:
  - React's 4.8 star rating and its placeholder quote are not real and
    are not ported. The quotes on /pages/reviews are labelled there as written
    examples, so none of those are reused either. The card instead links to
    the shop's real Google and Yelp profiles (the URLs React and /pages/reviews
    already use) and lets the reader see the real thing.
  - React's "20+ years" and "6 tire brands" stats are replaced with facts that
    do not go stale or imply stock: free shipping and the install-town count.
  Stats are blocks, so they stay editable.
{% endcomment %}

{{ 'td-home.css' | asset_url | stylesheet_tag }}

<section class="tdh tdh--fog tdh-pad td-proof" aria-labelledby="td-proof-{{ section.id }}">
  <div class="tdh-wrap td-proof__grid">
    <div>
      {%- if section.settings.eyebrow != blank -%}<p class="tdh-eyebrow td-proof__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="tdh-h2" id="td-proof-{{ section.id }}">{{ section.settings.heading }}</h2>
      {%- if section.settings.lede != blank -%}<p class="tdh-lede td-proof__lede">{{ section.settings.lede }}</p>{%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <dl class="td-proof__stats">
          {%- for block in section.blocks -%}
            <div class="td-proof__stat" {{ block.shopify_attributes }}>
              <dt class="td-proof__label">{{ block.settings.label }}</dt>
              <dd class="td-proof__value">{{ block.settings.value }}</dd>
            </div>
          {%- endfor -%}
        </dl>
      {%- endif -%}

      {%- if section.settings.story_label != blank -%}
        <a class="tdh-btn tdh-btn--outline tdh-btn--sm td-proof__story" href="{{ section.settings.story_link | default: '/pages/about' }}">{{ section.settings.story_label }}</a>
      {%- endif -%}
    </div>

    <div class="tdh-card td-proof__card">
      <div class="td-proof__cardhead">
        <p class="td-proof__kicker">{{ section.settings.card_kicker }}</p>
        <h3 class="tdh-h3">{{ section.settings.card_heading }}</h3>
      </div>
      <p class="td-proof__cardcopy">{{ section.settings.card_copy }}</p>
      <div class="td-proof__links">
        {%- if section.settings.google_url != blank -%}
          <a class="tdh-btn tdh-btn--primary tdh-btn--sm" href="{{ section.settings.google_url }}" target="_blank" rel="noopener noreferrer">
            {{ section.settings.google_label }}
            {%- render 'td-home-icon', name: 'external-link', size: 14 -%}
            <span class="tdh-sr">(opens in a new tab)</span>
          </a>
        {%- endif -%}
        {%- if section.settings.yelp_url != blank -%}
          <a class="tdh-btn tdh-btn--outline tdh-btn--sm" href="{{ section.settings.yelp_url }}" target="_blank" rel="noopener noreferrer">
            {{ section.settings.yelp_label }}
            {%- render 'td-home-icon', name: 'external-link', size: 14 -%}
            <span class="tdh-sr">(opens in a new tab)</span>
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<style>
  .td-proof .td-proof__grid { display: grid; gap: 2.5rem; }
  .td-proof .td-proof__eyebrow { margin-bottom: .5rem; }
  .td-proof .tdh-h2 { text-wrap: balance; } /* TD-FIX: balance headings */
  .td-proof .td-proof__lede { margin-top: 1rem; max-width: 36rem; }
  .td-proof .td-proof__stats {
    margin: 2rem 0 0; display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 1.25rem;
  }
  /* Value first on screen, label first for a screen reader. */
  .td-proof .td-proof__stat { display: flex; flex-direction: column-reverse; justify-content: flex-end; }
  .td-proof .td-proof__value {
    margin: 0; font-family: var(--font-heading--family, "Archivo", system-ui, sans-serif);
    font-size: 2.25rem; font-weight: 400; line-height: 1.1; color: #0068E8; font-variant-numeric: tabular-nums;
  }
  .td-proof .td-proof__label { margin: .25rem 0 0; font-size: 13px; line-height: 1.4; color: #586274; }
  .td-proof .td-proof__story { margin-top: 2rem; }
  .td-proof .td-proof__card { padding: 1.75rem; }
  .td-proof .td-proof__cardhead { padding-bottom: 1.25rem; border-bottom: 1px solid rgba(7,14,26,.1); }
  .td-proof .td-proof__kicker {
    margin: 0 0 .25rem; font-family: var(--font-heading--family, "Archivo", system-ui, sans-serif);
    font-size: .875rem; font-weight: 600; color: #586274;
  }
  .td-proof .td-proof__cardcopy { margin: 1.25rem 0 0; font-size: .875rem; line-height: 1.625; color: #586274; }
  .td-proof .td-proof__links { margin-top: 1.5rem; display: grid; gap: .625rem; }
  .td-proof .td-proof__links .tdh-btn { width: 100%; }
  @media (min-width: 640px) {
    .td-proof .td-proof__stats { grid-template-columns: repeat(4, minmax(0,1fr)); }
    .td-proof .td-proof__links { grid-template-columns: repeat(2, minmax(0,1fr)); }
  }
  @media (min-width: 1024px) {
    .td-proof .td-proof__grid { grid-template-columns: 1fr 1.1fr; align-items: center; }
    .td-proof .td-proof__stats { grid-template-columns: repeat(2, minmax(0,1fr)); }
  }
</style>

{% schema %}
{
  "name": "TireDrop why us",
  "tag": "div",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why TireDrop" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "An online tire store with a real shop behind it" },
    { "type": "textarea", "id": "lede", "label": "Supporting copy", "default": "Extreme Tires mounts tires in Sunrise, and TireDrop is the same crew selling online. Orders ship direct to wherever you want them: your own door anywhere in the 48 contiguous states and DC, or our bay in Sunrise." },
    { "type": "text", "id": "story_label", "label": "Button label", "default": "Our story" },
    { "type": "url", "id": "story_link", "label": "Button link" },
    { "type": "header", "content": "Reviews card" },
    { "type": "text", "id": "card_kicker", "label": "Kicker", "default": "Customer reviews" },
    { "type": "text", "id": "card_heading", "label": "Heading", "default": "Read the real ones" },
    { "type": "textarea", "id": "card_copy", "label": "Copy", "default": "TireDrop is new, so its own reviews are still being collected. The shop behind it is not: both profiles below are Extreme Tires'. We do not reprint star counts here — open either one and read what is actually there." },
    { "type": "text", "id": "google_label", "label": "Google button", "default": "Extreme Tires on Google" },
    { "type": "url", "id": "google_url", "label": "Google link" },
    { "type": "text", "id": "yelp_label", "label": "Yelp button", "default": "Extreme Tires on Yelp" },
    { "type": "url", "id": "yelp_url", "label": "Yelp link" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "text", "id": "value", "label": "Figure" },
        { "type": "text", "id": "label", "label": "Label" }
      ]
    }
  ],
  "presets": [
    {
      "name": "TireDrop why us",
      "blocks": [
        { "type": "stat", "settings": { "value": "48", "label": "States we ship to, plus DC" } },
        { "type": "stat", "settings": { "value": "$0", "label": "Shipping, with no minimum" } },
        { "type": "stat", "settings": { "value": "12", "label": "Services at the shop" } },
        { "type": "stat", "settings": { "value": "10", "label": "Install towns we cover" } }
      ]
    }
  ]
}
{% endschema %}
