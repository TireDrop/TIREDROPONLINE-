{% comment %}
  Numbered steps from search to installed. The step numerals are decoration —
  the step's own heading carries the meaning — so they are hidden from the
  accessibility tree rather than read out as a bare "01".
{% endcomment %}

<section class="td-steps">
  <div class="td-steps__inner">
    <div class="td-steps__head">
      {% if section.settings.eyebrow != blank %}
        <p class="td-eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      <h2 class="td-h2">{{ section.settings.heading }}</h2>
      {% if section.settings.lede != blank %}
        <p class="td-lede">{{ section.settings.lede }}</p>
      {% endif %}
    </div>

    <ol class="td-steps__list">
      {% for block in section.blocks %}
        <li class="td-steps__item" {{ block.shopify_attributes }}>
          <span aria-hidden="true" class="td-steps__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          <h3 class="td-steps__title">{{ block.settings.title }}</h3>
          <p class="td-steps__copy">{{ block.settings.copy }}</p>
        </li>
      {% endfor %}
    </ol>
  </div>
</section>

<style>
  .td-steps { background: #FFFFFF; }
  .td-steps__inner { max-width: 1280px; margin: 0 auto; padding: 3.5rem 1rem; }
  .td-steps__head { max-width: 40rem; margin-bottom: 2rem; }
  .td-steps__list { display: grid; gap: 1.5rem; list-style: none; padding: 0; margin: 0; counter-reset: none; }
  .td-steps__item { border-top: 1px solid rgba(7,14,26,.1); padding-top: 1rem; }
  .td-steps__num {
    display: block; font-family: var(--font-heading--family, inherit);
    font-size: 2.25rem; font-weight: 800; line-height: 1;
    color: rgba(0,104,232,.15); margin-bottom: .5rem;
  }
  .td-steps__title {
    font-family: var(--font-heading--family, inherit);
    font-size: 1.0625rem; font-weight: 700; margin: 0 0 .375rem; color: #070E1A;
  }
  .td-steps__copy { margin: 0; font-size: .875rem; line-height: 1.6; color: #586274; }
  @media (min-width: 768px) { .td-steps__inner { padding: 4.5rem 2rem; } }
  @media (min-width: 1024px) { .td-steps__list { grid-template-columns: repeat(4, minmax(0,1fr)); gap: 1.5rem; } }
</style>

{% schema %}
{
  "name": "TireDrop how it works",
  "tag": "section",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "How it works" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Four steps from search to installed" },
    { "type": "textarea", "id": "lede", "label": "Supporting copy", "default": "No stock sitting in a warehouse waiting to age — orders ship direct, so what turns up on your drive is fresh rubber." }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "copy", "label": "Copy" }
      ]
    }
  ],
  "presets": [
    {
      "name": "TireDrop how it works",
      "blocks": [
        { "type": "step", "settings": { "title": "Find your size", "copy": "Read it off the sidewall, or use the size decoder if the numbers mean nothing to you yet." } },
        { "type": "step", "settings": { "title": "Pick your set", "copy": "Price, tread life, wet grip and warranty are on every listing, so you are comparing the same things across brands." } },
        { "type": "step", "settings": { "title": "Choose where it lands", "copy": "Your address anywhere in the continental US, or free to our Sunrise shop for fitting." } },
        { "type": "step", "settings": { "title": "We confirm before it ships", "copy": "We check the sizes against your vehicle and call you to confirm fitment and take payment." } }
      ]
    }
  ]
}
{% endschema %}
