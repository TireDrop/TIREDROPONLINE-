{% comment %}
  Numbered steps from search to installed (React HomePage <HowItWorks>). The
  step numerals are decoration (the step's own heading carries the meaning),
  so they are hidden from the accessibility tree rather than read out as a
  bare "01". The list is an <ol>, which already announces the order.
{% endcomment %}

{{ 'td-home.css' | asset_url | stylesheet_tag }}

<section class="tdh tdh--bone tdh-pad td-steps" aria-labelledby="td-steps-{{ section.id }}">
  <div class="tdh-wrap">
    <div class="tdh-head{% if section.settings.action_label != blank %} tdh-head--action{% endif %}">
      <div class="tdh-head__text">
        {%- if section.settings.eyebrow != blank -%}<p class="tdh-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="tdh-h2" id="td-steps-{{ section.id }}">{{ section.settings.heading }}</h2>
        {%- if section.settings.lede != blank -%}<p class="tdh-lede">{{ section.settings.lede }}</p>{%- endif -%}
      </div>
      {%- if section.settings.action_label != blank -%}
        <div class="tdh-head__action">
          <a class="tdh-btn tdh-btn--outline tdh-btn--sm" href="{{ section.settings.action_link | default: '/pages/shipping' }}">{{ section.settings.action_label }}</a>
        </div>
      {%- endif -%}
    </div>

    <ol class="td-steps__list">
      {%- for block in section.blocks -%}
        <li class="tdh-card td-steps__item" {{ block.shopify_attributes }}>
          <span aria-hidden="true" class="td-steps__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          <h3 class="tdh-h3 td-steps__title">{{ block.settings.title }}</h3>
          <p class="td-steps__copy">{{ block.settings.copy }}</p>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

<style>
  .td-steps .td-steps__list {
    list-style: none; padding: 0; margin: 0;
    display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: .75rem;
  }
  .td-steps .td-steps__item { padding: 1.5rem; }
  .td-steps .td-steps__num {
    display: block; font-family: var(--font-heading--family, "Archivo", system-ui, sans-serif);
    font-size: 3rem; font-weight: 400; line-height: 1; color: rgba(0,104,232,.15);
  }
  .td-steps .td-steps__title { margin-top: .75rem; }
  .td-steps .td-steps__copy { margin: .5rem 0 0; font-size: .875rem; line-height: 1.625; color: #586274; }
  @media (max-width: 479px) { .td-steps .td-steps__item { padding: 1.125rem; } }
  @media (min-width: 640px) { .td-steps .td-steps__list { gap: 1rem; } }
  @media (min-width: 1024px) { .td-steps .td-steps__list { grid-template-columns: repeat(4, minmax(0,1fr)); } }
</style>

{% schema %}
{
  "name": "TireDrop how it works",
  "tag": "div",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "How it works" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Four steps from search to installed" },
    { "type": "textarea", "id": "lede", "label": "Supporting copy", "default": "No stock sitting in a warehouse waiting to age — orders ship direct, so what turns up on your drive is fresh rubber." },
    { "type": "text", "id": "action_label", "label": "Button label", "default": "Shipping details" },
    { "type": "url", "id": "action_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "copy", "label": "Copy" }
      ]
    }
  ],
  "presets": [
    {
      "name": "TireDrop how it works",
      "blocks": [
        { "type": "step", "settings": { "title": "Find your size", "copy": "Search by vehicle or by the numbers on your sidewall and compare the whole catalog." } },
        { "type": "step", "settings": { "title": "Pick your delivery", "copy": "Ship to your address, or free to the shop if you're in South Florida." } },
        { "type": "step", "settings": { "title": "We confirm and release it", "copy": "We check the fitment against your vehicle, then release the order to ship." } },
        { "type": "step", "settings": { "title": "Fit them your way", "copy": "Use your own installer, or let us mount and balance them here in the bay." } }
      ]
    }
  ]
}
{% endschema %}
