{% comment %}
  The three free tools. Dark band, so every text colour here is pinned rather
  than inherited — the same section on Horizon's light defaults would render
  near-black on navy.
{% endcomment %}

<section class="td-tools">
  <div class="td-tools__inner">
    <div class="td-tools__head">
      {% if section.settings.eyebrow != blank %}
        <p class="td-tools__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      <h2 class="td-tools__h2">{{ section.settings.heading }}</h2>
      {% if section.settings.lede != blank %}
        <p class="td-tools__lede">{{ section.settings.lede }}</p>
      {% endif %}
    </div>

    <div class="td-tools__grid">
      {% for block in section.blocks %}
        {% if block.settings.link != blank %}
          <a href="{{ block.settings.link }}" class="td-tools__card" {{ block.shopify_attributes }}>
        {% else %}
          <div class="td-tools__card" {{ block.shopify_attributes }}>
        {% endif %}
          <h3 class="td-tools__title">{{ block.settings.title }}</h3>
          <p class="td-tools__copy">{{ block.settings.copy }}</p>
          {% if block.settings.link != blank %}
            <span class="td-tools__cta">Open it <span aria-hidden="true">&rarr;</span></span>
          </a>
          {% else %}
          </div>
          {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<style>
  .td-tools {
    background: radial-gradient(120% 90% at 50% -10%, #17293F 0%, #0A1526 45%, #070E1A 100%);
    color: #FFFFFF;
  }
  .td-tools__inner { max-width: 1280px; margin: 0 auto; padding: 3.5rem 1rem; }
  .td-tools__head { max-width: 40rem; margin-bottom: 2rem; margin-left: auto; margin-right: auto; text-align: center; }
  .td-tools__eyebrow {
    font-family: var(--font-subheading--family, inherit);
    font-size: .75rem; font-weight: 700; letter-spacing: .09em;
    text-transform: uppercase; color: #00B4FC; margin: 0 0 .625rem;
  }
  .td-tools__h2 {
    font-family: var(--font-heading--family, inherit);
    font-weight: 800; letter-spacing: -.02em; line-height: 1.05;
    font-size: clamp(1.75rem, 4vw, 2.5rem); margin: 0; color: #FFFFFF;
    text-wrap: balance;
  }
  .td-tools__lede { margin: .875rem auto 0; max-width: 36rem; text-wrap: pretty; font-size: 1.0625rem; line-height: 1.6; color: rgba(255,255,255,.75); }
  .td-tools__grid { display: grid; gap: .75rem; }
  .td-tools__card {
    display: flex; flex-direction: column; text-decoration: none;
    background: linear-gradient(180deg, #14233A 0%, #0B1524 100%);
    border: 1px solid #22344C; border-radius: 12px; padding: 1.5rem;
    transition: border-color .15s ease;
  }
  .td-tools__card:hover { border-color: rgba(0,180,252,.4); }
  .td-tools__title {
    font-family: var(--font-heading--family, inherit);
    font-size: 1.25rem; font-weight: 700; margin: 0 0 .5rem; color: #FFFFFF;
  }
  .td-tools__copy { margin: 0 0 1rem; flex: 1; font-size: .875rem; line-height: 1.6; color: rgba(255,255,255,.7); }
  .td-tools__cta {
    font-family: var(--font-heading--family, inherit);
    font-weight: 700; font-size: .875rem; color: #00B4FC;
    display: inline-flex; align-items: center; gap: .375rem;
  }
  @media (min-width: 768px) { .td-tools__inner { padding: 4.5rem 2rem; } }
  @media (min-width: 900px) { .td-tools__grid { grid-template-columns: repeat(3, minmax(0,1fr)); gap: 1rem; } }
</style>

{% schema %}
{
  "name": "TireDrop tools band",
  "tag": "section",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Free, no email required" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Not sure what you need? Start here" },
    { "type": "textarea", "id": "lede", "label": "Supporting copy", "default": "Three tools that answer the questions that stop people buying tires online. They work whether or not you buy anything from us." }
  ],
  "blocks": [
    {
      "type": "tool",
      "name": "Tool",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "copy", "label": "Copy" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "TireDrop tools band",
      "blocks": [
        { "type": "tool", "settings": { "title": "Decode my tire size", "copy": "Type what is on your sidewall and see every number explained, drawn to the proportions of your own tire. Compare two sizes and see what actually changes." } },
        { "type": "tool", "settings": { "title": "Find my tires", "copy": "Five questions about your car, your roads and your weather. You get the size and tire type that fit, and why." } },
        { "type": "tool", "settings": { "title": "Do I need tires yet?", "copy": "Check the tread with a coin you already have, and the age with the code on the sidewall. If they are fine, it says so." } }
      ]
    }
  ]
}
{% endschema %}
