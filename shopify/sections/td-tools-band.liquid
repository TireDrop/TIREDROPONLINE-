{% comment %}
  The three free tools (React HomePage <ToolsBand>). Dark band, so every text
  colour here is pinned rather than inherited: the same section on Horizon's
  light defaults would render near-black on navy.
{% endcomment %}

{{ 'td-home.css' | asset_url | stylesheet_tag }}

<section class="tdh tdh--ink tdh-pad td-tools" aria-labelledby="td-tools-{{ section.id }}">
  <div class="tdh-wrap">
    <div class="tdh-head">
      <div class="tdh-head__text">
        {%- if section.settings.eyebrow != blank -%}<p class="tdh-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="tdh-h2" id="td-tools-{{ section.id }}">{{ section.settings.heading }}</h2>
        {%- if section.settings.lede != blank -%}<p class="tdh-lede">{{ section.settings.lede }}</p>{%- endif -%}
      </div>
    </div>

    <ul class="td-tools__grid" role="list">
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" class="td-tools__card">
          {%- else -%}
            <div class="td-tools__card">
          {%- endif -%}
            {%- render 'td-home-icon', name: block.settings.icon, size: 24, class: 'tdh-icon td-tools__icon' -%}
            <h3 class="tdh-h3 td-tools__title">{{ block.settings.title }}</h3>
            <p class="td-tools__copy">{{ block.settings.copy }}</p>
          {%- if block.settings.link != blank -%}
            <span class="td-tools__cta">{{ section.settings.card_cta }}{%- render 'td-home-icon', name: 'arrow-right', size: 15 -%}</span>
            </a>
          {%- else -%}
            </div>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

<style>
  .td-tools .td-tools__grid { list-style: none; margin: 2rem 0 0; padding: 0; display: grid; gap: .75rem; }
  .td-tools .td-tools__card {
    height: 100%; display: flex; flex-direction: column; text-decoration: none;
    background: linear-gradient(180deg, #14233A 0%, #0B1524 100%);
    border: 1px solid #22344C; border-radius: 12px; padding: 1.25rem;
    transition: border-color .15s ease;
  }
  .td-tools a.td-tools__card:hover { border-color: rgba(0,180,252,.4); }
  .td-tools .td-tools__icon { margin-bottom: 1rem; }
  .td-tools .td-tools__title { color: #FFFFFF; }
  .td-tools .td-tools__copy { flex: 1; margin: .5rem 0 0; font-size: .875rem; line-height: 1.625; color: rgba(255,255,255,.72); }
  .td-tools .td-tools__cta {
    margin-top: 1rem; display: flex; align-items: center; gap: .375rem;
    font-family: var(--font-heading--family, "Archivo", system-ui, sans-serif);
    font-weight: 700; font-size: .875rem; color: #00B4FC;
  }
  .td-tools .td-tools__cta .td-home-icon { transition: transform .15s ease; }
  .td-tools a.td-tools__card:hover .td-tools__cta .td-home-icon { transform: translateX(4px); }
  @media (min-width: 640px) { .td-tools .td-tools__grid { gap: 1rem; } .td-tools .td-tools__card { padding: 1.5rem; } }
  @media (min-width: 1024px) { .td-tools .td-tools__grid { grid-template-columns: repeat(3, minmax(0,1fr)); } }
</style>

{% schema %}
{
  "name": "TireDrop tools band",
  "tag": "div",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Free, no email required" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Not sure what you need? Start here" },
    { "type": "textarea", "id": "lede", "label": "Supporting copy", "default": "Three tools that answer the questions that stop people buying tires online. They work whether or not you buy anything from us." },
    { "type": "text", "id": "card_cta", "label": "Card link text", "default": "Open it" }
  ],
  "blocks": [
    {
      "type": "tool",
      "name": "Tool",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "ruler", "options": [
          { "value": "ruler", "label": "Ruler" },
          { "value": "list-checks", "label": "Checklist" },
          { "value": "gauge", "label": "Gauge" },
          { "value": "search", "label": "Search" }
        ] },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "copy", "label": "Copy" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "TireDrop tools band",
      "blocks": [
        { "type": "tool", "settings": { "icon": "ruler", "title": "Decode my tire size", "copy": "Type what is on your sidewall and see every number explained, drawn to the proportions of your own tire. Compare two sizes and see what actually changes." } },
        { "type": "tool", "settings": { "icon": "list-checks", "title": "Find my tires", "copy": "Five questions about your car, your roads and your weather. You get the size and tire type that fit, and why." } },
        { "type": "tool", "settings": { "icon": "gauge", "title": "Do I need tires yet?", "copy": "Check the tread with a coin you already have, and the age with the code on the sidewall. If they are fine, it says so." } }
      ]
    }
  ]
}
{% endschema %}
