{% comment %}
  Financing page. Ported from the React FinancingPage (src/pages/support/FinancingPage.jsx).
  The form is an interest / pre-qualification enquiry sent through Shopify's
  native contact form, not a credit application. The page names no lender and
  quotes no rate, APR or monthly payment.
  Fields: contact[name], contact[email], contact[phone], contact[Amount needed (USD)],
  plus a hidden contact[Enquiry] so the inbox can tell it apart.
{% endcomment %}
{%- liquid
  assign tdp_digits = section.settings.phone | remove: '(' | remove: ')' | remove: ' ' | remove: '-' | remove: '.'
  assign tdp_tel = 'tel:+1' | append: tdp_digits
-%}
<div class="tdp tdp-fin">
  <div class="tdp-hero">
    <div class="tdp-hero__line" aria-hidden="true"></div>
    <div class="tdp-wrap tdp-hero__inner">
      {%- if section.settings.hero_eyebrow != blank -%}
        <p class="tdp-eyebrow"><span class="tdp-rule" aria-hidden="true"></span>{{ section.settings.hero_eyebrow }}</p>
      {%- endif -%}
      <h1 class="tdp-h1">{{ section.settings.hero_title }}</h1>
      {%- if section.settings.hero_lede != blank -%}
        <p class="tdp-hero__lede">{{ section.settings.hero_lede }}</p>
      {%- endif -%}
      <div class="tdp-hero__actions">
        {%- if section.settings.hero_cta_label != blank -%}<a href="#apply" class="tdp-btn tdp-btn--primary">{{ section.settings.hero_cta_label }}</a>{%- endif -%}
        <a href="{{ tdp_tel }}" class="tdp-btn tdp-btn--ghost"><svg class="tdp-ic" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>{{ section.settings.phone }}</a>
  </div>
    </div>
  </div>

  <nav class="tdp-crumbs" aria-label="Breadcrumb">
    <ol class="tdp-wrap">
      <li><a href="{{ routes.root_url }}">Home</a></li>
      <li><svg class="tdp-ic" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m9 18 6-6-6-6"/></svg><span aria-current="page">{{ section.settings.crumb }}</span></li>
    </ol>
  </nav>

  <section class="tdp-sec tdp-bone">
    <div class="tdp-wrap">
      <div class="tdp-head">
      <div class="tdp-head__text">
        {%- if section.settings.pay_eyebrow != blank -%}<p class="tdp-eyebrow"><span class="tdp-rule" aria-hidden="true"></span>{{ section.settings.pay_eyebrow }}</p>{%- endif -%}
        <h2 class="tdp-h2">{{ section.settings.pay_title }}</h2>
        {%- if section.settings.pay_lede != blank -%}<p class="tdp-lede">{{ section.settings.pay_lede }}</p>{%- endif -%}
      </div>
    </div>
      <ul class="tdp-grid tdp-sm2 tdp-lg4">
        {%- for block in section.blocks -%}
          {%- if block.type == 'method' -%}
            <li class="tdp-card tdp-p6" {{ block.shopify_attributes }}>
              {%- case block.settings.icon -%}{%- when 'credit-card' -%}<svg class="tdp-ic tdp-ic-lead" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/></svg>{%- when 'wallet' -%}<svg class="tdp-ic tdp-ic-lead" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M19 7V4a1 1 0 0 0-1-1H5a2 2 0 0 0 0 4h15a1 1 0 0 1 1 1v4h-3a2 2 0 0 0 0 4h3a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1"/><path d="M3 5v14a2 2 0 0 0 2 2h15a1 1 0 0 0 1-1v-4"/></svg>{%- when 'store' -%}<svg class="tdp-ic tdp-ic-lead" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m2 7 4.41-4.41A2 2 0 0 1 7.83 2h8.34a2 2 0 0 1 1.42.59L22 7"/><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><path d="M15 22v-4a2 2 0 0 0-2-2h-2a2 2 0 0 0-2 2v4"/><path d="M2 7h20"/><path d="M22 7v3a2 2 0 0 1-2 2v0a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 16 12a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 12 12a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 8 12a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 4 12v0a2 2 0 0 1-2-2V7"/></svg>{%- when 'truck' -%}<svg class="tdp-ic tdp-ic-lead" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14"/><circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/></svg>{%- when 'phone' -%}<svg class="tdp-ic tdp-ic-lead" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>{%- when 'file-text' -%}<svg class="tdp-ic tdp-ic-lead" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/></svg>{%- endcase -%}
              <h3 class="tdp-h3">{{ block.settings.title }}</h3>
              <p class="tdp-small tdp-fin__gap2">{{ block.settings.copy }}</p>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
      {%- if section.settings.pay_note != blank -%}
        <p class="tdp-small tdp-fin__gap6">{{ section.settings.pay_note }} <a href="{{ tdp_tel }}" class="tdp-fin__u">{{ section.settings.phone }}</a> before you order.</p>
      {%- endif -%}
    </div>
  </section>

  <section class="tdp-sec tdp-fog">
    <div class="tdp-wrap">
      <div class="tdp-head">
      <div class="tdp-head__text">
        {%- if section.settings.plans_eyebrow != blank -%}<p class="tdp-eyebrow"><span class="tdp-rule" aria-hidden="true"></span>{{ section.settings.plans_eyebrow }}</p>{%- endif -%}
        <h2 class="tdp-h2">{{ section.settings.plans_title }}</h2>
        {%- if section.settings.plans_lede != blank -%}<p class="tdp-lede">{{ section.settings.plans_lede }}</p>{%- endif -%}
      </div>
    </div>
      <ul class="tdp-grid tdp-lg3">
        {%- for block in section.blocks -%}
          {%- if block.type == 'plan' -%}
            <li class="tdp-card tdp-p6 tdp-fin__plan{% if block.settings.highlight %} is-highlight{% endif %}" {{ block.shopify_attributes }}>
              <div class="tdp-fin__planhead">
                <h3 class="tdp-h3">{{ block.settings.name }}</h3>
                {%- if block.settings.tag != blank -%}<span class="tdp-badge {% if block.settings.highlight %}tdp-badge--drop{% else %}tdp-badge--soft{% endif %}">{{ block.settings.tag }}</span>{%- endif -%}
              </div>
              <p class="tdp-small">{{ block.settings.summary }}</p>
              {%- assign tdp_points = block.settings.points | newline_to_br | split: '<br />' -%}
              <ul class="tdp-checks tdp-fin__points">
                {%- for point in tdp_points -%}{%- assign t = point | strip -%}{%- if t != blank -%}<li><svg class="tdp-ic" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg><span>{{ t }}</span></li>{%- endif -%}{%- endfor -%}
              </ul>
              {%- if block.settings.note != blank -%}<p class="tdp-xs tdp-fin__foot">{{ block.settings.note }}</p>{%- endif -%}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
      {%- if section.settings.plans_note != blank -%}
        <p class="tdp-small tdp-fin__info"><svg class="tdp-ic tdp-drop" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg><span>{{ section.settings.plans_note }}</span></p>
      {%- endif -%}
    </div>
  </section>

  <section class="tdp-sec tdp-bone">
    <div class="tdp-wrap tdp-fin__two">
      <div>
        <div class="tdp-head"><div class="tdp-head__text">
          {%- if section.settings.req_eyebrow != blank -%}<p class="tdp-eyebrow"><span class="tdp-rule" aria-hidden="true"></span>{{ section.settings.req_eyebrow }}</p>{%- endif -%}
          <h2 class="tdp-h2">{{ section.settings.req_title }}</h2>
        </div></div>
        <div class="tdp-card tdp-p6">
          <svg class="tdp-ic tdp-ic-lead" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/></svg>
          {%- assign tdp_reqs = section.settings.requirements | newline_to_br | split: '<br />' -%}
          <ul class="tdp-bullets tdp-fin__reqs">
            {%- for item in tdp_reqs -%}{%- assign t = item | strip -%}{%- if t != blank -%}<li><span class="tdp-dot" aria-hidden="true"></span>{{ t }}</li>{%- endif -%}{%- endfor -%}
          </ul>
          {%- if section.settings.req_note != blank -%}<p class="tdp-xs tdp-fin__foot">{{ section.settings.req_note }}</p>{%- endif -%}
        </div>
      </div>
      <div>
        <div class="tdp-head"><div class="tdp-head__text">
          {%- if section.settings.steps_eyebrow != blank -%}<p class="tdp-eyebrow"><span class="tdp-rule" aria-hidden="true"></span>{{ section.settings.steps_eyebrow }}</p>{%- endif -%}
          <h2 class="tdp-h2">{{ section.settings.steps_title }}</h2>
        </div></div>
        <ol class="tdp-fin__steps">
          {%- assign tdp_n = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'step' -%}
              {%- assign tdp_n = tdp_n | plus: 1 -%}
              <li class="tdp-card tdp-p6 tdp-fin__step" {{ block.shopify_attributes }}>
                <span class="tdp-fin__num" aria-hidden="true">{{ tdp_n }}</span>
                <div>
                  <h3 class="tdp-h3">{{ block.settings.title }}</h3>
                  <p class="tdp-small tdp-fin__gap2">{{ block.settings.copy }}</p>
                </div>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ol>
      </div>
    </div>
  </section>

  <section class="tdp-ink tdp-fin__terms">
    <div class="tdp-wrap">
      <div class="tdp-fin__termsin">
        {%- if section.settings.terms_eyebrow != blank -%}<p class="tdp-eyebrow tdp-eyebrow--dark tdp-eyebrow--plain">{{ section.settings.terms_eyebrow }}</p>{%- endif -%}
        <h2 class="tdp-h2">{{ section.settings.terms_title }}</h2>
        <div class="tdp-fin__termlist">
          {%- for block in section.blocks -%}
            {%- if block.type == 'term' -%}
              <p {{ block.shopify_attributes }}><strong>{{ block.settings.lead }}</strong> {{ block.settings.copy }}</p>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </section>

  <section class="tdp-sec tdp-fog" id="apply">
    <div class="tdp-wrap tdp-fin__two">
      <div>
        <div class="tdp-head">
      <div class="tdp-head__text">
        {%- if section.settings.apply_eyebrow != blank -%}<p class="tdp-eyebrow"><span class="tdp-rule" aria-hidden="true"></span>{{ section.settings.apply_eyebrow }}</p>{%- endif -%}
        <h2 class="tdp-h2">{{ section.settings.apply_title }}</h2>
        {%- if section.settings.apply_lede != blank -%}<p class="tdp-lede">{{ section.settings.apply_lede }}</p>{%- endif -%}
      </div>
    </div>
        <ul class="tdp-fin__points3">
          {%- if section.settings.apply_point1 != blank -%}<li class="tdp-card"><svg class="tdp-ic tdp-drop" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M19 7V4a1 1 0 0 0-1-1H5a2 2 0 0 0 0 4h15a1 1 0 0 1 1 1v4h-3a2 2 0 0 0 0 4h3a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1"/><path d="M3 5v14a2 2 0 0 0 2 2h15a1 1 0 0 0 1-1v-4"/></svg><p class="tdp-small">{{ section.settings.apply_point1 }}</p></li>{%- endif -%}
          {%- if section.settings.apply_point2 != blank -%}<li class="tdp-card"><svg class="tdp-ic tdp-drop" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M21 7.5V6a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h3.5"/><path d="M16 2v4"/><path d="M8 2v4"/><path d="M3 10h5"/><path d="M17.5 17.5 16 16.3V14"/><circle cx="16" cy="16" r="6"/></svg><p class="tdp-small">{{ section.settings.apply_point2 }}</p></li>{%- endif -%}
          {%- if section.settings.apply_point3 != blank -%}<li class="tdp-card"><svg class="tdp-ic tdp-drop" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/></svg><p class="tdp-small">{{ section.settings.apply_point3 }}</p></li>{%- endif -%}
        </ul>
      </div>

      {%- form 'contact', id: 'tdp-fin-form', class: 'tdp-fin__form' -%}
        {%- if form.posted_successfully? -%}
          <div class="tdp-card tdp-bl-drop tdp-fin__result" role="status" tabindex="-1">
            <svg class="tdp-ic tdp-drop tdp-fin__resultic" width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
            <h3 class="tdp-h3">{{ section.settings.success_title }}</h3>
            <p class="tdp-small tdp-fin__gap3">{{ section.settings.success_copy }}</p>
            <p class="tdp-small tdp-fin__gap3">{{ section.settings.success_note }}</p>
            <div class="tdp-actions tdp-fin__gap6">
              <a href="{{ tdp_tel }}" class="tdp-btn tdp-btn--primary tdp-btn--sm"><svg class="tdp-ic" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>{{ section.settings.success_call_label }}</a>
              <a href="{{ request.path | default: '/pages/financing' }}#apply" class="tdp-btn tdp-btn--outline tdp-btn--sm">{{ section.settings.success_again_label }}</a>
            </div>
          </div>
        {%- else -%}
          <div class="tdp-card tdp-fin__card">
            {%- if form.errors -%}
              <div class="tdp-card tdp-bl-amber tdp-p6 tdp-formerr" role="alert">
                <h3 class="tdp-h3 tdp-h3-ic"><svg class="tdp-ic" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>{{ section.settings.error_title }}</h3>
                <p class="tdp-small tdp-fin__gap3">{{ section.settings.error_copy }} <a href="{{ tdp_tel }}" class="tdp-drop">{{ section.settings.phone }}</a></p>
                <div class="tdp-small tdp-ink-text">{{ form.errors | default_errors }}</div>
              </div>
            {%- endif -%}
            <h3 class="tdp-h3 tdp-fin__formtitle">{{ section.settings.form_title }}</h3>
            <p class="tdp-small tdp-fin__formintro">{{ section.settings.form_intro }}</p>
            <input type="hidden" name="contact[Enquiry]" value="Financing — interest / pre-qualification enquiry (not an application)">
            <input type="hidden" name="contact[body]" value="Financing enquiry sent from the financing page.">
            <div class="tdp-fin__fields">
              <div>
                <label class="tdp-label" for="tdp-fin-name">{{ section.settings.label_name }}</label>
                <input id="tdp-fin-name" class="tdp-field" type="text" name="contact[name]" autocomplete="name" required placeholder="{{ section.settings.ph_name }}" value="{{ form.name }}"
                  data-tdp-check="tdp-fin-name-error" data-err-required="Enter the name that will be on the application.">
                <p class="tdp-err" id="tdp-fin-name-error" hidden><svg class="tdp-ic" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg><span></span></p>
              </div>
              <div>
                <label class="tdp-label" for="tdp-fin-phone">{{ section.settings.label_phone }}</label>
                <input id="tdp-fin-phone" class="tdp-field" type="tel" inputmode="tel" name="contact[phone]" autocomplete="tel" required placeholder="{{ section.settings.ph_phone }}" value="{{ form.phone }}"
                  data-tdp-check="tdp-fin-phone-error" data-err-required="A phone number is required." data-err-phone="Enter a 10-digit phone number, area code included.">
                <p class="tdp-err" id="tdp-fin-phone-error" hidden><svg class="tdp-ic" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg><span></span></p>
              </div>
              <div>
                <label class="tdp-label" for="tdp-fin-email">{{ section.settings.label_email }}</label>
                <input id="tdp-fin-email" class="tdp-field" type="email" name="contact[email]" autocomplete="email" required spellcheck="false" autocapitalize="off" placeholder="{{ section.settings.ph_email }}" value="{{ form.email }}"
                  {% if form.errors contains 'email' %}aria-invalid="true" {% endif %}data-tdp-check="tdp-fin-email-error" data-err-required="We need an email to follow up." data-err-email="That email address does not look complete.">
                <p class="tdp-err" id="tdp-fin-email-error" hidden><svg class="tdp-ic" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg><span></span></p>
              </div>
              <div>
                <label class="tdp-label" for="tdp-fin-amount">{{ section.settings.label_amount }}</label>
                <input id="tdp-fin-amount" class="tdp-field" type="text" inputmode="decimal" name="contact[Amount needed (USD)]" required placeholder="{{ section.settings.ph_amount }}" aria-describedby="tdp-fin-amount-hint"
                  data-tdp-check="tdp-fin-amount-error" data-tdp-hint="tdp-fin-amount-hint" data-err-required="Roughly how much do you need to cover?" data-err-amount="Enter the amount in dollars, numbers only." data-max="25000" data-err-max="For anything this size, call us directly and we will walk through it.">
                <p class="tdp-err" id="tdp-fin-amount-error" hidden><svg class="tdp-ic" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg><span></span></p>
                {%- if section.settings.amount_hint != blank -%}<p class="tdp-xs tdp-fin__hint" id="tdp-fin-amount-hint">{{ section.settings.amount_hint }}</p>{%- endif -%}
              </div>
            </div>
            <button type="submit" class="tdp-btn tdp-btn--primary tdp-fin__submit" data-sending="Sending…">{{ section.settings.submit_label }}</button>
          </div>
        {%- endif -%}
      {%- endform -%}
    </div>
  </section>

  <section class="tdp-sec tdp-bone">
    <div class="tdp-wrap">
      <div class="tdp-head tdp-head--center"><div class="tdp-head__text">
        {%- if section.settings.faq_eyebrow != blank -%}<p class="tdp-eyebrow"><span class="tdp-rule" aria-hidden="true"></span>{{ section.settings.faq_eyebrow }}</p>{%- endif -%}
        <h2 class="tdp-h2">{{ section.settings.faq_title }}</h2>
      </div></div>
      <div class="tdp-fin__faq">
        <div class="tdp-fin__acc">
          {%- for block in section.blocks -%}
