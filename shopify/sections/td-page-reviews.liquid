{% comment %}
  Reviews page. Ported from the React ReviewsPage (src/pages/support/ReviewsPage.jsx),
  without the parts that are not genuine: React's fourteen sample notes, their
  star ratings and the star distribution are left out. What remains points at
  the shop's real Google and Yelp profiles. Verified reviews can be added as
  blocks; the list stays hidden until there is at least one. No star averages,
  no counts and no AggregateRating/Review markup, by design.
{% endcomment %}
{%- liquid
  assign tdp_digits = section.settings.phone | remove: '(' | remove: ')' | remove: ' ' | remove: '-' | remove: '.'
  assign tdp_tel = 'tel:+1' | append: tdp_digits
-%}
{%- liquid
  assign tdp_reviews = 0
  for block in section.blocks
    if block.type == 'review' and block.settings.quote != blank
      assign tdp_reviews = tdp_reviews | plus: 1
    endif
  endfor
-%}
<div class="tdp tdp-rev">
  <div class="tdp-hero">
    <div class="tdp-hero__line" aria-hidden="true"></div>
    <div class="tdp-wrap tdp-hero__inner">
      {%- if section.settings.hero_eyebrow != blank -%}
        <p class="tdp-eyebrow"><span class="tdp-rule" aria-hidden="true"></span>{{ section.settings.hero_eyebrow }}</p>
      {%- endif -%}
      <h1 class="tdp-h1">{{ section.settings.hero_title }}</h1>
      {%- if section.settings.hero_lede != blank -%}
        <p class="tdp-hero__lede">{{ section.settings.hero_lede }}</p>
      {%- endif -%}
      <div class="tdp-hero__actions">
        <a href="{{ tdp_tel }}" class="tdp-btn tdp-btn--ghost"><svg class="tdp-ic" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>{{ section.settings.phone }}</a>
  </div>
    </div>
  </div>

  <nav class="tdp-crumbs" aria-label="Breadcrumb">
    <ol class="tdp-wrap">
      <li><a href="{{ routes.root_url }}">Home</a></li>
      <li><svg class="tdp-ic" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m9 18 6-6-6-6"/></svg><span aria-current="page">{{ section.settings.crumb }}</span></li>
    </ol>
  </nav>

  <section class="tdp-sec tdp-bone">
    <div class="tdp-wrap tdp-rev__top">
      <div class="tdp-card tdp-rev__card tdp-rev__real">
        <h2 class="tdp-h3">{{ section.settings.real_title }}</h2>
        <p class="tdp-small tdp-rev__gap3">{{ section.settings.real_copy }}</p>
        <div class="tdp-rev__stackbtns">
          <a href="{{ section.settings.google_url }}" target="_blank" rel="noopener noreferrer" class="tdp-btn tdp-btn--dark tdp-btn--sm">{{ section.settings.google_label }}<svg class="tdp-ic" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg><span class="tdp-sr"> (opens in a new tab)</span></a>
          <a href="{{ section.settings.yelp_url }}" target="_blank" rel="noopener noreferrer" class="tdp-btn tdp-btn--outline tdp-btn--sm">{{ section.settings.yelp_label }}<svg class="tdp-ic" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg><span class="tdp-sr"> (opens in a new tab)</span></a>
        </div>
        {%- if section.settings.real_note != blank -%}<p class="tdp-xs tdp-rev__gap5">{{ section.settings.real_note }}</p>{%- endif -%}
      </div>

      <div class="tdp-card tdp-rev__card tdp-rev__span">
        <h2 class="tdp-h3">{{ section.settings.span_title }}</h2>
        {%- if section.settings.span_copy != blank -%}<p class="tdp-small tdp-rev__gap3">{{ section.settings.span_copy }}</p>{%- endif -%}
        {%- if section.settings.span_note != blank -%}
          <p class="tdp-xs tdp-rev__truck"><svg class="tdp-ic tdp-drop" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14"/><circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/></svg><span>{{ section.settings.span_note }}</span></p>
        {%- endif -%}
      </div>
    </div>
  </section>

  {%- if tdp_reviews > 0 -%}
    <section class="tdp-sec tdp-fog">
      <div class="tdp-wrap">
        <div class="tdp-head">
      <div class="tdp-head__text">
        {%- if section.settings.list_eyebrow != blank -%}<p class="tdp-eyebrow"><span class="tdp-rule" aria-hidden="true"></span>{{ section.settings.list_eyebrow }}</p>{%- endif -%}
        <h2 class="tdp-h2">{{ section.settings.list_title }}</h2>
        {%- if section.settings.list_lede != blank -%}<p class="tdp-lede">{{ section.settings.list_lede }}</p>{%- endif -%}
      </div>
    </div>
        <ul class="tdp-grid tdp-md2 tdp-lg3">
          {%- for block in section.blocks -%}
            {%- if block.type == 'review' and block.settings.quote != blank -%}
              <li class="tdp-card tdp-p6 tdp-rev__item" {{ block.shopify_attributes }}>
                <figure>
                  <blockquote class="tdp-small">{{ block.settings.quote | newline_to_br }}</blockquote>
                  <figcaption class="tdp-rev__who">
                    <span class="tdp-display tdp-rev__name">{{ block.settings.name }}</span>
                    {%- if block.settings.source != blank -%}<span class="tdp-xs">{{ block.settings.source }}</span>{%- endif -%}
                  </figcaption>
                </figure>
                {%- if block.settings.context != blank -%}<p class="tdp-rev__ctx"><span class="tdp-badge tdp-badge--soft">{{ block.settings.context }}</span></p>{%- endif -%}
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
    </section>
  {%- endif -%}

  <section class="tdp-sec {% if tdp_reviews > 0 %}tdp-bone{% else %}tdp-fog{% endif %}">
    <div class="tdp-wrap tdp-rev__turn">
      <div>
        <div class="tdp-head">
      <div class="tdp-head__text">
        {%- if section.settings.turn_eyebrow != blank -%}<p class="tdp-eyebrow"><span class="tdp-rule" aria-hidden="true"></span>{{ section.settings.turn_eyebrow }}</p>{%- endif -%}
        <h2 class="tdp-h2">{{ section.settings.turn_title }}</h2>
        {%- if section.settings.turn_lede != blank -%}<p class="tdp-lede">{{ section.settings.turn_lede }}</p>{%- endif -%}
      </div>
    </div>
        <div class="tdp-card tdp-p6">
          <h3 class="tdp-h3 tdp-rev__cardtitle">{{ section.settings.wrong_title }}</h3>
          <p class="tdp-small">{{ section.settings.wrong_copy }}</p>
          <div class="tdp-actions tdp-rev__gap5">
            <a href="{{ tdp_tel }}" class="tdp-btn tdp-btn--primary tdp-btn--sm"><svg class="tdp-ic" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>{{ section.settings.phone }}</a>
            {%- if section.settings.wrong_link_label != blank -%}
              <a href="{{ section.settings.wrong_link | default: '/pages/contact' }}" class="tdp-btn tdp-btn--outline tdp-btn--sm">{{ section.settings.wrong_link_label }}</a>
            {%- endif -%}
          </div>
        </div>
      </div>

      <div class="tdp-card tdp-rev__post">
        <svg class="tdp-ic tdp-rev__star" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        <h3 class="tdp-h3">{{ section.settings.post_title }}</h3>
        <p class="tdp-small tdp-rev__gap3">{{ section.settings.post_copy }}</p>
        <div class="tdp-rev__postbtns">
          <a href="{{ section.settings.google_url }}" target="_blank" rel="noopener noreferrer" class="tdp-btn tdp-btn--dark tdp-btn--sm">{{ section.settings.post_google_label }}<svg class="tdp-ic" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg><span class="tdp-sr"> (opens in a new tab)</span></a>
          <a href="{{ section.settings.yelp_url }}" target="_blank" rel="noopener noreferrer" class="tdp-btn tdp-btn--outline tdp-btn--sm">{{ section.settings.post_yelp_label }}<svg class="tdp-ic" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg><span class="tdp-sr"> (opens in a new tab)</span></a>
        </div>
        {%- if section.settings.post_note != blank -%}
          <p class="tdp-small tdp-rev__gap5">{{ section.settings.post_note }} <a href="{{ tdp_tel }}" class="tdp-drop">{{ section.settings.phone }}</a>.</p>
        {%- endif -%}
      </div>
    </div>
  </section>
</div>

<style>
  /* Page kit, shared by the td-page-* sections Agent E owns. Each section carries its own copy so it stays self-contained. */
  .tdp { color: #070E1A; font-family: var(--font-body--family, inherit); line-height: 1.5; -webkit-font-smoothing: antialiased; }
  .tdp *, .tdp *::before, .tdp *::after { box-sizing: border-box; }
  .tdp :where(h1, h2, h3, h4, p, ul, ol, dl, dd, dt, figure, blockquote, table, fieldset, legend, address) { margin: 0; padding: 0; }
  .tdp :where(ul, ol) { list-style: none; }
  .tdp :where(address) { font-style: normal; }
  .tdp :where(fieldset) { border: 0; min-width: 0; }
  .tdp :where(a) { color: inherit; }
  .tdp :where(h1, h2, h3, h4) {
    font-family: var(--font-heading--family, inherit); font-weight: 800; letter-spacing: -.018em;
    font-variation-settings: "wdth" 108; color: inherit; text-transform: none;
  }
  .tdp :where(a, button, input, select, textarea, summary):focus-visible { outline: 2px solid #0068E8; outline-offset: 2px; }
  .tdp-sr { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }

  .tdp-wrap { width: 100%; max-width: 1280px; margin: 0 auto; padding-left: 1rem; padding-right: 1rem; }
  .tdp-sec { padding: 3.5rem 0; }
  .tdp-bone { background: #FFFFFF; }
  .tdp-fog { background: #F4F6FA; }
  .tdp-ink :where(h1, h2, h3), .tdp-steel :where(h1, h2, h3) { color: #FFFFFF; }

  .tdp-h1 { font-size: 2.4rem; line-height: .98; }
  .tdp-h1, .tdp-head .tdp-h2 { text-wrap: balance; }
  .tdp-h2 { font-size: 1.9rem; line-height: 1.02; }
  .tdp-h3 { font-size: 1.2rem; line-height: 1.15; }
  .tdp-display { font-family: var(--font-heading--family, inherit); }
  .tdp-eyebrow {
    display: flex; align-items: center; gap: .625rem; margin-bottom: .625rem;
    font-family: var(--font-heading--family, inherit); font-size: 12px; font-weight: 700; line-height: 1.4;
    text-transform: uppercase; letter-spacing: .09em; color: #0068E8;
  }
  .tdp-rule { flex: none; height: 1px; width: 1.5rem; background: rgba(0,104,232,.45); }
  .tdp-lede { font-size: 1.0625rem; line-height: 1.6; color: #586274; }
  .tdp-small { font-size: .875rem; line-height: 1.625; color: #586274; }
  .tdp-xs { font-size: .75rem; line-height: 1.625; color: #586274; }
  .tdp-drop { color: #0068E8; }
  .tdp-small a, .tdp-xs a, .tdp-lede a { text-underline-offset: 2px; }
  .tdp-small a:hover, .tdp-xs a:hover { color: #0068E8; }

  .tdp-head { margin-bottom: 2rem; }
  .tdp-head__text { max-width: 42rem; }
  .tdp-head .tdp-lede { margin-top: 1rem; max-width: 36rem; }

  /* Masthead */
  .tdp-hero { position: relative; overflow: hidden; background: #070E1A radial-gradient(120% 90% at 50% -10%, #17293F 0%, #0A1526 45%, #070E1A 100%); color: #FFFFFF; }
  .tdp-hero__line { position: absolute; left: 0; right: 0; bottom: 0; height: 1px; pointer-events: none; background: linear-gradient(90deg, transparent, rgba(0,180,252,.35), transparent); }
  .tdp-hero__inner { position: relative; padding-top: 3.5rem; padding-bottom: 3.5rem; }
  .tdp-hero .tdp-eyebrow { color: #00B4FC; margin-bottom: .75rem; }
  .tdp-hero .tdp-rule { background: rgba(0,180,252,.55); }
  .tdp-hero .tdp-h1 { max-width: 56rem; color: #FFFFFF; }
  .tdp-hero__lede { margin-top: 1.25rem; max-width: 42rem; font-size: 1.0625rem; line-height: 1.6; color: rgba(255,255,255,.7); }
  .tdp-hero__actions { margin-top: 2rem; display: flex; flex-wrap: wrap; gap: .75rem; }

  /* Breadcrumbs */
  .tdp-crumbs { background: #FFFFFF; border-bottom: 1px solid rgba(7,14,26,.1); }
  .tdp-crumbs ol { display: flex; flex-wrap: wrap; align-items: center; gap: .375rem; padding-top: 2px; padding-bottom: 2px; font-size: 12px; color: #586274; }
  .tdp-crumbs li { display: flex; align-items: center; gap: .375rem; }
  .tdp-crumbs a { display: flex; align-items: center; min-height: 44px; text-decoration: none; color: #586274; }
  .tdp-crumbs a:hover { color: #0068E8; }
  .tdp-crumbs [aria-current] { color: #070E1A; }
  .tdp-crumbs svg { color: rgba(88,98,116,.5); }

  /* Buttons. 44px minimum so every one clears the tap-target floor. */
  .tdp-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: .5rem; min-height: 44px;
    padding: .75rem 1.5rem; border-radius: 6px; border: 1px solid transparent; cursor: pointer;
    font-family: var(--font-heading--family, inherit); font-size: 15px; font-weight: 700; line-height: 1;
    letter-spacing: -.005em; text-decoration: none; text-align: center; transition: background-color .15s, border-color .15s, box-shadow .15s, color .15s;
  }
  .tdp-btn--sm { padding: .5rem 1rem; font-size: 13px; }
  .tdp-btn--primary { background: #0068E8; color: #FFFFFF; box-shadow: 0 4px 14px -2px rgba(0,104,232,.35); }
  .tdp-btn--primary:hover { background: #0053C4; box-shadow: none; }
  .tdp-btn--dark { background: #070E1A; color: #FFFFFF; }
  .tdp-btn--dark:hover { background: #101C2E; }
  .tdp-btn--outline { border-color: rgba(7,14,26,.15); background: #FFFFFF; color: #070E1A; box-shadow: 0 0 0 1px rgba(7,14,26,.04), 0 1px 2px rgba(7,14,26,.06), 0 8px 20px -6px rgba(7,14,26,.10); }
  .tdp-btn--outline:hover { border-color: rgba(7,14,26,.3); background: #F4F6FA; }
  .tdp-btn--ghost { border-color: rgba(255,255,255,.25); background: rgba(255,255,255,.05); color: #FFFFFF; }
  .tdp-btn--ghost:hover { border-color: rgba(255,255,255,.6); background: rgba(255,255,255,.1); }

  /* Surfaces */
  .tdp-card { background: #FFFFFF; border: 1px solid rgba(7,14,26,.07); border-radius: 12px; box-shadow: 0 0 0 1px rgba(7,14,26,.04), 0 1px 2px rgba(7,14,26,.06), 0 8px 20px -6px rgba(7,14,26,.10); }
  .tdp-p6 { padding: 1.5rem; }
  .tdp-badge {
    display: inline-flex; align-items: center; border-radius: 6px; padding: .25rem .5rem;
    font-family: var(--font-heading--family, inherit); font-size: 11px; font-weight: 700; line-height: 1.1;
    text-transform: uppercase; letter-spacing: .09em;
  }
  .tdp-badge--soft { background: rgba(7,14,26,.06); color: #070E1A; box-shadow: inset 0 0 0 1px rgba(7,14,26,.1); }
  .tdp-ic { flex: none; display: inline-block; vertical-align: middle; }

  .tdp-grid { display: grid; gap: 1.25rem; grid-template-columns: minmax(0, 1fr); }
  .tdp-actions { display: flex; flex-wrap: wrap; gap: .75rem; }
  @media (min-width: 768px) {
    .tdp-wrap { padding-left: 2rem; padding-right: 2rem; }
    .tdp-sec { padding: 5rem 0; }
    .tdp-h1 { font-size: 4.25rem; }
    .tdp-h2 { font-size: 3rem; }
    .tdp-h3 { font-size: 1.45rem; }
    .tdp-lede { font-size: 1.1875rem; }
    .tdp-head { margin-bottom: 3rem; }
    .tdp-hero__inner { padding-top: 5rem; padding-bottom: 5rem; }
    .tdp-hero__lede { font-size: 1.25rem; }
    .tdp-md2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 1024px) {
    .tdp-lg3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (prefers-reduced-motion: reduce) {
    .tdp *, .tdp *::before, .tdp *::after { transition-duration: .01ms !important; animation-duration: .01ms !important; }
  }

  .tdp-rev__top { display: grid; gap: 1.5rem; align-items: start; }
  .tdp-rev__span { background: #EFF5FF; }
  .tdp-rev__card { display: flex; flex-direction: column; padding: 1.5rem; }
  .tdp-rev__gap3 { margin-top: .75rem; }
  .tdp-rev__gap5 { margin-top: 1.25rem; }
  .tdp-rev__stackbtns { margin-top: 1.5rem; display: flex; flex-direction: column; gap: .625rem; }
  .tdp-rev__stackbtns .tdp-btn { width: 100%; }
  .tdp-rev__truck { margin-top: 1.5rem; display: flex; align-items: flex-start; gap: .5rem; }
  .tdp-rev__truck svg { margin-top: 1px; }
  .tdp-rev__item { display: flex; flex-direction: column; }
  .tdp-rev__item figure { margin: 0; flex: 1; }
  .tdp-rev__who { margin-top: 1rem; display: flex; flex-wrap: wrap; align-items: baseline; gap: .25rem .75rem; }
  .tdp-rev__name { font-size: 1.0625rem; color: #070E1A; }
  .tdp-rev__ctx { margin-top: 1.25rem; border-top: 1px solid rgba(7,14,26,.1); padding-top: 1rem; }
  .tdp-rev__turn { display: grid; gap: 2rem; }
  .tdp-rev__cardtitle { margin-bottom: .75rem; }
  .tdp-rev__post { padding: 1.5rem; align-self: start; }
  .tdp-rev__star { display: block; margin-bottom: 1rem; color: #F5A623; fill: #F5A623; }
  .tdp-rev__postbtns { margin-top: 1.5rem; display: flex; flex-direction: column; gap: .625rem; }
  @media (min-width: 640px) {
    .tdp-rev__postbtns { flex-direction: row; flex-wrap: wrap; }
  }
  @media (min-width: 768px) {
    .tdp-rev__card, .tdp-rev__post { padding: 2rem; }
  }
  @media (min-width: 1024px) {
    .tdp-rev__top { grid-template-columns: 320px 1fr; gap: 2.5rem; }
    .tdp-rev__turn { grid-template-columns: 1fr 1fr; gap: 3rem; }
    /* TD-FIX: equal-height cards in both rows. Top row: the short "three-star" card stretches to match
       "Read the real ones" and becomes a centred callout (content vertically centred, heading/copy one
       step larger, note under a hairline) so the extra height reads as intentional, not empty.
       Second row: "Post it where it counts" spans the full column (heading + card on the left) so both
       columns end on the same line; its note sits at the bottom. */
    .tdp-rev__top { align-items: stretch; }
    .tdp-rev__span { justify-content: center; }
    .tdp-rev__span .tdp-h3 { font-size: 1.75rem; }
    .tdp-rev__span > .tdp-small { font-size: 1.0625rem; }
    .tdp-rev__span .tdp-rev__truck { padding-top: 1.25rem; border-top: 1px solid rgba(0,104,232,.15); }
    .tdp-rev__turn > div:first-child { display: flex; flex-direction: column; }
    .tdp-rev__turn > div:first-child > .tdp-card { flex: 1 1 auto; }
    .tdp-rev__post { align-self: stretch; display: flex; flex-direction: column; }
    .tdp-rev__post > .tdp-rev__gap5:last-child { margin-top: auto; padding-top: 1.25rem; }
  }
</style>

{% schema %}
{
  "name": "TireDrop page: Reviews",
  "tag": "div",
  "settings": [
    {"type": "header", "content": "Page header"},
