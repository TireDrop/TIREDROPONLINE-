{% comment %}
  The two ways to get the tires (React HomePage <DeliveryChoice>). This is
  the single most important decision on the site, so it gets its own band
  rather than a line in a feature list.
{% endcomment %}

{{ 'td-home.css' | asset_url | stylesheet_tag }}

<section class="tdh tdh--bone tdh-pad td-delivery" aria-labelledby="td-delivery-{{ section.id }}">
  <div class="tdh-wrap">
    <div class="tdh-head tdh-head--center">
      <div class="tdh-head__text">
        {%- if section.settings.eyebrow != blank -%}<p class="tdh-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="tdh-h2" id="td-delivery-{{ section.id }}">{{ section.settings.heading }}</h2>
        {%- if section.settings.lede != blank -%}<p class="tdh-lede">{{ section.settings.lede }}</p>{%- endif -%}
      </div>
    </div>

    <div class="td-delivery__grid">
      {%- for block in section.blocks -%}
        <div class="tdh-card td-delivery__card" {{ block.shopify_attributes }}>
          <div class="td-delivery__tag">
            {%- render 'td-home-icon', name: block.settings.icon, size: 22, class: 'tdh-icon' -%}
            <span>{{ block.settings.eyebrow }}</span>
          </div>
          <h3 class="tdh-h3">{{ block.settings.title }}</h3>
          <p class="td-delivery__copy">{{ block.settings.copy }}</p>
          {%- if block.settings.cta_label != blank and block.settings.cta_link != blank -%}
            <a href="{{ block.settings.cta_link }}" class="tdh-btn tdh-btn--outline tdh-btn--sm td-delivery__cta">
              {{ block.settings.cta_label }}
              {%- render 'td-home-icon', name: 'arrow-right', size: 15 -%}
            </a>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  .td-delivery .td-delivery__grid { display: grid; gap: 1rem; }
  .td-delivery .td-delivery__card { display: flex; flex-direction: column; padding: 1.5rem; }
  .td-delivery .td-delivery__tag {
    display: flex; align-items: center; gap: .5rem; margin-bottom: 1rem;
    font-family: var(--font-heading--family, "Archivo", system-ui, sans-serif);
    font-size: .75rem; font-weight: 700; letter-spacing: .09em; text-transform: uppercase; color: #586274;
  }
  .td-delivery .td-delivery__copy { flex: 1; margin: .5rem 0 0; font-size: .875rem; line-height: 1.625; color: #586274; }
  .td-delivery .td-delivery__cta { align-self: flex-start; margin-top: 1.5rem; }
  @media (min-width: 768px) { .td-delivery .td-delivery__card { padding: 1.75rem; } }
  @media (min-width: 1024px) { .td-delivery .td-delivery__grid { grid-template-columns: repeat(2, minmax(0,1fr)); } }
</style>

{% schema %}
{
  "name": "TireDrop delivery choice",
  "tag": "div",
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Two ways to get them" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "You choose where the tires land" },
    { "type": "textarea", "id": "lede", "label": "Supporting copy", "default": "Same catalog, same prices. The only decision is whether they come to your door or to our door." }
  ],
  "blocks": [
    {
      "type": "option",
      "name": "Delivery option",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "package", "options": [
          { "value": "package", "label": "Package" },
          { "value": "store", "label": "Store" },
          { "value": "truck", "label": "Truck" },
          { "value": "wrench", "label": "Wrench" }
        ] },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "copy", "label": "Copy" },
        { "type": "text", "id": "cta_label", "label": "Link label" },
        { "type": "url", "id": "cta_link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "TireDrop delivery choice",
      "blocks": [
        { "type": "option", "settings": { "icon": "package", "eyebrow": "Anywhere in the continental US", "title": "Ship it to me", "copy": "Your order ships straight to the address you give us — home, work, or your own installer. Shipping is free, and the delivery estimate is shown at checkout before you commit.", "cta_label": "How shipping works" } },
        { "type": "option", "settings": { "icon": "store", "eyebrow": "South Florida", "title": "Ship free to the shop — we'll fit them", "copy": "Send the order to Extreme Tires — Sunrise at no charge, then book an install. Mounting, balancing, valve stems and disposal of the old set, all handled in the bay.", "cta_label": "Ship to store & install" } }
      ]
    }
  ]
}
{% endschema %}
