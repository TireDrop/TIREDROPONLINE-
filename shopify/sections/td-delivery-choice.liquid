{% comment %}
  The two ways to get the tires. This is the single most important decision on
  the site, so it gets its own band rather than a line in a feature list.
{% endcomment %}

<section class="td-delivery">
  <div class="td-delivery__inner">
    {% if section.settings.heading != blank %}
      <div class="td-delivery__head">
        {% if section.settings.eyebrow != blank %}
          <p class="td-eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}
        <h2 class="td-h2">{{ section.settings.heading }}</h2>
        {% if section.settings.lede != blank %}
          <p class="td-lede">{{ section.settings.lede }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="td-delivery__grid">
      {% for block in section.blocks %}
        <div class="td-delivery__card" {{ block.shopify_attributes }}>
          <p class="td-eyebrow">{{ block.settings.eyebrow }}</p>
          <h3 class="td-delivery__title">{{ block.settings.title }}</h3>
          <p class="td-delivery__copy">{{ block.settings.copy }}</p>
          {% if block.settings.cta_label != blank %}
            <a href="{{ block.settings.cta_link }}" class="td-delivery__cta">
              {{ block.settings.cta_label }} <span aria-hidden="true">&rarr;</span>
            </a>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<style>
  .td-delivery { background: #F4F6FA; }
  .td-delivery__inner { max-width: 1280px; margin: 0 auto; padding: 3.5rem 1rem; }
  .td-delivery__head { max-width: 42rem; margin-bottom: 2rem; }
  .td-eyebrow {
    font-family: var(--font-subheading--family, inherit);
    font-size: .75rem; font-weight: 700; letter-spacing: .09em;
    text-transform: uppercase; color: #0068E8; margin: 0 0 .625rem;
  }
  .td-h2 {
    font-family: var(--font-heading--family, inherit);
    font-weight: 800; letter-spacing: -.02em; line-height: 1.05;
    font-size: clamp(1.75rem, 4vw, 2.5rem); margin: 0; color: #070E1A;
  }
  .td-lede { margin: .875rem 0 0; font-size: 1.0625rem; line-height: 1.6; color: #586274; }
  .td-delivery__grid { display: grid; gap: 1rem; }
  .td-delivery__card {
    background: #FFFFFF; border: 1px solid rgba(7,14,26,.1);
    border-radius: 12px; padding: 1.5rem; display: flex; flex-direction: column;
  }
  .td-delivery__title {
    font-family: var(--font-heading--family, inherit);
    font-size: 1.375rem; font-weight: 700; line-height: 1.15;
    margin: 0 0 .625rem; color: #070E1A; text-wrap: balance;
  }
  .td-delivery__copy { margin: 0 0 1.25rem; font-size: .9375rem; line-height: 1.6; color: #586274; flex: 1; }
  .td-delivery__cta {
    font-family: var(--font-heading--family, inherit);
    font-weight: 700; font-size: .9375rem; color: #0068E8; text-decoration: none;
    display: inline-flex; align-items: center; gap: .375rem; min-height: 44px;
  }
  .td-delivery__cta:hover { color: #0053C4; text-decoration: underline; }
  @media (min-width: 768px) {
    .td-delivery__inner { padding: 4.5rem 2rem; }
    .td-delivery__grid { grid-template-columns: repeat(2, minmax(0,1fr)); gap: 1.25rem; }
    .td-delivery__card { padding: 2rem; }
  }
</style>

{% schema %}
{
  "name": "TireDrop delivery choice",
  "tag": "section",
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Two ways to get them" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shipped to you, or fitted by us" },
    { "type": "textarea", "id": "lede", "label": "Supporting copy", "default": "Pick at checkout. Local to South Florida? Ship-to-store is free and we fit them in the bay." }
  ],
  "blocks": [
    {
      "type": "option",
      "name": "Delivery option",
      "settings": [
        { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "copy", "label": "Copy" },
        { "type": "text", "id": "cta_label", "label": "Link label" },
        { "type": "url", "id": "cta_link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "TireDrop delivery choice",
      "blocks": [
        { "type": "option", "settings": { "eyebrow": "Anywhere in the continental US", "title": "Ship it to me", "copy": "Your order ships straight to the address you give us — home, work, or your own installer. Shipping and delivery time are shown at checkout before you commit.", "cta_label": "How shipping works" } },
        { "type": "option", "settings": { "eyebrow": "South Florida", "title": "Ship free to the shop — we'll fit them", "copy": "Send the order to Extreme Tires in Sunrise at no charge, then book an install. Mounting, balancing, valve stems and disposal of the old set, all handled in the bay.", "cta_label": "Ship to store & install" } }
      ]
    }
  ]
}
{% endschema %}
