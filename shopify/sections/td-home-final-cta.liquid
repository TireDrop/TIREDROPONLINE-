{% comment %}
  Closing call to action (React HomePage <FinalCta>). Dark band: every text
  colour is pinned.
{% endcomment %}

{{ 'td-home.css' | asset_url | stylesheet_tag }}

{%- assign phone_digits = section.settings.phone | remove: '(' | remove: ')' | remove: ' ' | remove: '-' | remove: '.' -%}

<section class="tdh tdh--ink tdh-pad td-final" aria-labelledby="td-final-{{ section.id }}">
  <div class="tdh-wrap td-final__inner">
    {%- render 'td-home-icon', name: 'package-check', size: 34, class: 'tdh-icon' -%}
    <h2 class="tdh-h2 td-final__title" id="td-final-{{ section.id }}">{{ section.settings.heading }}</h2>
    {%- if section.settings.lede != blank -%}<p class="tdh-lede td-final__lede">{{ section.settings.lede }}</p>{%- endif -%}
    <div class="td-final__actions">
      {%- if section.settings.cta_label != blank -%}
        <a class="tdh-btn tdh-btn--primary" href="{{ section.settings.cta_link | default: '/collections/all' }}">
          {{ section.settings.cta_label }}
          {%- render 'td-home-icon', name: 'arrow-right', size: 17 -%}
        </a>
      {%- endif -%}
      {%- if section.settings.phone != blank -%}
        <a class="tdh-btn tdh-btn--ghost" href="tel:+1{{ phone_digits }}">
          {%- render 'td-home-icon', name: 'phone', size: 17 -%}
          Call {{ section.settings.phone }}
        </a>
      {%- endif -%}
    </div>
    {%- if section.settings.footnote != blank -%}
      <p class="td-final__foot">
        {%- render 'td-home-icon', name: 'circle-dollar-sign', size: 14 -%}
        {{ section.settings.footnote }}
      </p>
    {%- endif -%}
  </div>
</section>

<style>
  .td-final .td-final__inner { display: flex; flex-direction: column; align-items: center; gap: 1.5rem; text-align: center; }
  .td-final .td-final__title { max-width: 42rem; text-wrap: wrap; }
  .td-final .td-final__lede { max-width: 36rem; color: rgba(255,255,255,.7); }
  .td-final .td-final__actions { display: flex; flex-wrap: wrap; justify-content: center; gap: .75rem; }
  .td-final .td-final__foot {
    margin: 0; display: flex; align-items: center; gap: .5rem;
    font-family: var(--font-heading--family, "Archivo", system-ui, sans-serif);
    font-size: .75rem; font-weight: 700; letter-spacing: .09em; text-transform: uppercase;
    color: rgba(255,255,255,.62);
  }
</style>

{% schema %}
{
  "name": "TireDrop closing CTA",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find your size and pick your delivery" },
    { "type": "textarea", "id": "lede", "label": "Supporting copy", "default": "Search the catalog, add a set to your cart, and choose shipping or free ship-to-store at checkout. Questions on fitment? Call us." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Shop Tires" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "text", "id": "phone", "label": "Phone number", "default": "(954) 773-1896" },
    { "type": "text", "id": "footnote", "label": "Footnote", "default": "Powered by Extreme Tires" }
  ],
  "presets": [{ "name": "TireDrop closing CTA" }]
}
{% endschema %}
