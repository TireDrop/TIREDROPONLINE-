{% comment %}
  Contact page. Ported from the React ContactPage (src/pages/support/ContactPage.jsx).
  The form is Shopify's native contact form, so a message lands in the store
  inbox. Field names: contact[name], contact[email], contact[phone],
  contact[Subject] and contact[body]. Hours are blocks seeded from the React
  business data (src/data/business.js).
{% endcomment %}
{%- liquid
  assign tdp_digits = section.settings.phone | remove: '(' | remove: ')' | remove: ' ' | remove: '-' | remove: '.'
  assign tdp_tel = 'tel:+1' | append: tdp_digits
-%}
<div class="tdp tdp-contact">
  <div class="tdp-hero">
    <div class="tdp-hero__line" aria-hidden="true"></div>
    <div class="tdp-wrap tdp-hero__inner">
      {%- if section.settings.hero_eyebrow != blank -%}
        <p class="tdp-eyebrow"><span class="tdp-rule" aria-hidden="true"></span>{{ section.settings.hero_eyebrow }}</p>
      {%- endif -%}
      <h1 class="tdp-h1">{{ section.settings.hero_title }}</h1>
      {%- if section.settings.hero_lede != blank -%}
        <p class="tdp-hero__lede">{{ section.settings.hero_lede }}</p>
      {%- endif -%}
      <div class="tdp-hero__actions">
        <a href="{{ tdp_tel }}" class="tdp-btn tdp-btn--primary"><svg class="tdp-ic" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>{{ section.settings.hero_call_label }} {{ section.settings.phone }}</a>
  </div>
    </div>
  </div>

  <nav class="tdp-crumbs" aria-label="Breadcrumb">
    <ol class="tdp-wrap">
      <li><a href="{{ routes.root_url }}">Home</a></li>
      <li><svg class="tdp-ic" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m9 18 6-6-6-6"/></svg><span aria-current="page">{{ section.settings.crumb }}</span></li>
    </ol>
  </nav>

  <section class="tdp-sec tdp-bone">
    <div class="tdp-wrap tdp-contact__grid">
      <div>
        <div class="tdp-head">
      <div class="tdp-head__text">
        {%- if section.settings.reach_eyebrow != blank -%}<p class="tdp-eyebrow"><span class="tdp-rule" aria-hidden="true"></span>{{ section.settings.reach_eyebrow }}</p>{%- endif -%}
        <h2 class="tdp-h2">{{ section.settings.reach_title }}</h2>
        {%- if section.settings.reach_lede != blank -%}<p class="tdp-lede">{{ section.settings.reach_lede }}</p>{%- endif -%}
      </div>
    </div>
        <div class="tdp-card tdp-p6 tdp-bl-drop">
          <h3 class="tdp-h3 tdp-h3-ic tdp-contact__cardtitle--tight"><svg class="tdp-ic" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m7.5 4.27 9 5.15"/><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg>{{ section.settings.fast_title }}</h3>
          <p class="tdp-small">{{ section.settings.fast_copy }}</p>
          <a href="{{ tdp_tel }}" class="tdp-btn tdp-btn--primary tdp-btn--sm tdp-contact__fastbtn"><svg class="tdp-ic" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>{{ section.settings.phone }}</a>
        </div>

        <ul class="tdp-contact__methods">
          <li class="tdp-card tdp-p6">
            <h3 class="tdp-h3 tdp-h3-ic tdp-contact__cardtitle"><svg class="tdp-ic" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>{{ section.settings.phone_title }}</h3>
            <a href="{{ tdp_tel }}" class="tdp-contact__big">{{ section.settings.phone }}</a>
            <p class="tdp-small tdp-contact__after">{{ section.settings.phone_copy }}</p>
            {%- if section.settings.phone_note != blank -%}<p class="tdp-xs tdp-contact__note">{{ section.settings.phone_note }}</p>{%- endif -%}
          </li>
          <li class="tdp-card tdp-p6">
            <h3 class="tdp-h3 tdp-h3-ic tdp-contact__cardtitle"><svg class="tdp-ic" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>{{ section.settings.email_title }}</h3>
            <a href="mailto:{{ section.settings.email }}" class="tdp-contact__big tdp-contact__email">{{ section.settings.email }}</a>
            <p class="tdp-small tdp-contact__after">{{ section.settings.email_copy }}</p>
          </li>
          <li class="tdp-card tdp-p6">
            <h3 class="tdp-h3 tdp-h3-ic tdp-contact__cardtitle"><svg class="tdp-ic" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>{{ section.settings.shop_title }}</h3>
            <p class="tdp-small tdp-contact__shopcopy">{{ section.settings.shop_copy }}</p>
            <address class="tdp-contact__addr">{{ section.settings.street }}<br>{{ section.settings.city_line }}</address>
            <div class="tdp-actions tdp-contact__shopbtns">
              <a href="{{ section.settings.maps_url }}" target="_blank" rel="noopener noreferrer" class="tdp-btn tdp-btn--outline tdp-btn--sm"><svg class="tdp-ic" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><polygon points="3 11 22 2 13 21 11 13 3 11"/></svg>{{ section.settings.directions_label }}<span class="tdp-sr"> (opens in a new tab)</span></a>
              {%- if section.settings.shop_link_label != blank -%}
                <a href="{{ section.settings.shop_link | default: '/pages/locations' }}" class="tdp-btn tdp-btn--outline tdp-btn--sm">{{ section.settings.shop_link_label }}</a>
              {%- endif -%}
            </div>
          </li>
          <li class="tdp-card tdp-p6">
            <h3 class="tdp-h3 tdp-h3-ic tdp-contact__cardtitle"><svg class="tdp-ic" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>{{ section.settings.hours_title }}</h3>
            <table class="tdp-hours">
              <caption class="tdp-sr">Business hours</caption>
              <tbody>
                {%- for block in section.blocks -%}
                  {%- if block.type == 'hours' -%}
                    <tr {{ block.shopify_attributes }}>
                      <th scope="row">{{ block.settings.days }}</th>
                      <td{% if block.settings.time == 'Closed' %} class="is-closed"{% endif %}>{{ block.settings.time }}</td>
                    </tr>
                  {%- endif -%}
                {%- endfor -%}
              </tbody>
            </table>
            {%- if section.settings.hours_note != blank -%}<p class="tdp-xs tdp-contact__note">{{ section.settings.hours_note }}</p>{%- endif -%}
          </li>
        </ul>
      </div>

      <div>
        <div class="tdp-head">
      <div class="tdp-head__text">
        {%- if section.settings.message_eyebrow != blank -%}<p class="tdp-eyebrow"><span class="tdp-rule" aria-hidden="true"></span>{{ section.settings.message_eyebrow }}</p>{%- endif -%}
        <h2 class="tdp-h2">{{ section.settings.message_title }}</h2>
        {%- if section.settings.message_lede != blank -%}<p class="tdp-lede">{{ section.settings.message_lede }}</p>{%- endif -%}
      </div>
    </div>
        {%- form 'contact', id: 'tdp-contact-form', class: 'tdp-contact__form' -%}
          {%- if form.posted_successfully? -%}
            <div class="tdp-card tdp-bl-drop tdp-contact__result" role="status" tabindex="-1">
              <svg class="tdp-ic tdp-drop tdp-contact__resultic" width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
              <h3 class="tdp-h3">{{ section.settings.success_title }}</h3>
              <p class="tdp-small tdp-contact__after">{{ section.settings.success_copy }}</p>
              <p class="tdp-small tdp-contact__after">{{ section.settings.success_urgent }} <a href="{{ tdp_tel }}" class="tdp-drop">{{ section.settings.phone }}</a>.</p>
              <div class="tdp-actions tdp-contact__resultbtns">
                <a href="{{ tdp_tel }}" class="tdp-btn tdp-btn--primary tdp-btn--sm"><svg class="tdp-ic" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>{{ section.settings.success_call_label }}</a>
                <a href="{{ request.path | default: '/pages/contact' }}" class="tdp-btn tdp-btn--outline tdp-btn--sm">{{ section.settings.success_again_label }}</a>
              </div>
            </div>
          {%- else -%}
            <div class="tdp-card tdp-contact__card">
              {%- if form.errors -%}
                <div class="tdp-card tdp-bl-amber tdp-p6 tdp-formerr" role="alert">
                  <h3 class="tdp-h3 tdp-h3-ic"><svg class="tdp-ic" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>{{ section.settings.error_title }}</h3>
                  <p class="tdp-small tdp-contact__after">{{ section.settings.error_copy }} <a href="{{ tdp_tel }}" class="tdp-drop">{{ section.settings.phone }}</a></p>
                  <div class="tdp-small tdp-ink-text">{{ form.errors | default_errors }}</div>
                </div>
              {%- endif -%}
              <h3 class="tdp-h3 tdp-contact__formtitle">{{ section.settings.form_title }}</h3>
              <p class="tdp-small tdp-contact__formintro">{{ section.settings.form_intro }}</p>
              <div class="tdp-contact__fields">
                <div>
                  <label class="tdp-label" for="tdp-contact-name">{{ section.settings.label_name }}</label>
                  <input id="tdp-contact-name" class="tdp-field" type="text" name="contact[name]" autocomplete="name" required
                    placeholder="{{ section.settings.ph_name }}" value="{{ form.name }}"
                    data-tdp-check="tdp-contact-name-error" data-err-required="Tell us who we are talking to.">
                  <p class="tdp-err" id="tdp-contact-name-error" hidden><svg class="tdp-ic" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg><span></span></p>
                </div>
                <div>
                  <label class="tdp-label" for="tdp-contact-phone">{{ section.settings.label_phone }}</label>
                  <input id="tdp-contact-phone" class="tdp-field" type="tel" inputmode="tel" name="contact[phone]" autocomplete="tel" required
                    placeholder="{{ section.settings.ph_phone }}" value="{{ form.phone }}"
                    data-tdp-check="tdp-contact-phone-error" data-err-required="A phone number gets you a faster answer." data-err-phone="Enter a 10-digit phone number, area code included.">
                  <p class="tdp-err" id="tdp-contact-phone-error" hidden><svg class="tdp-ic" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg><span></span></p>
                </div>
                <div class="tdp-contact__full">
                  <label class="tdp-label" for="tdp-contact-email">{{ section.settings.label_email }}</label>
                  <input id="tdp-contact-email" class="tdp-field" type="email" name="contact[email]" autocomplete="email" required spellcheck="false" autocapitalize="off"
                    placeholder="{{ section.settings.ph_email }}" value="{{ form.email }}"
                    {% if form.errors contains 'email' %}aria-invalid="true" {% endif %}data-tdp-check="tdp-contact-email-error" data-err-required="We need an email to write back to." data-err-email="That email address does not look complete.">
                  <p class="tdp-err" id="tdp-contact-email-error" hidden><svg class="tdp-ic" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg><span></span></p>
                </div>
                {%- assign tdp_subjects = section.settings.subjects | newline_to_br | split: '<br />' -%}
                <fieldset class="tdp-contact__full" data-tdp-check="tdp-contact-subject-error" data-err-required="Pick the option that fits best.">
                  <legend class="tdp-label">{{ section.settings.label_subject }}</legend>
                  <div class="tdp-contact__radios">
                    {%- for subject in tdp_subjects -%}
                      {%- assign s = subject | strip -%}
                      {%- if s != blank -%}
                        <label class="tdp-contact__radio">
                          <input type="radio" name="contact[Subject]" value="{{ s | escape }}" required>
                          <span>{{ s }}</span>
                        </label>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                  <p class="tdp-err" id="tdp-contact-subject-error" hidden><svg class="tdp-ic" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg><span></span></p>
                </fieldset>
                <div class="tdp-contact__full">
                  <label class="tdp-label" for="tdp-contact-message">{{ section.settings.label_message }}</label>
                  <textarea id="tdp-contact-message" class="tdp-field" name="contact[body]" rows="6" required
                    placeholder="{{ section.settings.ph_message }}"
                    data-tdp-check="tdp-contact-message-error" data-err-required="Add a few details so we can actually help." data-min="15" data-err-min="A little more detail, please — vehicle, tire size, or your order number.">{{ form.body }}</textarea>
                  <p class="tdp-err" id="tdp-contact-message-error" hidden><svg class="tdp-ic" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg><span></span></p>
                </div>
              </div>
              <button type="submit" class="tdp-btn tdp-btn--primary tdp-contact__submit" data-sending="Sending…">{{ section.settings.submit_label }}</button>
              {%- if section.settings.privacy_note != blank -%}<p class="tdp-xs tdp-contact__privacy">{{ section.settings.privacy_note }}</p>{%- endif -%}
            </div>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>
  </section>

  <section class="tdp-ink tdp-contact__cta">
    <div class="tdp-wrap tdp-contact__ctarow">
      <div>
        {%- if section.settings.cta_eyebrow != blank -%}<p class="tdp-eyebrow tdp-eyebrow--dark tdp-eyebrow--plain">{{ section.settings.cta_eyebrow }}</p>{%- endif -%}
        <h2 class="tdp-h2">{{ section.settings.cta_title }}</h2>
        {%- if section.settings.cta_lede != blank -%}<p class="tdp-lede tdp-contact__ctalede">{{ section.settings.cta_lede }}</p>{%- endif -%}
      </div>
      <div class="tdp-contact__ctabtns">
        {%- if section.settings.cta1_label != blank -%}<a href="{{ section.settings.cta1_link | default: '/pages/shipping' }}" class="tdp-btn tdp-btn--primary">{{ section.settings.cta1_label }}</a>{%- endif -%}
        {%- if section.settings.cta2_label != blank -%}<a href="{{ section.settings.cta2_link | default: '/pages/install' }}" class="tdp-btn tdp-btn--ghost">{{ section.settings.cta2_label }}</a>{%- endif -%}
      </div>
    </div>
  </section>
</div>

<script>
  (function () {
    // Mirrors the React form's validation messages. Without JavaScript the
    // browser's own required/type checks still apply and Shopify validates the email.
    var form = document.getElementById('tdp-contact-form');
    if (!form || form.getAttribute('data-tdp-ready')) return;
    form.setAttribute('data-tdp-ready', '1');
    form.noValidate = true;
    var checks = form.querySelectorAll('[data-tdp-check]');
    var EMAIL = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

    function valueOf(el) {
      if (el.tagName === 'FIELDSET') {
        var picked = el.querySelector('input:checked');
        return picked ? picked.value : '';
      }
      return el.value.trim();
    }
    function show(el, msg) {
      var box = document.getElementById(el.getAttribute('data-tdp-check'));
      var target = el.tagName === 'FIELDSET' ? el.querySelectorAll('input') : [el];
      var hint = el.getAttribute('data-tdp-hint');
      for (var i = 0; i < target.length; i++) {
        if (msg) target[i].setAttribute('aria-invalid', 'true'); else target[i].removeAttribute('aria-invalid');
      }
      if (box) {
        box.hidden = !msg;
        box.querySelector('span').textContent = msg || '';
      }
      var hintEl = hint && document.getElementById(hint);
      if (hintEl) hintEl.hidden = !!msg;
      var ids = [msg ? box && box.id : hint].filter(Boolean).join(' ');
      if (el.tagName === 'FIELDSET') { if (msg) el.setAttribute('aria-describedby', ids); else el.removeAttribute('aria-describedby'); }
      else if (ids) el.setAttribute('aria-describedby', ids); else el.removeAttribute('aria-describedby');
    }
    function check(el) {
      var v = valueOf(el), d = el.dataset, msg = '';
      if (!v) msg = d.errRequired || '';
      else if (d.errEmail && !EMAIL.test(v)) msg = d.errEmail;
      else if (d.errPhone && v.replace(/\D/g, '').length < 10) msg = d.errPhone;
      else if (d.errMin && v.length < Number(d.min || 0)) msg = d.errMin;
      else if (d.errAmount) {
        var n = Number(v.replace(/[$,\s]/g, ''));
        if (isNaN(n) || n <= 0) msg = d.errAmount;
        else if (d.errMax && n > Number(d.max || Infinity)) msg = d.errMax;
      }
      show(el, msg);
      return !msg;
    }
    form.addEventListener('submit', function (event) {
      var first = null;
      for (var i = 0; i < checks.length; i++) {
        if (!check(checks[i]) && !first) first = checks[i];
      }
      if (first) {
        event.preventDefault();
        (first.tagName === 'FIELDSET' ? first.querySelector('input') : first).focus();
        return;
      }
      var btn = form.querySelector('[type="submit"]');
      if (btn) {
        if (btn.getAttribute('aria-disabled') === 'true') { event.preventDefault(); return; }
        btn.setAttribute('aria-disabled', 'true');
        btn.textContent = btn.getAttribute('data-sending') || btn.textContent;
      }
    });
    for (var i = 0; i < checks.length; i++) {
      (function (el) {
        el.addEventListener(el.tagName === 'FIELDSET' ? 'change' : 'input', function () {
          // Clear an error as soon as the customer starts fixing it.
          var box = document.getElementById(el.getAttribute('data-tdp-check'));
          if (box && !box.hidden) show(el, '');
        });
      })(checks[i]);
    }
  })();

  (function () {
    // After Shopify redirects back with ?contact_posted=true, move focus to the confirmation.
    var done = document.querySelector('#tdp-contact-form [role="status"]');
    if (done && /contact_posted=true/.test(location.search)) done.focus();
    // ?topic=install (and friends) preselects the matching subject.
    var topic = (new URLSearchParams(location.search).get('topic') || '').toLowerCase();
    if (!topic) return;
    var alias = { install: 'install', installation: 'install', shipping: 'shipping', delivery: 'shipping', order: 'order', returns: 'return', warranty: 'return', fleet: 'fleet', commercial: 'fleet' };
    var want = alias[topic] || topic;
    var radios = document.querySelectorAll('#tdp-contact-form input[name="contact[Subject]"]');
    for (var i = 0; i < radios.length; i++) {
      if (radios[i].value.toLowerCase().indexOf(want) !== -1) { radios[i].checked = true; break; }
    }
  })();
</script>

<style>
  /* Page kit, shared by the td-page-* sections Agent E owns. Each section carries its own copy so it stays self-contained. */
  .tdp { color: #070E1A; font-family: var(--font-body--family, inherit); line-height: 1.5; -webkit-font-smoothing: antialiased; }
