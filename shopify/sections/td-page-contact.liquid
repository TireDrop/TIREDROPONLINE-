    letter-spacing: -.005em; text-decoration: none; text-align: center; transition: background-color .15s, border-color .15s, box-shadow .15s, color .15s;
  }
  .tdp-btn--sm { padding: .5rem 1rem; font-size: 13px; }
  .tdp-btn--primary { background: #0068E8; color: #FFFFFF; box-shadow: 0 4px 14px -2px rgba(0,104,232,.35); }
  .tdp-btn--primary:hover { background: #0053C4; box-shadow: none; }
  .tdp-btn--outline { border-color: rgba(7,14,26,.15); background: #FFFFFF; color: #070E1A; box-shadow: 0 0 0 1px rgba(7,14,26,.04), 0 1px 2px rgba(7,14,26,.06), 0 8px 20px -6px rgba(7,14,26,.10); }
  .tdp-btn--outline:hover { border-color: rgba(7,14,26,.3); background: #F4F6FA; }
  .tdp-btn--ghost { border-color: rgba(255,255,255,.25); background: rgba(255,255,255,.05); color: #FFFFFF; }
  .tdp-btn--ghost:hover { border-color: rgba(255,255,255,.6); background: rgba(255,255,255,.1); }

  /* Surfaces */
  .tdp-card { background: #FFFFFF; border: 1px solid rgba(7,14,26,.07); border-radius: 12px; box-shadow: 0 0 0 1px rgba(7,14,26,.04), 0 1px 2px rgba(7,14,26,.06), 0 8px 20px -6px rgba(7,14,26,.10); }
  .tdp-p6 { padding: 1.5rem; }
  .tdp-bl-drop { border-left: 4px solid #0068E8; }
  .tdp-bl-amber { border-left: 4px solid #F5A623; }
  .tdp-ic { flex: none; display: inline-block; vertical-align: middle; }
  .tdp-h3-ic { display: flex; align-items: center; gap: .5rem; }
  .tdp-h3-ic svg { color: #0068E8; }
  .tdp-actions { display: flex; flex-wrap: wrap; gap: .75rem; }

  /* Hours */
  .tdp-hours { width: 100%; border-collapse: collapse; font-size: .875rem; font-variant-numeric: tabular-nums; }
  .tdp-hours tr + tr { border-top: 1px solid rgba(7,14,26,.1); }
  .tdp-hours th { padding: .5rem 0; text-align: left; font-family: var(--font-heading--family, inherit); font-size: 1rem; font-weight: 400; color: #070E1A; }
  .tdp-hours td { padding: .5rem 0; text-align: right; color: #070E1A; }
  .tdp-hours td.is-closed { color: #586274; }

  /* Forms */
  .tdp-field {
    display: block; width: 100%; min-height: 44px; margin: 0; border-radius: 6px; border: 1px solid rgba(7,14,26,.12);
    background: #FFFFFF; padding: .625rem .875rem; font: inherit; font-size: 15px; line-height: 1.5; color: #070E1A;
    box-shadow: inset 0 1px 2px rgba(7,14,26,.04); appearance: none;
  }
  .tdp-field::placeholder { color: rgba(88,98,116,.6); }
  .tdp-field:focus { outline: none; border-color: #0068E8; box-shadow: 0 0 0 3px rgba(0,104,232,.15); }
  .tdp-field[aria-invalid="true"] { border-color: #0068E8; }
  textarea.tdp-field { resize: vertical; }
  .tdp-err { margin-top: .375rem; display: flex; align-items: flex-start; gap: .375rem; font-size: .75rem; line-height: 1.5; color: #0068E8; }
  .tdp-err svg { margin-top: 1px; }
