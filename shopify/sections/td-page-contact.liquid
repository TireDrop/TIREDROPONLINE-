  .tdp :where(h1, h2, h3, h4, p, ul, ol, dl, dd, dt, figure, blockquote, table, fieldset, legend, address) { margin: 0; padding: 0; }
  .tdp :where(ul, ol) { list-style: none; }
  .tdp :where(address) { font-style: normal; }
  .tdp :where(fieldset) { border: 0; min-width: 0; }
