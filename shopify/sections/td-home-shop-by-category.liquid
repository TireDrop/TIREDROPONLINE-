{% comment %}
  Shop by category (React HomePage <ShopByCategory>). One block per tire
  category. React links to /tires?category=X; the Shopify equivalent is a tag
  filter on the tires collection (/collections/tires/all-season), which
  starts returning products as soon as imported tires carry that tag.
  Commercial goes to the fleet page instead.
{% endcomment %}

{{ 'td-home.css' | asset_url | stylesheet_tag }}

<section class="tdh tdh--bone tdh-pad td-cats" aria-labelledby="td-cats-{{ section.id }}">
  <div class="tdh-wrap">
    <div class="tdh-head{% if section.settings.action_label != blank %} tdh-head--action{% endif %}">
      <div class="tdh-head__text">
        {%- if section.settings.eyebrow != blank -%}<p class="tdh-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="tdh-h2" id="td-cats-{{ section.id }}">{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.action_label != blank -%}
        <div class="tdh-head__action">
          <a class="tdh-btn tdh-btn--outline tdh-btn--sm" href="{{ section.settings.action_link | default: '/collections/all' }}">
            {{ section.settings.action_label }}
            {%- render 'td-home-icon', name: 'arrow-right', size: 15 -%}
          </a>
        </div>
      {%- endif -%}
    </div>

    <ul class="td-cats__grid" role="list">
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }}>
          <a class="tdh-card td-cats__tile" href="{{ block.settings.link | default: '/collections/all' }}">
            {%- render 'td-home-icon', name: block.settings.icon, size: 24, class: 'tdh-icon td-cats__icon' -%}
            <h3 class="td-cats__title">{{ block.settings.title }}</h3>
            <p class="td-cats__copy">{{ block.settings.copy }}</p>
            <span class="tdh-more td-cats__more">{{ section.settings.tile_cta }}{%- render 'td-home-icon', name: 'arrow-right', size: 14 -%}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

<style>
  .td-cats .td-cats__grid { list-style: none; margin: 0; padding: 0; display: grid; gap: .75rem; }
  .td-cats .td-cats__tile { height: 100%; display: flex; flex-direction: column; padding: 1.25rem; }
  .td-cats .td-cats__icon { margin-bottom: .75rem; }
  .td-cats .td-cats__title { font-size: 1.125rem; line-height: 1.25; margin: 0; color: #070E1A; }
  .td-cats .td-cats__copy { flex: 1; margin: .5rem 0 0; font-size: .75rem; line-height: 1.625; color: #586274; }
  .td-cats .td-cats__more { font-size: 13px; }
  @media (min-width: 640px) { .td-cats .td-cats__grid { grid-template-columns: repeat(2, minmax(0,1fr)); } }
  @media (min-width: 1024px) { .td-cats .td-cats__grid { grid-template-columns: repeat(5, minmax(0,1fr)); } }
</style>

{% schema %}
{
  "name": "TireDrop shop by category",
  "tag": "div",
  "max_blocks": 10,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop by category" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Start with the kind of tire you need" },
    { "type": "text", "id": "action_label", "label": "Button label", "default": "All tires" },
    { "type": "url", "id": "action_link", "label": "Button link" },
    { "type": "text", "id": "tile_cta", "label": "Tile link text", "default": "Shop" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "badge-check", "options": [
            { "value": "cloud-sun", "label": "Sun and cloud" },
            { "value": "gauge", "label": "Gauge" },
            { "value": "truck", "label": "Truck" },
            { "value": "snowflake", "label": "Snowflake" },
            { "value": "building-2", "label": "Building" },
            { "value": "badge-check", "label": "Badge" },
            { "value": "wrench", "label": "Wrench" },
            { "value": "store", "label": "Store" },
            { "value": "package", "label": "Package" }
          ] },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "copy", "label": "Copy" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "TireDrop shop by category",
      "blocks": [
        { "type": "category", "settings": { "icon": "cloud-sun", "title": "All-Season", "copy": "The everyday set — grip, tread life and quiet in one tire." } },
        { "type": "category", "settings": { "icon": "gauge", "title": "Performance", "copy": "Summer and ultra-high-performance rubber for a quick car." } },
        { "type": "category", "settings": { "icon": "truck", "title": "Truck & SUV", "copy": "Highway and all-terrain sets rated for the weight you carry." } },
        { "type": "category", "settings": { "icon": "snowflake", "title": "Winter", "copy": "3PMSF compounds that stay soft when the road stops cooperating." } },
        { "type": "category", "settings": { "icon": "building-2", "title": "Commercial", "copy": "Load-rated LT and van sizes for work trucks and fleets." } }
      ]
    }
  ]
}
{% endschema %}
