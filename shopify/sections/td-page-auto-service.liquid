{% comment %}
  Auto services — the Shopify port of src/pages/services/AutoServicePage.jsx.

  React gives every service its own page (/services/<slug>, ServiceDetailPage.jsx).
  The theme has no such pages, so the detail content (what's included, signs
  you need it) folds into each card here, and each card carries id="<slug>" so
  /pages/auto-service#brake-repair lands on it and opens it.

  Booking buttons go to the booking_url setting (the contact page with
  ?topic=install) rather than React's /schedule flow, with the phone beside
  them. The symptom picker needs JavaScript; without it the cards below still
  list every symptom, so nothing is lost.
{% endcomment %}
{%- liquid
  assign ss = section.settings
  assign phone = ss.phone | default: '(954) 773-1896'
  assign phone_digits = phone | remove: '(' | remove: ')' | remove: ' ' | remove: '-' | remove: '.'
  assign phone_href = 'tel:+1' | append: phone_digits
  assign booking_url = ss.booking_url | default: '/pages/contact?topic=install'
  assign mobile_count = 0
  for block in section.blocks
    if block.type == 'service' and block.settings.mobile
      assign mobile_count = mobile_count | plus: 1
    endif
  endfor
  assign categories = 'Tires,Wheels,Maintenance,Repair,Custom' | split: ','
-%}
{%- render 'td-pg-kit' -%}

<div class="td-pg td-pg-auto" id="td-pg-{{ section.id }}">
  <header class="td-pg-hero">
    <div class="td-pg-wrap td-pg-hero__inner">
      {%- if ss.hero_eyebrow != blank -%}<p class="td-pg-eyebrow">{{ ss.hero_eyebrow }}</p>{%- endif -%}
      <h1>{{ ss.hero_heading }}</h1>
      {%- if ss.hero_lede != blank -%}<p class="td-pg-hero__lede">{{ ss.hero_lede | replace: '[mobile_count]', mobile_count }}</p>{%- endif -%}
      <div class="td-pg-hero__extra">
        <div class="td-pg-btns">
          {%- if ss.hero_cta_label != blank -%}
            <a class="td-pg-btn td-pg-btn--primary" href="{{ booking_url }}">{{ ss.hero_cta_label }}{% render 'td-pg-icon', name: 'arrow-right', size: 18 %}</a>
          {%- endif -%}
          {%- if ss.hero_cta2_label != blank -%}
            <a class="td-pg-btn td-pg-btn--ghost" href="{{ ss.hero_cta2_link | default: '/pages/install' }}">{% render 'td-pg-icon', name: 'store', size: 18 %}{{ ss.hero_cta2_label }}</a>
          {%- endif -%}
        </div>
      </div>
    </div>
  </header>

  {%- if ss.notice_lead != blank or ss.notice_text != blank -%}
    <div class="td-pg-notice">
      <div class="td-pg-wrap">
        {% render 'td-pg-icon', name: 'map-pin', size: 18 %}
        <p><strong>{{ ss.notice_lead }}</strong> {{ ss.notice_text }}</p>
      </div>
    </div>
  {%- endif -%}

  <div class="td-pg-auto__legend">
    <div class="td-pg-wrap">
      <span><span class="td-pg-badge td-pg-badge--drop">Mobile</span>{{ ss.legend_mobile }}</span>
      <span><span class="td-pg-badge td-pg-badge--soft">In-Shop</span>{{ ss.legend_shop }}</span>
    </div>
  </div>

  {%- comment -%} ---------- Service groups ---------- {%- endcomment -%}
  {%- assign band = 0 -%}
  {%- for cat in categories -%}
    {%- assign count = 0 -%}
    {%- for block in section.blocks -%}{%- if block.type == 'service' and block.settings.category == cat -%}{%- assign count = count | plus: 1 -%}{%- endif -%}{%- endfor -%}
    {%- if count > 0 -%}
      {%- assign mod = band | modulo: 2 -%}
      {%- assign band = band | plus: 1 -%}
      {%- assign copy_key = 'copy_' | append: cat | downcase -%}
      <section class="td-pg-sec {% if mod == 0 %}td-pg-sec--fog{% else %}td-pg-sec--bone{% endif %}" aria-labelledby="td-pg-{{ section.id }}-{{ cat | handleize }}">
        <div class="td-pg-wrap">
          <div class="td-pg-head"><div class="td-pg-head__text">
            <p class="td-pg-eyebrow">{{ count }} {% if count == 1 %}service{% else %}services{% endif %}</p>
            <h2 class="td-pg-h2" id="td-pg-{{ section.id }}-{{ cat | handleize }}">{{ cat }}</h2>
            {%- if ss[copy_key] != blank -%}<p class="td-pg-lede">{{ ss[copy_key] }}</p>{%- endif -%}
          </div></div>
          <ul class="td-pg-grid td-pg-grid--3">
            {%- for block in section.blocks -%}{%- if block.type == 'service' and block.settings.category == cat -%}
              {%- assign bs = block.settings -%}
              <li class="td-pg-auto__item" id="{{ bs.slug | default: block.id }}" {{ block.shopify_attributes }}>
                <div class="td-pg-card td-pg-card--pad td-pg-card--flex td-pg-svc">
                  <div class="td-pg-svc__top">
                    <h3 class="td-pg-h3">{{ bs.name }}</h3>
                    {%- if bs.mobile -%}<span class="td-pg-badge td-pg-badge--drop">Mobile</span>{%- else -%}<span class="td-pg-badge td-pg-badge--soft">In-Shop</span>{%- endif -%}
                  </div>
                  <p class="td-pg-body td-pg-svc__blurb">{{ bs.blurb }}</p>
                  {%- if bs.includes != blank or bs.symptoms != blank -%}
                    <details class="td-pg-auto__more">
                      <summary>{% render 'td-pg-icon', name: 'chevron-right', size: 16 %}What's included &amp; when to book</summary>
                      {%- if bs.includes != blank -%}
                        <h4>What's included</h4>
                        {%- assign items = bs.includes | newline_to_br | split: '<br />' -%}
                        <ul class="td-pg-ticks">
                          {%- for it in items -%}{%- assign it = it | strip -%}{%- if it != blank -%}
                            <li>{% render 'td-pg-icon', name: 'check', size: 16 %}<span>{{ it }}</span></li>
                          {%- endif -%}{%- endfor -%}
                        </ul>
                      {%- endif -%}
                      {%- if bs.symptoms != blank -%}
                        <h4>Signs you need this</h4>
                        {%- assign items = bs.symptoms | newline_to_br | split: '<br />' -%}
                        <ul class="td-pg-ticks td-pg-auto__signs">
                          {%- for it in items -%}{%- assign it = it | strip -%}{%- if it != blank -%}
                            <li>{% render 'td-pg-icon', name: 'triangle-alert', size: 16 %}<span>{{ it }}</span></li>
                          {%- endif -%}{%- endfor -%}
                        </ul>
                      {%- endif -%}
                      <p class="td-pg-auto__where">{% if bs.mobile %}{{ ss.where_mobile }}{% else %}{{ ss.where_shop }}{% endif %}</p>
                      <a class="td-pg-btn td-pg-btn--primary td-pg-btn--sm" href="{{ booking_url }}">Book {{ bs.name }}{% render 'td-pg-icon', name: 'arrow-right', size: 16 %}</a>
                    </details>
                  {%- endif -%}
                  <div class="td-pg-svc__foot">
                    <span class="td-pg-svc__time">{% render 'td-pg-icon', name: 'clock', size: 14 %}<span class="td-pg-sr">Typical time: </span>{{ bs.duration }}</span>
                    <span class="td-pg-svc__price">From {{ bs.price_from }}<span class="td-pg-svc__unit">{{ bs.price_unit }}</span></span>
                  </div>
                </div>
              </li>
            {%- endif -%}{%- endfor -%}
          </ul>
        </div>
      </section>
    {%- endif -%}
  {%- endfor -%}

  {%- comment -%} ---------- Symptom matcher (dark) ---------- {%- endcomment -%}
  <section class="td-pg-sec td-pg-sec--ink" aria-labelledby="td-pg-{{ section.id }}-sym">
    <div class="td-pg-wrap">
      <div class="td-pg-head"><div class="td-pg-head__text">
        {%- if ss.sym_eyebrow != blank -%}<p class="td-pg-eyebrow td-pg-eyebrow--plain">{{ ss.sym_eyebrow }}</p>{%- endif -%}
        <h2 class="td-pg-h2" id="td-pg-{{ section.id }}-sym">{{ ss.sym_heading }}</h2>
        {%- if ss.sym_lede != blank -%}<p class="td-pg-lede td-pg-auto__sym-lede">{{ ss.sym_lede }}</p>{%- endif -%}
      </div></div>

      <div class="td-pg-auto__matcher" data-td-matcher>
        <div class="td-pg-auto__picker">
          <p class="td-pg-auto__label" id="td-pg-{{ section.id }}-pick">Pick what your vehicle is doing</p>
          <ul class="td-pg-auto__chips" role="group" aria-labelledby="td-pg-{{ section.id }}-pick">
            {%- for block in section.blocks -%}{%- if block.type == 'service' -%}
              {%- assign items = block.settings.symptoms | newline_to_br | split: '<br />' -%}
              {%- for it in items -%}{%- assign it = it | strip -%}{%- if it != blank -%}
                <li><button type="button" aria-pressed="false" data-svc="{{ block.settings.slug | default: block.id }}">{{ it }}</button></li>
              {%- endif -%}{%- endfor -%}
            {%- endif -%}{%- endfor -%}
          </ul>
          <noscript><p class="td-pg-body td-pg-mt2">Every service card above lists the signs it fixes under "What's included &amp; when to book".</p></noscript>
        </div>

        <div class="td-pg-auto__result" aria-live="polite">
          <div class="td-pg-card td-pg-card--pad td-pg-auto__empty" data-result="">
            {% render 'td-pg-icon', name: 'stethoscope', size: 28 %}
            <h3 class="td-pg-h3">{{ ss.sym_empty_heading | default: 'Describe the problem' }}</h3>
            <p class="td-pg-body td-pg-mt1">{{ ss.sym_empty_text | replace: '[phone]', phone }}</p>
          </div>
          {%- for block in section.blocks -%}{%- if block.type == 'service' -%}
            {%- assign bs = block.settings -%}
            <div class="td-pg-card td-pg-card--pad" data-result="{{ bs.slug | default: block.id }}" hidden>
              <p class="td-pg-eyebrow td-pg-eyebrow--plain">What you need</p>
              <div class="td-pg-auto__match-top">
                <h3 class="td-pg-h3">{{ bs.name }}</h3>
                {%- if bs.mobile -%}<span class="td-pg-badge td-pg-badge--drop">Mobile</span>{%- else -%}<span class="td-pg-badge td-pg-badge--soft">In-Shop</span>{%- endif -%}
              </div>
              <p class="td-pg-body td-pg-mt2">{{ bs.blurb }}</p>
              <dl class="td-pg-auto__facts">
                <div><dt>Typical time</dt><dd>{{ bs.duration }}</dd></div>
                <div><dt>Starting at</dt><dd>From {{ bs.price_from }} <span>{{ bs.price_unit }}</span></dd></div>
              </dl>
              <div class="td-pg-btns td-pg-mt3">
                <a class="td-pg-btn td-pg-btn--outline td-pg-btn--sm" href="#{{ bs.slug | default: block.id }}" data-open>Service details</a>
                <a class="td-pg-btn td-pg-btn--primary td-pg-btn--sm" href="{{ booking_url }}">Book it{% render 'td-pg-icon', name: 'arrow-right', size: 16 %}</a>
              </div>
            </div>
          {%- endif -%}{%- endfor -%}
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} ---------- Shop info + CTA ---------- {%- endcomment -%}
  <section class="td-pg-sec td-pg-sec--bone" aria-label="{{ ss.shop_name | escape }}">
    <div class="td-pg-wrap">
      <div class="td-pg-grid td-pg-grid--3-lg td-pg-auto__info">
        <div class="td-pg-card td-pg-card--pad">
          {% render 'td-pg-icon', name: 'warehouse', size: 22, cls: 'td-pg-icon--lead' %}
          <h3 class="td-pg-h3">{{ ss.shop_name }}</h3>
          <address class="td-pg-body td-pg-mt1">{{ ss.address | newline_to_br }}</address>
          {%- if ss.maps_url != blank -%}
            <a class="td-pg-link" href="{{ ss.maps_url }}" target="_blank" rel="noopener">{% render 'td-pg-icon', name: 'map-pin', size: 15 %}Get directions<span class="td-pg-sr"> (opens in a new tab)</span></a>
          {%- endif -%}
        </div>
        <div class="td-pg-card td-pg-card--pad">
          {% render 'td-pg-icon', name: 'clock', size: 22, cls: 'td-pg-icon--lead' %}
          <h3 class="td-pg-h3">Hours</h3>
          {%- assign rows = ss.hours | newline_to_br | split: '<br />' -%}
          <dl class="td-pg-hours">
            {%- for row in rows -%}{%- assign parts = row | strip | split: '|' -%}{%- if parts.size > 1 -%}
              <div><dt>{{ parts[0] | strip }}</dt><dd>{{ parts[1] | strip }}</dd></div>
            {%- endif -%}{%- endfor -%}
          </dl>
        </div>
        <div class="td-pg-card td-pg-card--pad td-pg-card--flex">
          {% render 'td-pg-icon', name: 'phone', size: 22, cls: 'td-pg-icon--lead' %}
          <h3 class="td-pg-h3">{{ ss.book_heading | default: 'Book it now' }}</h3>
          <p class="td-pg-body td-pg-mt1 td-pg-auto__grow">{{ ss.book_text }}</p>
          <div class="td-pg-auto__book-btns">
            <a class="td-pg-btn td-pg-btn--primary td-pg-btn--sm" href="{{ booking_url }}">{{ ss.book_label | default: 'Schedule Service' }}{% render 'td-pg-icon', name: 'arrow-right', size: 16 %}</a>
            <a class="td-pg-btn td-pg-btn--outline td-pg-btn--sm" href="{{ phone_href }}">{% render 'td-pg-icon', name: 'phone', size: 16 %}{{ phone }}</a>
          </div>
        </div>
      </div>
      {%- if ss.tires_lead != blank -%}
        <div class="td-pg-card td-pg-callout td-pg-auto__callout">
          <p class="td-pg-body"><strong>{{ ss.tires_lead }}</strong> {{ ss.tires_text }}</p>
          <a class="td-pg-btn td-pg-btn--dark td-pg-btn--sm" href="{{ ss.tires_link | default: '/pages/mobile-service' }}">{% render 'td-pg-icon', name: 'truck', size: 16 %}{{ ss.tires_label | default: 'Mobile install' }}</a>
        </div>
      {%- endif -%}
    </div>
  </section>
</div>

<script>
  (function () {
    var root = document.getElementById('td-pg-{{ section.id }}');
    if (!root) return;

    // Symptom picker: one chip pressed at a time, its service shown beside it.
    var matcher = root.querySelector('[data-td-matcher]');
    if (matcher) {
      var chips = matcher.querySelectorAll('button[data-svc]');
      var results = matcher.querySelectorAll('[data-result]');
      var show = function (slug) {
        Array.prototype.forEach.call(results, function (r) { r.hidden = r.getAttribute('data-result') !== slug; });
      };
      Array.prototype.forEach.call(chips, function (chip) {
        chip.addEventListener('click', function () {
          var on = chip.getAttribute('aria-pressed') !== 'true';
          Array.prototype.forEach.call(chips, function (c) { c.setAttribute('aria-pressed', 'false'); });
          chip.setAttribute('aria-pressed', on ? 'true' : 'false');
          show(on ? chip.getAttribute('data-svc') : '');
        });
      });
    }

    // A link to #<slug> lands on that card with its details open.
    var openTarget = function () {
      var id = decodeURIComponent((location.hash || '').slice(1));
      if (!id) return;
      var item = document.getElementById(id);
      if (!item || !root.contains(item)) return;
      var more = item.querySelector('details');
      if (more) more.open = true;
    };
    openTarget();
    window.addEventListener('hashchange', openTarget);
  })();
</script>

<style>
  /* ---- Auto-service page only ---- */
  .td-pg-auto__legend { background: #FFFFFF; border-bottom: 1px solid rgba(7,14,26,.1); }
  .td-pg-auto__legend .td-pg-wrap { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem 1.5rem; padding-top: 1rem; padding-bottom: 1rem; font-size: .75rem; color: #586274; }
  .td-pg-auto__legend .td-pg-wrap > span { display: flex; align-items: center; gap: .5rem; }
  .td-pg-auto__item { scroll-margin-top: 7rem; }
  .td-pg-auto__item:target .td-pg-card { box-shadow: 0 0 0 2px #0068E8, 0 8px 20px -6px rgba(7,14,26,.10); }
  .td-pg-auto__more { margin-top: 1rem; }
  .td-pg-auto__more summary { display: flex; align-items: center; gap: .375rem; min-height: 44px; cursor: pointer; list-style: none;
    font-family: var(--font-heading--family, inherit); font-size: .875rem; font-weight: 700; color: #0068E8; }
  .td-pg-auto__more summary::-webkit-details-marker { display: none; }
  .td-pg-auto__more summary:hover { color: #0053C4; }
  .td-pg-auto__more summary .td-pg-icon { transition: transform .2s ease; }
  .td-pg-auto__more[open] summary .td-pg-icon { transform: rotate(90deg); }
  .td-pg-auto__more h4 { margin: 1rem 0 .625rem; font-size: .6875rem; font-weight: 700; letter-spacing: .07em; text-transform: uppercase; color: #586274; }
  .td-pg-auto__more h4:first-of-type { margin-top: .5rem; }
  .td-pg-auto__more .td-pg-ticks li { font-size: .8125rem; color: #070E1A; }
  .td-pg-auto__signs .td-pg-icon { color: #8A4F00 !important; }
  .td-pg-auto__where { margin: 1rem 0; font-size: .8125rem; line-height: 1.5; color: #586274; }
  .td-pg-auto__sym-lede { margin-top: .75rem !important; }
  .td-pg-auto__matcher { display: grid; gap: 1.5rem; padding: 1.5rem; border-radius: 12px; background: #FFFFFF; color: #070E1A;
    box-shadow: 0 0 0 1px rgba(7,14,26,.05), 0 2px 4px rgba(7,14,26,.06), 0 18px 38px -10px rgba(7,14,26,.20); }
  .td-pg-auto__matcher h3 { color: #070E1A !important; }
  /* The picker is a white card inside the dark band: take the light-surface colours back. */
  .td-pg-auto__matcher .td-pg-body { color: #586274; }
  .td-pg-auto__matcher .td-pg-eyebrow { color: #0068E8; }
  .td-pg-auto__picker, .td-pg-auto__result { min-width: 0; }
  .td-pg-auto__label { margin-bottom: .75rem !important; font-family: var(--font-heading--family, inherit); font-size: .6875rem; font-weight: 700;
    letter-spacing: .07em; text-transform: uppercase; color: #586274; }
  .td-pg-auto__chips { display: flex; flex-wrap: wrap; gap: .625rem; }
  .td-pg-auto__chips button { min-height: 44px; padding: .375rem .875rem; border-radius: 6px; border: 1px solid rgba(7,14,26,.15);
    background: #FFFFFF; color: #070E1A; font: inherit; font-size: .875rem; line-height: 1.3; text-align: left; cursor: pointer;
    transition: border-color .15s ease, background-color .15s ease; }
  .td-pg-auto__chips button:hover { border-color: rgba(7,14,26,.4); }
  .td-pg-auto__chips button[aria-pressed="true"] { border-color: #0068E8; background: #0068E8; color: #FFFFFF; }
  .td-pg-auto__empty { display: flex; flex-direction: column; justify-content: center; height: 100%; }
  .td-pg-auto__empty > .td-pg-icon { color: rgba(7,14,26,.2); }
  .td-pg-auto__empty h3 { margin-top: 1rem; }
  .td-pg-auto__match-top { display: flex; flex-wrap: wrap; align-items: center; gap: .75rem; }
  .td-pg-auto__facts { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 1.25rem; padding-top: 1rem; border-top: 1px solid rgba(7,14,26,.1); }
  .td-pg-auto__facts dt { margin-bottom: .375rem; font-family: var(--font-heading--family, inherit); font-size: .6875rem; font-weight: 700; letter-spacing: .07em; text-transform: uppercase; color: #586274; }
  .td-pg-auto__facts dd { font-family: var(--font-heading--family, inherit); font-size: 1rem; color: #070E1A; }
  .td-pg-auto__facts dd span { font-family: var(--font-body--family, inherit); font-size: .75rem; color: #586274; }
  .td-pg-auto__grow { flex: 1; }
  .td-pg-auto__book-btns { display: flex; flex-direction: column; gap: .75rem; margin-top: 1.5rem; }
  .td-pg-auto__info { gap: 1.5rem; }
  .td-pg-auto__callout { margin-top: 1.5rem; }
  @media (min-width: 768px) { .td-pg-auto__matcher { padding: 2rem; } }
  @media (min-width: 1024px) { .td-pg-auto__matcher { grid-template-columns: 1.4fr 1fr; gap: 2.5rem; } }
  @media (prefers-reduced-motion: reduce) { .td-pg-auto__more summary .td-pg-icon { transition: none; } }
</style>

{% schema %}
{
  "name": "TireDrop auto services",
  "tag": "div",
  "class": "td-pg-section",
  "settings": [
    { "type": "text", "id": "phone", "label": "Phone number", "default": "(954) 773-1896", "info": "Written anywhere copy says [phone], and dialled by the call buttons." },
    { "type": "text", "id": "booking_url", "label": "Booking link", "default": "/pages/contact?topic=install", "info": "Where every booking button goes." },
    { "type": "header", "content": "Hero" },
    { "type": "text", "id": "hero_eyebrow", "label": "Eyebrow", "default": "Local service — Sunrise, FL" },
    { "type": "text", "id": "hero_heading", "label": "Heading", "default": "What the shop does besides fit your tires" },
    { "type": "textarea", "id": "hero_lede", "label": "Lede", "info": "[mobile_count] is replaced with the number of services marked mobile." },
    { "type": "text", "id": "hero_cta_label", "label": "Booking button", "default": "Schedule Service" },
    { "type": "text", "id": "hero_cta2_label", "label": "Secondary button", "default": "Ship to store & install" },
    { "type": "url", "id": "hero_cta2_link", "label": "Secondary link" },
    { "type": "header", "content": "Notice and legend" },
    { "type": "text", "id": "notice_lead", "label": "Notice lead", "default": "For local customers." },
    { "type": "textarea", "id": "notice_text", "label": "Notice text" },
    { "type": "text", "id": "legend_mobile", "label": "Mobile legend", "default": "The van comes to your home, office or jobsite" },
    { "type": "text", "id": "legend_shop", "label": "In-shop legend", "default": "Performed at 7712 West Oakland Park Blvd, Sunrise" },
    { "type": "text", "id": "where_mobile", "label": "Card note: mobile services", "default": "Local service — the van performs this at your home, office or jobsite anywhere in the South Florida install area, or you bring the vehicle to Sunrise." },
    { "type": "text", "id": "where_shop", "label": "Card note: in-shop services", "default": "In-shop only — this one needs a lift and bay equipment, so it happens at 7712 West Oakland Park Blvd, Sunrise." },
    { "type": "header", "content": "Service groups" },
    { "type": "textarea", "id": "copy_tires", "label": "Tires lede" },
    { "type": "textarea", "id": "copy_wheels", "label": "Wheels lede" },
    { "type": "textarea", "id": "copy_maintenance", "label": "Maintenance lede" },
    { "type": "textarea", "id": "copy_repair", "label": "Repair lede" },
    { "type": "textarea", "id": "copy_custom", "label": "Custom lede" },
    { "type": "header", "content": "Symptom picker" },
    { "type": "text", "id": "sym_eyebrow", "label": "Eyebrow", "default": "Not sure what you need?" },
    { "type": "text", "id": "sym_heading", "label": "Heading", "default": "Tell us the symptom" },
    { "type": "textarea", "id": "sym_lede", "label": "Lede" },
    { "type": "text", "id": "sym_empty_heading", "label": "Empty panel heading", "default": "Describe the problem" },
