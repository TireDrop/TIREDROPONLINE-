    { "type": "textarea", "id": "hours", "label": "Hours (Days | Time, one per line)", "default": "Mon – Fri | 8:00 AM – 6:30 PM\nSaturday | 8:00 AM – 4:00 PM\nSunday | Closed" },
    { "type": "text", "id": "book_heading", "label": "Booking card heading", "default": "Book it now" },
