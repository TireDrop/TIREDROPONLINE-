{% comment %}
  Mobile install — the Shopify port of src/pages/services/MobileServicePage.jsx.

  React's booking buttons go to its /schedule flow, which the theme does not
  have; here they go to the booking_url setting (the contact page with
  ?topic=install) with the phone beside them. React links each service card to
  /services/<slug>; those detail pages do not exist in the theme, so the cards
  link to the matching card on the auto-service page instead (#<slug>).
  Dark bands pin their text to white.
{% endcomment %}
{%- liquid
  assign ss = section.settings
  assign phone = ss.phone | default: '(954) 773-1896'
  assign phone_digits = phone | remove: '(' | remove: ')' | remove: ' ' | remove: '-' | remove: '.'
  assign phone_href = 'tel:+1' | append: phone_digits
  assign booking_url = ss.booking_url | default: '/pages/contact?topic=install'
  assign services_url = ss.services_url | default: '/pages/auto-service'
-%}
{%- render 'td-pg-kit' -%}

<div class="td-pg td-pg-mob" id="td-pg-{{ section.id }}">
  <header class="td-pg-hero">
    <div class="td-pg-wrap td-pg-hero__inner">
      {%- if ss.hero_eyebrow != blank -%}<p class="td-pg-eyebrow">{{ ss.hero_eyebrow }}</p>{%- endif -%}
      <h1>{{ ss.hero_heading }}</h1>
      {%- if ss.hero_lede != blank -%}<p class="td-pg-hero__lede">{{ ss.hero_lede }}</p>{%- endif -%}
      <div class="td-pg-hero__extra">
        <div class="td-pg-btns">
          {%- if ss.hero_cta_label != blank -%}
            <a class="td-pg-btn td-pg-btn--primary" href="{{ booking_url }}">{{ ss.hero_cta_label }}{% render 'td-pg-icon', name: 'arrow-right', size: 18 %}</a>
          {%- endif -%}
          <a class="td-pg-btn td-pg-btn--ghost" href="{{ phone_href }}">{% render 'td-pg-icon', name: 'phone', size: 18 %}Call {{ phone }}</a>
        </div>
        {%- assign checks = ss.hero_checks | newline_to_br | split: '<br />' -%}
        <ul class="td-pg-checks">
          {%- for c in checks -%}{%- assign c = c | strip -%}{%- if c != blank -%}
            <li>{% render 'td-pg-icon', name: 'check', size: 14 %}{{ c }}</li>
          {%- endif -%}{%- endfor -%}
        </ul>
      </div>
    </div>
  </header>

  {%- if ss.notice_lead != blank or ss.notice_text != blank -%}
    <div class="td-pg-notice">
      <div class="td-pg-wrap">
        {% render 'td-pg-icon', name: 'map-pin', size: 18 %}
        <p><strong>{{ ss.notice_lead }}</strong> {{ ss.notice_text }}{% if ss.notice_link_label != blank %} <a href="{{ ss.notice_link | default: '/pages/shipping' }}">{{ ss.notice_link_label }}</a>.{% endif %}</p>
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} ---------- How it works ---------- {%- endcomment -%}
  <section class="td-pg-sec td-pg-sec--bone" aria-labelledby="td-pg-{{ section.id }}-steps">
    <div class="td-pg-wrap">
      <div class="td-pg-head"><div class="td-pg-head__text">
        {%- if ss.steps_eyebrow != blank -%}<p class="td-pg-eyebrow">{{ ss.steps_eyebrow }}</p>{%- endif -%}
        <h2 class="td-pg-h2" id="td-pg-{{ section.id }}-steps">{{ ss.steps_heading }}</h2>
        {%- if ss.steps_lede != blank -%}<p class="td-pg-lede">{{ ss.steps_lede }}</p>{%- endif -%}
      </div></div>
      <ol class="td-pg-grid td-pg-grid--4">
        {%- assign n = 0 -%}
        {%- for block in section.blocks -%}{%- if block.type == 'step' -%}
          {%- assign n = n | plus: 1 -%}
          <li class="td-pg-card td-pg-card--pad td-pg-card--hover td-pg-card--flex td-pg-step" {{ block.shopify_attributes }}>
            <div class="td-pg-step__top">
              <span class="td-pg-step__icon">{% render 'td-pg-icon', name: block.settings.icon, size: 20 %}</span>
              <span class="td-pg-step__num" aria-hidden="true">{% if n < 10 %}0{% endif %}{{ n }}</span>
            </div>
            <h3 class="td-pg-h3">{{ block.settings.title }}</h3>
            <p class="td-pg-body td-pg-mt1">{{ block.settings.body }}</p>
          </li>
        {%- endif -%}{%- endfor -%}
      </ol>
      {%- if ss.store_lead != blank -%}
        <div class="td-pg-card td-pg-callout">
          <p class="td-pg-body"><strong>{{ ss.store_lead }}</strong> {{ ss.store_text }}</p>
          <a class="td-pg-btn td-pg-btn--dark td-pg-btn--sm" href="{{ ss.store_link | default: '/pages/install' }}">{% render 'td-pg-icon', name: 'store', size: 16 %}{{ ss.store_label | default: 'Ship to store' }}</a>
        </div>
      {%- endif -%}
    </div>
  </section>

  {%- comment -%} ---------- What the van does ---------- {%- endcomment -%}
  <section class="td-pg-sec td-pg-sec--fog" aria-labelledby="td-pg-{{ section.id }}-svc">
    <div class="td-pg-wrap">
      <div class="td-pg-head td-pg-head--action">
        <div class="td-pg-head__text">
          {%- if ss.svc_eyebrow != blank -%}<p class="td-pg-eyebrow">{{ ss.svc_eyebrow }}</p>{%- endif -%}
          <h2 class="td-pg-h2" id="td-pg-{{ section.id }}-svc">{{ ss.svc_heading }}</h2>
          {%- if ss.svc_lede != blank -%}<p class="td-pg-lede">{{ ss.svc_lede }}</p>{%- endif -%}
        </div>
        <div class="td-pg-head__action">
          <a class="td-pg-btn td-pg-btn--outline td-pg-btn--sm" href="{{ services_url }}">{{ ss.svc_all_label | default: 'See all services' }}{% render 'td-pg-icon', name: 'arrow-right', size: 16 %}</a>
        </div>
      </div>
      <ul class="td-pg-grid td-pg-grid--3">
        {%- for block in section.blocks -%}{%- if block.type == 'service' -%}
          {%- assign bs = block.settings -%}
          <li {{ block.shopify_attributes }}>
            <a class="td-pg-card td-pg-card--pad td-pg-card--hover td-pg-card--flex td-pg-svc" href="{{ services_url }}#{{ bs.slug }}">
              <div class="td-pg-svc__top">
                <h3 class="td-pg-h3">{{ bs.name }}</h3>
                <span class="td-pg-badge td-pg-badge--drop">Mobile</span>
              </div>
              <p class="td-pg-body td-pg-svc__blurb">{{ bs.blurb }}</p>
              <div class="td-pg-svc__foot">
                <span class="td-pg-svc__time">{% render 'td-pg-icon', name: 'clock', size: 14 %}<span class="td-pg-sr">Typical time: </span>{{ bs.duration }}</span>
                <span class="td-pg-svc__price">From {{ bs.price_from }}<span class="td-pg-svc__unit">{{ bs.price_unit }}</span></span>
              </div>
            </a>
          </li>
        {%- endif -%}{%- endfor -%}
      </ul>
    </div>
  </section>

  {%- comment -%} ---------- Install area ---------- {%- endcomment -%}
  <section class="td-pg-sec td-pg-sec--bone" aria-labelledby="td-pg-{{ section.id }}-area">
    <div class="td-pg-wrap">
      <div class="td-pg-head"><div class="td-pg-head__text">
        {%- if ss.area_eyebrow != blank -%}<p class="td-pg-eyebrow">{{ ss.area_eyebrow }}</p>{%- endif -%}
        <h2 class="td-pg-h2" id="td-pg-{{ section.id }}-area">{{ ss.area_heading }}</h2>
        {%- if ss.area_lede != blank -%}<p class="td-pg-lede">{{ ss.area_lede }}</p>{%- endif -%}
      </div></div>
      {%- assign cities = ss.cities | newline_to_br | split: '<br />' -%}
      <ul class="td-pg-chips">
        {%- for city in cities -%}{%- assign city = city | strip -%}{%- if city != blank -%}
          <li>{% render 'td-pg-icon', name: 'map-pin', size: 14 %}{{ city }}</li>
        {%- endif -%}{%- endfor -%}
      </ul>
      {%- if ss.outside_lead != blank -%}
        <div class="td-pg-card td-pg-callout">
          <p class="td-pg-body"><strong>{{ ss.outside_lead }}</strong> {{ ss.outside_text }}</p>
          <a class="td-pg-btn td-pg-btn--dark td-pg-btn--sm" href="{{ phone_href }}">{% render 'td-pg-icon', name: 'phone', size: 16 %}{{ phone }}</a>
        </div>
      {%- endif -%}
    </div>
  </section>

  {%- comment -%} ---------- What's in the van (dark) ---------- {%- endcomment -%}
  <section class="td-pg-sec td-pg-sec--ink" aria-labelledby="td-pg-{{ section.id }}-kit">
    <div class="td-pg-wrap">
      <div class="td-pg-head"><div class="td-pg-head__text">
        {%- if ss.kit_eyebrow != blank -%}<p class="td-pg-eyebrow td-pg-eyebrow--plain">{{ ss.kit_eyebrow }}</p>{%- endif -%}
        <h2 class="td-pg-h2" id="td-pg-{{ section.id }}-kit">{{ ss.kit_heading }}</h2>
        {%- if ss.kit_lede != blank -%}<p class="td-pg-lede td-pg-mob__kit-lede">{{ ss.kit_lede }}</p>{%- endif -%}
      </div></div>
      <ul class="td-pg-mob__kit">
        {%- for block in section.blocks -%}{%- if block.type == 'kit' -%}
          <li {{ block.shopify_attributes }}>
            {% render 'td-pg-icon', name: block.settings.icon, size: 22 %}
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.body }}</p>
          </li>
        {%- endif -%}{%- endfor -%}
      </ul>
    </div>
  </section>

  {%- comment -%} ---------- Comparison ---------- {%- endcomment -%}
  <section class="td-pg-sec td-pg-sec--fog" aria-labelledby="td-pg-{{ section.id }}-vs">
    <div class="td-pg-wrap">
      <div class="td-pg-head td-pg-head--center"><div class="td-pg-head__text">
        {%- if ss.vs_eyebrow != blank -%}<p class="td-pg-eyebrow">{{ ss.vs_eyebrow }}</p>{%- endif -%}
        <h2 class="td-pg-h2" id="td-pg-{{ section.id }}-vs">{{ ss.vs_heading }}</h2>
        {%- if ss.vs_lede != blank -%}<p class="td-pg-lede">{{ ss.vs_lede }}</p>{%- endif -%}
      </div></div>
      <div class="td-pg-grid td-pg-grid--2">
        <div class="td-pg-card">
          <div class="td-pg-vs__head td-pg-vs__head--us">{% render 'td-pg-icon', name: 'truck', size: 18 %}<h3>{{ ss.vs_us_heading | default: 'Mobile install' }}</h3></div>
          <ul class="td-pg-vs td-pg-vs--us">
            {%- for block in section.blocks -%}{%- if block.type == 'compare' and block.settings.us != blank -%}
              <li {{ block.shopify_attributes }}>{% render 'td-pg-icon', name: 'check', size: 18 %}<span>{{ block.settings.us }}</span></li>
            {%- endif -%}{%- endfor -%}
          </ul>
        </div>
        <div class="td-pg-card">
          <div class="td-pg-vs__head td-pg-vs__head--them">{% render 'td-pg-icon', name: 'clock', size: 18 %}<h3>{{ ss.vs_them_heading | default: 'The traditional tire stop' }}</h3></div>
          <ul class="td-pg-vs td-pg-vs--them">
            {%- for block in section.blocks -%}{%- if block.type == 'compare' and block.settings.them != blank -%}
              <li>{% render 'td-pg-icon', name: 'x', size: 18 %}<span>{{ block.settings.them }}</span></li>
            {%- endif -%}{%- endfor -%}
          </ul>
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} ---------- FAQ ---------- {%- endcomment -%}
  <section class="td-pg-sec td-pg-sec--bone" aria-labelledby="td-pg-{{ section.id }}-faq">
    <div class="td-pg-wrap">
      <div class="td-pg-head"><div class="td-pg-head__text">
        {%- if ss.faq_eyebrow != blank -%}<p class="td-pg-eyebrow">{{ ss.faq_eyebrow }}</p>{%- endif -%}
        <h2 class="td-pg-h2" id="td-pg-{{ section.id }}-faq">{{ ss.faq_heading }}</h2>
        {%- if ss.faq_lede != blank -%}<p class="td-pg-lede">{{ ss.faq_lede }}</p>{%- endif -%}
      </div></div>
      <div class="td-pg-faq">
        {%- for block in section.blocks -%}{%- if block.type == 'faq' -%}
          <details {{ block.shopify_attributes }}>
            <summary>{{ block.settings.question }}{% render 'td-pg-icon', name: 'chevron-right', size: 18 %}</summary>
            <p>{{ block.settings.answer | replace: '[phone]', phone }}</p>
          </details>
        {%- endif -%}{%- endfor -%}
      </div>
    </div>
  </section>

  {%- comment -%} ---------- Closing CTA ---------- {%- endcomment -%}
  <section class="td-pg-sec td-pg-sec--steel" aria-labelledby="td-pg-{{ section.id }}-cta">
    <div class="td-pg-wrap td-pg-cta">
      <div class="td-pg-cta__text">
        {%- if ss.cta_eyebrow != blank -%}<p class="td-pg-eyebrow td-pg-eyebrow--plain">{{ ss.cta_eyebrow }}</p>{%- endif -%}
        <h2 class="td-pg-h2" id="td-pg-{{ section.id }}-cta">{{ ss.cta_heading }}</h2>
        {%- if ss.cta_lede != blank -%}<p class="td-pg-lede">{{ ss.cta_lede }}</p>{%- endif -%}
      </div>
      <div class="td-pg-btns">
        {%- if ss.cta_label != blank -%}
          <a class="td-pg-btn td-pg-btn--primary" href="{{ booking_url }}">{{ ss.cta_label }}{% render 'td-pg-icon', name: 'arrow-right', size: 18 %}</a>
        {%- endif -%}
        <a class="td-pg-btn td-pg-btn--ghost" href="{{ phone_href }}">{% render 'td-pg-icon', name: 'phone', size: 18 %}{{ phone }}</a>
      </div>
    </div>
  </section>
</div>

<style>
  /* ---- Mobile-service page only ---- */
  .td-pg-mob__kit-lede { margin-top: .75rem !important; }
  .td-pg-mob__kit { display: grid; gap: 1.5rem 2rem; }
  .td-pg-mob__kit li { border-top: 1px solid #22344C; padding-top: 1.25rem; }
  .td-pg-mob__kit .td-pg-icon { color: #00B4FC; }
  .td-pg-mob__kit h3 { margin-top: .75rem; font-size: 1.0625rem; line-height: 1.3; color: #FFFFFF; }
  .td-pg-mob__kit p { margin-top: .375rem; font-size: .875rem; line-height: 1.625; color: rgba(255,255,255,.65); }
  @media (min-width: 640px) { .td-pg-mob__kit { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .td-pg-mob__kit { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
</style>

{% schema %}
{
  "name": "TireDrop mobile install",
  "tag": "div",
  "class": "td-pg-section",
  "settings": [
    { "type": "text", "id": "phone", "label": "Phone number", "default": "(954) 773-1896", "info": "Written anywhere copy says [phone], and dialled by the call buttons." },
    { "type": "text", "id": "booking_url", "label": "Booking link", "default": "/pages/contact?topic=install", "info": "Where every booking button goes." },
    { "type": "text", "id": "services_url", "label": "All-services page", "default": "/pages/auto-service", "info": "Service cards link here, to the card with the same slug." },
    { "type": "header", "content": "Hero" },
    { "type": "text", "id": "hero_eyebrow", "label": "Eyebrow", "default": "Mobile install — South Florida" },
    { "type": "text", "id": "hero_heading", "label": "Heading", "default": "You bought the tires. We'll come fit them." },
    { "type": "textarea", "id": "hero_lede", "label": "Lede" },
    { "type": "text", "id": "hero_cta_label", "label": "Booking button", "default": "Book Mobile Install" },
    { "type": "textarea", "id": "hero_checks", "label": "Check marks (one per line)", "default": "Powered by Extreme Tires\nTwo-hour arrival windows\nOld tires hauled away" },
    { "type": "header", "content": "Local notice" },
    { "type": "text", "id": "notice_lead", "label": "Bold lead", "default": "Broward County only." },
    { "type": "textarea", "id": "notice_text", "label": "Text" },
    { "type": "text", "id": "notice_link_label", "label": "Link text", "default": "See how shipping works" },
    { "type": "url", "id": "notice_link", "label": "Link" },
    { "type": "header", "content": "How it works" },
    { "type": "text", "id": "steps_eyebrow", "label": "Eyebrow", "default": "How it works" },
    { "type": "text", "id": "steps_heading", "label": "Heading", "default": "Order online. Fitted in your driveway." },
    { "type": "textarea", "id": "steps_lede", "label": "Lede" },
    { "type": "text", "id": "store_lead", "label": "Callout lead", "default": "Rather come to us?" },
    { "type": "textarea", "id": "store_text", "label": "Callout text" },
    { "type": "text", "id": "store_label", "label": "Callout button", "default": "Ship to store" },
    { "type": "url", "id": "store_link", "label": "Callout link" },
    { "type": "header", "content": "Mobile services" },
    { "type": "text", "id": "svc_eyebrow", "label": "Eyebrow", "default": "Mobile services" },
    { "type": "text", "id": "svc_heading", "label": "Heading", "default": "What the van can do at your curb" },
    { "type": "textarea", "id": "svc_lede", "label": "Lede" },
    { "type": "text", "id": "svc_all_label", "label": "All-services button", "default": "See all services" },
    { "type": "header", "content": "Install area" },
    { "type": "text", "id": "area_eyebrow", "label": "Eyebrow", "default": "Install area" },
    { "type": "text", "id": "area_heading", "label": "Heading", "default": "Where the van rolls" },
    { "type": "textarea", "id": "area_lede", "label": "Lede" },
    { "type": "textarea", "id": "cities", "label": "Cities (one per line)", "default": "Sunrise\nPlantation\nFort Lauderdale\nDavie\nWeston\nCoral Springs\nTamarac\nLauderhill\nPembroke Pines\nMiramar" },
    { "type": "text", "id": "outside_lead", "label": "Callout lead", "default": "Just outside the area?" },
    { "type": "textarea", "id": "outside_text", "label": "Callout text" },
    { "type": "header", "content": "What's in the van" },
    { "type": "text", "id": "kit_eyebrow", "label": "Eyebrow", "default": "What's in the van" },
    { "type": "text", "id": "kit_heading", "label": "Heading", "default": "A shop on four wheels" },
    { "type": "textarea", "id": "kit_lede", "label": "Lede" },
    { "type": "header", "content": "Comparison" },
    { "type": "text", "id": "vs_eyebrow", "label": "Eyebrow", "default": "The difference" },
    { "type": "text", "id": "vs_heading", "label": "Heading", "default": "Your driveway vs. their waiting room" },
    { "type": "textarea", "id": "vs_lede", "label": "Lede", "default": "Same tires. Same torque spec. Completely different afternoon." },
    { "type": "text", "id": "vs_us_heading", "label": "Left heading", "default": "Mobile install" },
    { "type": "text", "id": "vs_them_heading", "label": "Right heading", "default": "The traditional tire stop" },
    { "type": "header", "content": "FAQ" },
    { "type": "text", "id": "faq_eyebrow", "label": "Eyebrow", "default": "Questions, answered" },
    { "type": "text", "id": "faq_heading", "label": "Heading", "default": "Before you book" },
    { "type": "textarea", "id": "faq_lede", "label": "Lede" },
    { "type": "header", "content": "Closing band" },
    { "type": "text", "id": "cta_eyebrow", "label": "Eyebrow", "default": "Tires shipped. Or installed." },
    { "type": "text", "id": "cta_heading", "label": "Heading", "default": "Stop planning your day around a tire shop" },
    { "type": "textarea", "id": "cta_lede", "label": "Lede" },
    { "type": "text", "id": "cta_label", "label": "Booking button", "default": "Schedule Now" }
  ],
  "blocks": [
    { "type": "step", "name": "Step", "settings": [
      {"type": "select", "id": "icon", "label": "Icon", "default": "check", "options": [{"value": "truck", "label": "Truck"}, {"value": "store", "label": "Store"}, {"value": "receipt", "label": "Receipt"}, {"value": "package-search", "label": "Package search"}, {"value": "package-check", "label": "Package check"}, {"value": "package-x", "label": "Package x"}, {"value": "boxes", "label": "Boxes"}, {"value": "shield-check", "label": "Shield check"}, {"value": "phone", "label": "Phone"}, {"value": "triangle-alert", "label": "Triangle alert"}, {"value": "map-pin", "label": "Map pin"}, {"value": "shopping-cart", "label": "Shopping cart"}, {"value": "calendar-check", "label": "Calendar check"}, {"value": "calendar-clock", "label": "Calendar clock"}, {"value": "wrench", "label": "Wrench"}, {"value": "home", "label": "Home"}, {"value": "check", "label": "Check"}, {"value": "circle-check", "label": "Circle check"}, {"value": "clock", "label": "Clock"}, {"value": "gauge", "label": "Gauge"}, {"value": "radio", "label": "Radio"}, {"value": "ruler", "label": "Ruler"}, {"value": "ban", "label": "Ban"}, {"value": "zap", "label": "Zap"}, {"value": "stethoscope", "label": "Stethoscope"}, {"value": "warehouse", "label": "Warehouse"}, {"value": "dollar-sign", "label": "Dollar sign"}, {"value": "tag", "label": "Tag"}, {"value": "info", "label": "Info"}]},
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "textarea", "id": "body", "label": "Body" }
    ] },
