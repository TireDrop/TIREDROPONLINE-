  "settings": [
    { "type": "header", "content": "Tires (handles without \"wheel\")" },
    { "type": "text", "id": "tire_eyebrow", "label": "Eyebrow", "default": "Tires" },
    { "type": "text", "id": "tire_heading", "label": "Heading", "default": "Shop Tires" },
    { "type": "textarea", "id": "tire_lede", "label": "Intro", "default": "Find your size, pick your set, then choose where it lands — your address anywhere in the continental US, or free to our South Florida shop where we fit them for you." },
    { "type": "text", "id": "tire_empty_title", "label": "No products yet: heading", "default": "No tires listed online yet" },
    { "type": "textarea", "id": "tire_empty_lede", "label": "No products yet: text", "default": "Our online catalog is still being loaded. Call us with your size and we will quote it, or use Find My Tires to look up the size your vehicle takes." },
    { "type": "textarea", "id": "tire_nomatch_lede", "label": "No filter matches: text", "default": "Try widening the price range or clearing a size. If you know your size and cannot find it listed, call us — we can order sizes this page does not carry." },
    { "type": "text", "id": "tire_band_title", "label": "Band heading", "default": "Shipped to you, or fitted by us" },
    { "type": "textarea", "id": "tire_band_copy", "label": "Band text", "default": "Every order ships free anywhere in the continental US. In South Florida, send it free to the shop instead and we mount, balance and dispose of the old set." },
    { "type": "text", "id": "tire_band_label", "label": "Band button", "default": "How shipping works" },
    { "type": "url", "id": "tire_band_link", "label": "Band link" },
    { "type": "header", "content": "Wheels (handles containing \"wheel\")" },
    { "type": "text", "id": "wheel_eyebrow", "label": "Eyebrow", "default": "Wheels" },
    { "type": "text", "id": "wheel_heading", "label": "Heading", "default": "Shop Wheels" },
    { "type": "textarea", "id": "wheel_lede", "label": "Intro", "default": "Cast, flow-formed and forged wheels, fitment-checked before they ship. Send them to your address anywhere in the continental US, or free to our South Florida shop where we fit them for you." },
    { "type": "text", "id": "wheel_empty_title", "label": "No products yet: heading", "default": "No wheels listed online yet" },
    { "type": "textarea", "id": "wheel_empty_lede", "label": "No products yet: text", "default": "Our online catalog is still being loaded. Call us with your vehicle and the look you want and we will quote the right wheel, or use Find My Tires to look up your size." },
    { "type": "textarea", "id": "wheel_nomatch_lede", "label": "No filter matches: text", "default": "Tell us the look you want and your vehicle, and we will source the right bolt pattern and offset." },
    { "type": "text", "id": "wheel_band_title", "label": "Band heading", "default": "Wheel and tire packages" },
    { "type": "textarea", "id": "wheel_band_copy", "label": "Band text", "default": "Buy the wheels and tires together and they ship as one order. In South Florida, send it free to the shop and we mount, balance and fit the whole package." },
    { "type": "text", "id": "wheel_band_label", "label": "Band button", "default": "Ship to store & install" },
    { "type": "url", "id": "wheel_band_link", "label": "Band link" },
    { "type": "header", "content": "Finder and contact" },
    { "type": "checkbox", "id": "show_finder", "label": "Show the vehicle / size finder", "default": true },
    { "type": "textarea", "id": "vehicle_copy", "label": "Vehicle tab text", "default": "Look up the tire size your vehicle takes with Find My Tires, then come back and shop that size." },
    { "type": "text", "id": "vehicle_button", "label": "Vehicle tab button", "default": "Open Find My Tires" },
    { "type": "url", "id": "finder_link", "label": "Find My Tires page" },
    { "type": "text", "id": "phone", "label": "Phone", "default": "(954) 773-1896" },
    { "type": "range", "id": "per_page", "label": "Products per page", "min": 12, "max": 48, "step": 6, "default": 24 }
  ]
