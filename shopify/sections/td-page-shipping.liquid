{% comment %}
  How shipping works — the Shopify port of src/pages/ShippingPage.jsx.

  One section holds the whole page so the bands stay in React's order. Copy
  lives in settings (headings, ledes) and blocks (cards, steps, FAQ), so it can
  be edited in the theme editor. Dark bands pin their text to white.
{% endcomment %}
{%- liquid
  assign ss = section.settings
  assign phone = ss.phone | default: '(954) 773-1896'
  assign phone_digits = phone | remove: '(' | remove: ')' | remove: ' ' | remove: '-' | remove: '.'
  assign phone_href = 'tel:+1' | append: phone_digits
-%}
{%- render 'td-pg-kit' -%}

<div class="td-pg td-pg-ship" id="td-pg-{{ section.id }}">
  <nav class="td-pg-crumbs" aria-label="Breadcrumb">
    <ol class="td-pg-wrap">
      <li><a href="{{ routes.root_url }}">Home</a></li>
      <li>{% render 'td-pg-icon', name: 'chevron-right', size: 13 %}<span aria-current="page">{{ ss.crumb | default: 'How shipping works' }}</span></li>
    </ol>
  </nav>

  <header class="td-pg-hero">
    <div class="td-pg-wrap td-pg-hero__inner">
      {%- if ss.hero_eyebrow != blank -%}<p class="td-pg-eyebrow">{{ ss.hero_eyebrow }}</p>{%- endif -%}
      <h1>{{ ss.hero_heading }}</h1>
      {%- if ss.hero_lede != blank -%}<p class="td-pg-hero__lede">{{ ss.hero_lede }}</p>{%- endif -%}
      <div class="td-pg-hero__extra">
        <div class="td-pg-btns">
          {%- if ss.hero_cta1_label != blank -%}
            <a class="td-pg-btn td-pg-btn--primary" href="{{ ss.hero_cta1_link | default: routes.all_products_collection_url }}">{{ ss.hero_cta1_label }}{% render 'td-pg-icon', name: 'arrow-right', size: 18 %}</a>
          {%- endif -%}
          {%- if ss.hero_cta2_label != blank -%}
            <a class="td-pg-btn td-pg-btn--ghost" href="{{ ss.hero_cta2_link | default: '/pages/install' }}">{% render 'td-pg-icon', name: 'store', size: 18 %}{{ ss.hero_cta2_label }}</a>
          {%- endif -%}
        </div>
        {%- assign checks = ss.hero_checks | newline_to_br | split: '<br />' -%}
        <ul class="td-pg-checks">
          {%- for c in checks -%}{%- assign c = c | strip -%}{%- if c != blank -%}
            <li>{% render 'td-pg-icon', name: 'check', size: 14 %}{{ c }}</li>
          {%- endif -%}{%- endfor -%}
        </ul>
      </div>
    </div>
  </header>

  {%- comment -%} ---------- Drop-ship model ---------- {%- endcomment -%}
  <section class="td-pg-sec td-pg-sec--bone" aria-labelledby="td-pg-{{ section.id }}-model">
    <div class="td-pg-wrap td-pg-ship__model">
      <div class="td-pg-ship__model-text">
        {%- if ss.model_eyebrow != blank -%}<p class="td-pg-eyebrow td-pg-eyebrow--plain">{{ ss.model_eyebrow }}</p>{%- endif -%}
        <h2 class="td-pg-h2" id="td-pg-{{ section.id }}-model">{{ ss.model_heading }}</h2>
        {%- if ss.model_lede != blank -%}<p class="td-pg-lede td-pg-mt2">{{ ss.model_lede }}</p>{%- endif -%}
        {%- if ss.model_body != blank -%}<p class="td-pg-body td-pg-mt2">{{ ss.model_body }}</p>{%- endif -%}
      </div>
      <ul class="td-pg-grid td-pg-ship__features">
        {%- for block in section.blocks -%}{%- if block.type == 'feature' -%}
          <li class="td-pg-card td-pg-card--pad" {{ block.shopify_attributes }}>
            {% render 'td-pg-icon', name: block.settings.icon, size: 22, cls: 'td-pg-icon--lead' %}
            <h3 class="td-pg-h3">{{ block.settings.title }}</h3>
            <p class="td-pg-body td-pg-mt1">{{ block.settings.body | replace: '[phone]', phone | replace: phone, '<a href="PHONE_HREF">PHONE_TXT</a>' | replace: 'PHONE_HREF', phone_href | replace: 'PHONE_TXT', phone }}</p>
          </li>
        {%- endif -%}{%- endfor -%}
      </ul>
    </div>
  </section>

  {%- comment -%} ---------- Two delivery choices ---------- {%- endcomment -%}
  <section class="td-pg-sec td-pg-sec--fog" aria-labelledby="td-pg-{{ section.id }}-choices">
    <div class="td-pg-wrap">
      <div class="td-pg-head td-pg-head--center"><div class="td-pg-head__text">
        {%- if ss.choices_eyebrow != blank -%}<p class="td-pg-eyebrow">{{ ss.choices_eyebrow }}</p>{%- endif -%}
        <h2 class="td-pg-h2" id="td-pg-{{ section.id }}-choices">{{ ss.choices_heading }}</h2>
        {%- if ss.choices_lede != blank -%}<p class="td-pg-lede">{{ ss.choices_lede }}</p>{%- endif -%}
      </div></div>
      <div class="td-pg-grid td-pg-grid--2">
        {%- for block in section.blocks -%}{%- if block.type == 'choice' -%}
          {%- assign bs = block.settings -%}
          <div class="td-pg-card td-pg-card--pad td-pg-card--pad-lg td-pg-card--flex" {{ block.shopify_attributes }}>
            <div class="td-pg-ship__choice-top">
              {% render 'td-pg-icon', name: bs.icon, size: 26, cls: 'td-pg-icon--lead' %}
              {%- if bs.badge != blank -%}<span class="td-pg-badge td-pg-badge--soft">{{ bs.badge }}</span>{%- endif -%}
            </div>
            <h3 class="td-pg-h3 td-pg-mt3">{{ bs.title }}</h3>
            <p class="td-pg-body td-pg-mt1">{{ bs.body }}</p>
            {%- assign pts = bs.points | newline_to_br | split: '<br />' -%}
            <ul class="td-pg-ticks td-pg-mt3 td-pg-ship__points">
              {%- for p in pts -%}{%- assign p = p | strip -%}{%- if p != blank -%}
                <li>{% render 'td-pg-icon', name: 'check', size: 17 %}<span>{{ p }}</span></li>
              {%- endif -%}{%- endfor -%}
            </ul>
            {%- if bs.cta_label != blank -%}
              <a class="td-pg-btn td-pg-btn--outline td-pg-btn--sm td-pg-ship__choice-cta" href="{{ bs.cta_link | default: '#' }}">{{ bs.cta_label }}{% render 'td-pg-icon', name: 'arrow-right', size: 16 %}</a>
            {%- endif -%}
          </div>
        {%- endif -%}{%- endfor -%}
      </div>
    </div>
  </section>

  {%- comment -%} ---------- Order flow ---------- {%- endcomment -%}
  <section class="td-pg-sec td-pg-sec--bone" aria-labelledby="td-pg-{{ section.id }}-steps">
    <div class="td-pg-wrap">
      <div class="td-pg-head"><div class="td-pg-head__text">
        {%- if ss.steps_eyebrow != blank -%}<p class="td-pg-eyebrow">{{ ss.steps_eyebrow }}</p>{%- endif -%}
        <h2 class="td-pg-h2" id="td-pg-{{ section.id }}-steps">{{ ss.steps_heading }}</h2>
        {%- if ss.steps_lede != blank -%}<p class="td-pg-lede">{{ ss.steps_lede }}</p>{%- endif -%}
      </div></div>
      <ol class="td-pg-grid td-pg-grid--4">
        {%- assign n = 0 -%}
        {%- for block in section.blocks -%}{%- if block.type == 'step' -%}
          {%- assign n = n | plus: 1 -%}
          <li class="td-pg-card td-pg-card--pad td-pg-card--hover td-pg-card--flex td-pg-step" {{ block.shopify_attributes }}>
            <div class="td-pg-step__top">
              <span class="td-pg-step__icon">{% render 'td-pg-icon', name: block.settings.icon, size: 20 %}</span>
              <span class="td-pg-step__num" aria-hidden="true">{% if n < 10 %}0{% endif %}{{ n }}</span>
            </div>
            <h3 class="td-pg-h3">{{ block.settings.title }}</h3>
            <p class="td-pg-body td-pg-mt1">{{ block.settings.body }}</p>
          </li>
        {%- endif -%}{%- endfor -%}
      </ol>
    </div>
  </section>

  {%- comment -%} ---------- Coverage (dark) ---------- {%- endcomment -%}
  <section class="td-pg-sec td-pg-sec--ink" aria-labelledby="td-pg-{{ section.id }}-cov">
    <div class="td-pg-wrap td-pg-ship__cov">
      <div>
        {%- if ss.cov_eyebrow != blank -%}<p class="td-pg-eyebrow td-pg-eyebrow--plain">{{ ss.cov_eyebrow }}</p>{%- endif -%}
        <h2 class="td-pg-h2" id="td-pg-{{ section.id }}-cov">{{ ss.cov_heading }}</h2>
        {%- if ss.cov_lede != blank -%}<p class="td-pg-lede td-pg-mt2">{{ ss.cov_lede }}</p>{%- endif -%}
        {%- if ss.cov_body != blank -%}<p class="td-pg-body td-pg-mt2 td-pg-ship__cov-body">{{ ss.cov_body }}</p>{%- endif -%}
        <div class="td-pg-btns td-pg-ship__cov-btns">
          {%- if ss.cov_cta_label != blank -%}
            <a class="td-pg-btn td-pg-btn--primary" href="{{ ss.cov_cta_link | default: '/pages/install' }}">{{ ss.cov_cta_label }}{% render 'td-pg-icon', name: 'arrow-right', size: 18 %}</a>
          {%- endif -%}
          <a class="td-pg-btn td-pg-btn--ghost" href="{{ phone_href }}">{% render 'td-pg-icon', name: 'phone', size: 18 %}{{ phone }}</a>
        </div>
      </div>
      <div class="td-pg-panel td-pg-ship__costs">
        <h3 class="td-pg-h3">{{ ss.costs_heading }}</h3>
        {%- if ss.costs_body != blank -%}<p class="td-pg-body td-pg-mt2">{{ ss.costs_body }}</p>{%- endif -%}
        {%- assign items = ss.costs_list | newline_to_br | split: '<br />' -%}
        <ul class="td-pg-ship__costs-list">
          {%- for it in items -%}{%- assign it = it | strip -%}{%- if it != blank -%}
            <li>{% render 'td-pg-icon', name: 'check', size: 17 %}<span>{{ it }}</span></li>
          {%- endif -%}{%- endfor -%}
        </ul>
      </div>
    </div>
  </section>

  {%- comment -%} ---------- When something goes wrong ---------- {%- endcomment -%}
  <section class="td-pg-sec td-pg-sec--fog" aria-labelledby="td-pg-{{ section.id }}-wrong">
    <div class="td-pg-wrap">
      <div class="td-pg-head"><div class="td-pg-head__text">
        {%- if ss.wrong_eyebrow != blank -%}<p class="td-pg-eyebrow">{{ ss.wrong_eyebrow }}</p>{%- endif -%}
        <h2 class="td-pg-h2" id="td-pg-{{ section.id }}-wrong">{{ ss.wrong_heading }}</h2>
        {%- if ss.wrong_lede != blank -%}<p class="td-pg-lede">{{ ss.wrong_lede }}</p>{%- endif -%}
      </div></div>
      <div class="td-pg-grid td-pg-grid--3-lg">
        {%- for block in section.blocks -%}{%- if block.type == 'problem' -%}
          {%- assign bs = block.settings -%}
          <div class="td-pg-card td-pg-card--pad td-pg-card--pad-lg" {{ block.shopify_attributes }}>
            {% render 'td-pg-icon', name: bs.icon, size: 24, cls: 'td-pg-icon--lead' %}
            <h3 class="td-pg-h3">{{ bs.title }}</h3>
            {%- if bs.intro != blank -%}<p class="td-pg-body td-pg-mt2">{{ bs.intro }}</p>{%- endif -%}
            {%- assign stp = bs.steps | newline_to_br | split: '<br />' -%}
            {%- assign k = 0 -%}
            {%- capture stp_html -%}
              {%- for s in stp -%}{%- assign s = s | strip -%}{%- if s != blank -%}{%- assign k = k | plus: 1 -%}
                <li><span class="td-pg-ship__n" aria-hidden="true">0{{ k }}</span><span>{{ s | replace: '[phone]', phone }}</span></li>
              {%- endif -%}{%- endfor -%}
            {%- endcapture -%}
            {%- if k > 0 -%}<ol class="td-pg-ship__nums">{{ stp_html }}</ol>{%- endif -%}
            {%- if bs.body != blank -%}<p class="td-pg-body td-pg-body--ink td-pg-mt2">{{ bs.body | replace: '[phone]', phone }}</p>{%- endif -%}
          </div>
        {%- endif -%}{%- endfor -%}
      </div>
    </div>
  </section>

  {%- comment -%} ---------- FAQ ---------- {%- endcomment -%}
  <section class="td-pg-sec td-pg-sec--bone" aria-labelledby="td-pg-{{ section.id }}-faq">
    <div class="td-pg-wrap">
      <div class="td-pg-head"><div class="td-pg-head__text">
        {%- if ss.faq_eyebrow != blank -%}<p class="td-pg-eyebrow">{{ ss.faq_eyebrow }}</p>{%- endif -%}
        <h2 class="td-pg-h2" id="td-pg-{{ section.id }}-faq">{{ ss.faq_heading }}</h2>
        {%- if ss.faq_lede != blank -%}<p class="td-pg-lede">{{ ss.faq_lede }}</p>{%- endif -%}
      </div></div>
      <div class="td-pg-faq">
        {%- for block in section.blocks -%}{%- if block.type == 'faq' -%}
          <details {{ block.shopify_attributes }}>
            <summary>{{ block.settings.question }}{% render 'td-pg-icon', name: 'chevron-right', size: 18 %}</summary>
            <p>{{ block.settings.answer | replace: '[phone]', phone }}</p>
          </details>
        {%- endif -%}{%- endfor -%}
      </div>
    </div>
  </section>

  {%- comment -%} ---------- Closing CTA ---------- {%- endcomment -%}
  <section class="td-pg-sec td-pg-sec--steel" aria-labelledby="td-pg-{{ section.id }}-cta">
    <div class="td-pg-wrap td-pg-cta">
      <div class="td-pg-cta__text">
        {%- if ss.cta_eyebrow != blank -%}<p class="td-pg-eyebrow td-pg-eyebrow--plain">{{ ss.cta_eyebrow }}</p>{%- endif -%}
        <h2 class="td-pg-h2" id="td-pg-{{ section.id }}-cta">{{ ss.cta_heading }}</h2>
        {%- if ss.cta_lede != blank -%}<p class="td-pg-lede">{{ ss.cta_lede }}</p>{%- endif -%}
        {%- if ss.cta_meta != blank -%}<p class="td-pg-cta__meta">{% render 'td-pg-icon', name: 'map-pin', size: 14 %}{{ ss.cta_meta }}</p>{%- endif -%}
      </div>
      <div class="td-pg-btns">
        {%- if ss.cta1_label != blank -%}
          <a class="td-pg-btn td-pg-btn--primary" href="{{ ss.cta1_link | default: routes.all_products_collection_url }}">{{ ss.cta1_label }}{% render 'td-pg-icon', name: 'arrow-right', size: 18 %}</a>
        {%- endif -%}
        {%- if ss.cta2_label != blank -%}
          <a class="td-pg-btn td-pg-btn--ghost" href="{{ ss.cta2_link | default: '/pages/install' }}">{% render 'td-pg-icon', name: 'store', size: 18 %}{{ ss.cta2_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </section>
</div>

<style>
  /* ---- Shipping page only ---- */
  .td-pg-ship__model { display: grid; gap: 2rem; }
  .td-pg-ship__model-text { max-width: 42rem; }
  .td-pg-ship__choice-top { display: flex; align-items: flex-start; justify-content: space-between; gap: .75rem; }
  .td-pg-ship__points { flex: 1; align-content: start; }
  .td-pg-ship__points li { color: #070E1A; }
  .td-pg-ship__choice-cta { align-self: flex-start; margin-top: 1.75rem; }
  .td-pg-ship__cov { display: grid; gap: 2rem; }
  .td-pg-ship__cov-body { color: rgba(255,255,255,.62) !important; }
  .td-pg-ship__cov-btns { margin-top: 1.75rem; }
  .td-pg-ship__costs-list { display: grid; gap: .75rem; margin-top: 1.5rem; }
  .td-pg-ship__costs-list li { display: flex; align-items: flex-start; gap: .75rem; padding-top: .75rem; border-top: 1px solid #22344C;
    font-size: .875rem; line-height: 1.625; color: rgba(255,255,255,.82); }
  .td-pg-ship__costs-list .td-pg-icon { margin-top: .1875rem; color: #00B4FC; }
  .td-pg-ship__nums { display: grid; gap: .625rem; margin-top: 1.25rem; font-size: .875rem; line-height: 1.625; color: #070E1A; }
  .td-pg-ship__nums li { display: flex; gap: .75rem; }
  .td-pg-ship__n { font-family: var(--font-heading--family, inherit); font-weight: 500; color: #0068E8; }
  .td-pg-ship .td-pg-grid--3-lg .td-pg-card:first-child .td-pg-icon--lead { color: #8A4F00; }
  @media (min-width: 640px) {
    .td-pg-ship__features { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .td-pg-ship__features li:nth-child(3) { grid-column: span 2; }
  }
  @media (min-width: 768px) { .td-pg-ship__costs { padding: 2rem; } }
  @media (min-width: 1024px) {
    .td-pg-ship__model { grid-template-columns: 1.3fr 1fr; gap: 3rem; }
    .td-pg-ship__features { grid-template-columns: 1fr; }
    .td-pg-ship__features li:nth-child(3) { grid-column: auto; }
    .td-pg-ship__cov { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 3rem; }
  }
</style>

{% schema %}
{
  "name": "TireDrop shipping page",
  "tag": "div",
  "class": "td-pg-section",
  "settings": [
    { "type": "text", "id": "phone", "label": "Phone number", "default": "(954) 773-1896", "info": "Written anywhere copy says [phone], and dialled by the call buttons." },
    { "type": "text", "id": "crumb", "label": "Breadcrumb label", "default": "How shipping works" },
    { "type": "header", "content": "Hero" },
    { "type": "text", "id": "hero_eyebrow", "label": "Eyebrow", "default": "Shipping" },
    { "type": "text", "id": "hero_heading", "label": "Heading", "default": "Ordered online. Shipped to your door." },
    { "type": "textarea", "id": "hero_lede", "label": "Lede", "default": "TireDrop is an online tire and wheel store, so your order ships free, direct from the distributor warehouse, to anywhere in the continental United States. No storefront markup, no waiting on one shop's back room to restock." },
    { "type": "text", "id": "hero_cta1_label", "label": "Primary button", "default": "Shop tires" },
    { "type": "url", "id": "hero_cta1_link", "label": "Primary link" },
    { "type": "text", "id": "hero_cta2_label", "label": "Secondary button", "default": "Ship to store instead" },
    { "type": "url", "id": "hero_cta2_link", "label": "Secondary link" },
    { "type": "textarea", "id": "hero_checks", "label": "Check marks (one per line)", "default": "Ships across the continental United States\nFree ship-to-store in South Florida\nPowered by Extreme Tires" },
    { "type": "header", "content": "The short version" },
    { "type": "text", "id": "model_eyebrow", "label": "Eyebrow", "default": "The short version" },
    { "type": "text", "id": "model_heading", "label": "Heading", "default": "Your tires never sit in our building" },
    { "type": "textarea", "id": "model_lede", "label": "Lede" },
    { "type": "textarea", "id": "model_body", "label": "Body" },
    { "type": "header", "content": "Delivery choices" },
    { "type": "text", "id": "choices_eyebrow", "label": "Eyebrow", "default": "At checkout" },
    { "type": "text", "id": "choices_heading", "label": "Heading", "default": "Two ways to take delivery" },
    { "type": "textarea", "id": "choices_lede", "label": "Lede", "default": "You pick one at checkout. Everything else about the order stays the same." },
    { "type": "header", "content": "Order flow" },
    { "type": "text", "id": "steps_eyebrow", "label": "Eyebrow", "default": "After you order" },
    { "type": "text", "id": "steps_heading", "label": "Heading", "default": "What happens next" },
    { "type": "textarea", "id": "steps_lede", "label": "Lede", "default": "Four stages, and you hear from us at each one. No silent stretches where you are left wondering whether the order went through." },
    { "type": "header", "content": "Coverage band" },
    { "type": "text", "id": "cov_eyebrow", "label": "Eyebrow", "default": "Coverage" },
    { "type": "text", "id": "cov_heading", "label": "Heading", "default": "Shipping is national. Installing is not." },
    { "type": "textarea", "id": "cov_lede", "label": "Lede" },
    { "type": "textarea", "id": "cov_body", "label": "Body" },
    { "type": "text", "id": "cov_cta_label", "label": "Button", "default": "Local? Ship to the store" },
    { "type": "url", "id": "cov_cta_link", "label": "Button link" },
    { "type": "text", "id": "costs_heading", "label": "Panel heading", "default": "Shipping cost and dates, straight" },
    { "type": "textarea", "id": "costs_body", "label": "Panel body" },
    { "type": "textarea", "id": "costs_list", "label": "Panel list (one per line)" },
    { "type": "header", "content": "If something goes wrong" },
    { "type": "text", "id": "wrong_eyebrow", "label": "Eyebrow", "default": "If something goes wrong" },
    { "type": "text", "id": "wrong_heading", "label": "Heading", "default": "Damaged, wrong, or out of stock" },
    { "type": "textarea", "id": "wrong_lede", "label": "Lede" },
    { "type": "header", "content": "FAQ" },
    { "type": "text", "id": "faq_eyebrow", "label": "Eyebrow", "default": "Questions, answered" },
    { "type": "text", "id": "faq_heading", "label": "Heading", "default": "Shipping FAQ" },
    { "type": "textarea", "id": "faq_lede", "label": "Lede" },
    { "type": "header", "content": "Closing band" },
    { "type": "text", "id": "cta_eyebrow", "label": "Eyebrow", "default": "Tires shipped. Or installed." },
    { "type": "text", "id": "cta_heading", "label": "Heading", "default": "Find your size, pick your delivery" },
    { "type": "textarea", "id": "cta_lede", "label": "Lede" },
    { "type": "text", "id": "cta_meta", "label": "Address line", "default": "7712 West Oakland Park Blvd, Sunrise, FL 33351 · Powered by Extreme Tires" },
    { "type": "text", "id": "cta1_label", "label": "Primary button", "default": "Shop tires" },
    { "type": "url", "id": "cta1_link", "label": "Primary link" },
    { "type": "text", "id": "cta2_label", "label": "Secondary button", "default": "Ship to store" },
    { "type": "url", "id": "cta2_link", "label": "Secondary link" }
  ],
