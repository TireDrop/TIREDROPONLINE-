  .td-pdp__qty { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem; }
  .td-pdp__preset {
    display: inline-flex; align-items: center; min-height: 44px; min-width: 44px; justify-content: center; padding: 0 .75rem;
    border-radius: 6px; border: 1px solid rgba(7,14,26,.15); background: #FFFFFF; color: var(--td-ink);
    font-family: var(--td-display); font-size: 1rem; font-weight: 700; cursor: pointer;
  }
  .td-pdp__preset:hover { border-color: var(--td-ink); }
  .td-pdp__preset[aria-pressed="true"] { border-color: var(--td-drop); background: var(--td-drop); color: #FFFFFF; }
  .td-pdp__presetset { margin-left: .375rem; font-size: 11px; letter-spacing: normal; }
  .td-pdp__stepper { display: inline-flex; align-items: center; border: 1px solid rgba(7,14,26,.15); border-radius: 6px; background: #FFFFFF; }
  .td-pdp__step { display: flex; align-items: center; justify-content: center; min-width: 44px; min-height: 44px; border: 0; background: transparent; color: var(--td-ink); cursor: pointer; }
