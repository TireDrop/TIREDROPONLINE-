  .td-pdp__qtyinput { width: 3.5rem; min-height: 44px; border: 0; border-left: 1px solid rgba(7,14,26,.15); border-right: 1px solid rgba(7,14,26,.15); text-align: center; font-family: var(--td-display); font-size: 1.125rem; color: var(--td-ink); background: #FFFFFF; -moz-appearance: textfield; }
  .td-pdp__qtyinput::-webkit-inner-spin-button, .td-pdp__qtyinput::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }
  .td-pdp__hint { margin-top: .5rem !important; font-size: 12px; color: var(--td-smoke); }
  .td-pdp__options { display: grid; gap: .75rem; }
  .td-pdp__option { border: 1px solid rgba(7,14,26,.15); border-radius: 6px; background: #FFFFFF; padding: 1rem; }
  .td-pdp__option:first-child { border-color: var(--td-drop); background: rgba(0,104,232,.05); }
  .td-pdp__optitle { font-family: var(--td-display); font-size: 1rem; font-weight: 700; }
  .td-pdp__optline { margin-top: .25rem !important; display: flex; align-items: flex-start; gap: .5rem; font-size: 14px; font-weight: 500; }
  .td-pdp__optline svg { flex-shrink: 0; margin-top: 2px; color: var(--td-drop); }
  .td-pdp__optcopy { margin-top: .25rem !important; font-size: 14px; color: var(--td-smoke); }
  .td-pdp__bill { margin: 1.5rem 0 0; font-size: 14px; }
  .td-pdp__bill > div { display: flex; justify-content: space-between; gap: 1rem; margin-top: .375rem; }
  .td-pdp__bill > div[hidden] { display: none; }
  .td-pdp__bill dt { color: var(--td-smoke); }
  .td-pdp__bill dd { margin: 0; font-weight: 500; }
  .td-pdp__strike { color: var(--td-smoke); text-decoration: line-through; }
  .td-pdp__billtotal { border-top: 1px solid rgba(7,14,26,.1); padding-top: .5rem; margin-top: .5rem !important; font-family: var(--td-display); font-size: 1.125rem; font-weight: 700; }
  .td-pdp__billtotal dt { color: var(--td-ink); }
  .td-pdp__billtotal dd { font-weight: 700; }
  .td-pdp__add { margin-top: 1.25rem; min-height: 48px; }
  .td-pdp__unavail { margin-top: .75rem !important; font-size: 14px; color: var(--td-smoke); }
  .td-pdp__unavail a { color: var(--td-ink); }
  .td-pdp__trust { margin-top: 1.25rem; display: flex; flex-wrap: wrap; gap: .5rem 1.5rem; font-size: 12px; color: var(--td-smoke); }
  .td-pdp__trust span { display: inline-flex; align-items: center; gap: .375rem; }
  .td-pdp__trust svg { color: var(--td-drop); }

  .td-pdp__band { background: radial-gradient(120% 90% at 50% -10%, #17293F 0%, #0A1526 45%, #070E1A 100%); color: #FFFFFF; }
  .td-pdp__bandin { display: flex; flex-direction: column; gap: 1.25rem; padding-top: 2.5rem; padding-bottom: 2.5rem; }
  .td-pdp__bandtext { display: flex; align-items: flex-start; gap: 1rem; }
  .td-pdp__bandicon { flex-shrink: 0; margin-top: .25rem; color: var(--td-amber); }
  .td-pdp__bandeyebrow { color: var(--td-volt); margin-bottom: .25rem !important; }
  .td-pdp__bandtitle { color: #FFFFFF; font-size: 1.875rem; text-wrap: wrap; }
  .td-pdp__bandcopy { margin-top: .5rem !important; max-width: 36rem; font-size: 14px; color: rgba(255,255,255,.72); }
  .td-pdp__bandactions { display: flex; flex-wrap: wrap; gap: .75rem; flex-shrink: 0; }
  @media (min-width: 768px) {
    .td-pdp__bandin { flex-direction: row; align-items: center; justify-content: space-between; }
    .td-pdp__bandtitle { font-size: 2.25rem; }
  }

  .td-pdp__details { background: var(--td-fog); }
  .td-pdp__detailgrid { display: grid; gap: 2.5rem; }
  @media (min-width: 1024px) { .td-pdp__detailgrid { grid-template-columns: repeat(2, minmax(0,1fr)); } }
  .td-pdp__h2 { font-size: 1.875rem; }
  @media (min-width: 768px) { .td-pdp__h2 { font-size: 2.25rem; } }
  .td-pdp__tablewrap { margin-top: 1.25rem; overflow-x: auto; }
  .td-pdp__specs { width: 100%; border-collapse: collapse; font-size: 14px; }
  .td-pdp__specs tr { border-top: 1px solid rgba(7,14,26,.1); border-bottom: 1px solid rgba(7,14,26,.1); }
  .td-pdp__specs th { padding: .75rem 1rem .75rem 0; text-align: left; vertical-align: top; font-weight: 400; color: var(--td-smoke); }
  .td-pdp__specs td { padding: .75rem 0; text-align: right; vertical-align: top; font-weight: 500; }
  .td-pdp__desc { margin-top: 1.25rem; font-size: 14px; line-height: 1.625; }
  .td-pdp__desc > * + * { margin-top: .75rem; }
  .td-pdp__desc ul { padding-left: 1.25rem; }
  .td-pdp__questions { margin-top: 1.5rem; padding: 1.25rem; }
  .td-pdp__questions p { margin-top: .25rem !important; font-size: 14px; }
  .td-pdp__questions .td-shop-btn { margin-top: 1rem; }

  .td-pdp__related { background: #FFFFFF; }
  .td-pdp__relhead { margin-bottom: 2rem; }
  .td-pdp__relhead .td-shop-btn { margin-top: 1.5rem; }
  .td-pdp__releyebrow { display: flex; align-items: center; gap: .625rem; margin-bottom: .625rem !important; }
  .td-pdp__releyebrow::before { content: ""; width: 1.5rem; height: 1px; background: rgba(0,104,232,.45); }
  .td-pdp__relgrid { list-style: none; margin: 0; padding: 0; }
  @media (min-width: 768px) {
    .td-pdp__relhead { display: flex; align-items: flex-end; justify-content: space-between; gap: 2rem; margin-bottom: 3rem; }
    .td-pdp__relhead .td-shop-btn { margin-top: 0; }
  }

  .td-pdp__sticky { position: fixed; left: 0; right: 0; bottom: 0; z-index: 30; border-top: 1px solid rgba(7,14,26,.1); background: rgba(255,255,255,.95); backdrop-filter: blur(8px); padding-bottom: env(safe-area-inset-bottom); }
  .td-pdp__sticky[hidden] { display: none; }
  .td-pdp__stickyin { display: flex; align-items: center; gap: .75rem; padding: .625rem 1rem; }
  .td-pdp__stickyprice { min-width: 0; }
  .td-pdp__stickytotal { font-family: var(--td-display); font-size: 1.25rem; line-height: 1; }
  .td-pdp__stickymeta { margin-top: .25rem !important; font-size: 11px; color: var(--td-smoke); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .td-pdp__stickybtn { margin-left: auto; flex-shrink: 0; }
  @media (min-width: 1024px) { .td-pdp__sticky { display: none !important; } }
</style>

<script>
  (function () {
    var root = document.getElementById("td-pdp-{{ sid }}");
    if (!root) return;
    var SET = Number(root.dataset.set) || 1, UNIT = root.dataset.unit, UNITS = root.dataset.units;
    var MAX = {{ ss.max_qty | default: 12 }};
    var fmt = function (c) { return "$" + (c / 100).toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 }); };
    var $ = function (s) { return root.querySelector(s); };
    var qtyInput = $("[data-td-qty]");
    var variantSel = $("[data-td-variant]");
    var state = { price: {{ price | default: 0 }}, compare: {{ compare | default: 0 }}, available: {{ variant.available | default: false }} };

    function plural(n) { return n === 1 ? UNIT : UNITS; }
    function paint() {
      var q = Math.min(MAX, Math.max(1, parseInt(qtyInput.value, 10) || 1));
      var total = state.price * q, saving = state.compare > state.price ? state.compare - state.price : 0;
      var set = function (sel, txt) { var el = $(sel); if (el) el.textContent = txt; };
      set("[data-td-total]", fmt(total));
      set("[data-td-for]", "for " + q + " " + plural(q));
      set("[data-td-each]", fmt(state.price));
      set("[data-td-compare]", fmt(state.compare));
      set("[data-td-save-each]", fmt(saving));
      set("[data-td-qtytext]", q + " " + plural(q));
      set("[data-td-listtotal]", fmt(state.compare * q));
      set("[data-td-yourprice]", fmt(total));
      set("[data-td-saving]", "− " + fmt(saving * q));
      set("[data-td-estimate]", fmt(total));
      set("[data-td-sticky-total]", fmt(total));
      set("[data-td-sticky-meta]", q + " " + plural(q) + " · " + fmt(state.price) + " each");
      ["[data-td-saveline]", "[data-td-listrow]", "[data-td-saverow]"].forEach(function (s) { var el = $(s); if (el) el.hidden = saving === 0; });
      root.querySelectorAll("[data-td-preset]").forEach(function (b) { b.setAttribute("aria-pressed", Number(b.dataset.tdPreset) === q ? "true" : "false"); });
      var hint = $("[data-td-qtyhint]");
      if (hint) hint.textContent = q === SET + 1 ? "A set of four plus a full-size spare." : "Most customers buy a full set of four.";
      root.querySelectorAll("[data-td-step]").forEach(function (b) {
        var d = Number(b.dataset.tdStep); b.disabled = d < 0 ? q <= 1 : q >= MAX;
      });
      var add = $("[data-td-add]");
      add.disabled = !state.available;
      set("[data-td-addlabel]", state.available ? "Add to Cart" : "Not available");
      $("[data-td-unavail]").hidden = state.available;
      set("[data-td-stock]", state.available ? {{ ss.available_text | json }} : {{ ss.unavailable_text | json }});
    }
    root.querySelectorAll("[data-td-preset]").forEach(function (b) {
      b.addEventListener("click", function () { qtyInput.value = b.dataset.tdPreset; paint(); });
    });
    root.querySelectorAll("[data-td-step]").forEach(function (b) {
      b.addEventListener("click", function () { qtyInput.value = Math.min(MAX, Math.max(1, (parseInt(qtyInput.value, 10) || 1) + Number(b.dataset.tdStep))); paint(); });
    });
    qtyInput.addEventListener("change", function () { qtyInput.value = Math.min(MAX, Math.max(1, parseInt(qtyInput.value, 10) || 1)); paint(); });
    if (variantSel) variantSel.addEventListener("change", function () {
      var o = variantSel.options[variantSel.selectedIndex];
      state = { price: Number(o.dataset.price), compare: Number(o.dataset.compare) || 0, available: o.dataset.available === "true" };
      var url = new URL(location.href); url.searchParams.set("variant", o.value); history.replaceState(null, "", url);
      paint();
    });
    paint();

    // Gallery thumbnails swap the main image.
    var stage = $("[data-td-stage]");
    root.querySelectorAll("[data-td-thumb]").forEach(function (t) {
      t.addEventListener("click", function () {
        if (!stage) return;
        stage.src = t.dataset.src; stage.srcset = t.dataset.srcset; stage.alt = t.dataset.alt;
        root.querySelectorAll("[data-td-thumb]").forEach(function (o) { o.setAttribute("aria-pressed", o === t ? "true" : "false"); });
      });
    });

    // Phone buy bar, once the real buy box has scrolled away.
    var sticky = $("[data-td-sticky]"), box = $("[data-td-buybox]");
    if (sticky && box && "IntersectionObserver" in window) {
      new IntersectionObserver(function (e) {
        sticky.hidden = e[0].isIntersecting || !state.available;
      }).observe(box);
    }
  })();
</script>

{% schema %}
{
  "name": "TireDrop product",
  "tag": "section",
  "class": "td-section-product",
  "settings": [
    { "type": "text", "id": "available_text", "label": "Available line", "default": "Available to order." },
    { "type": "text", "id": "unavailable_text", "label": "Not available line", "default": "Not available to ship right now — call us and we will try to source it." },
    { "type": "range", "id": "max_qty", "label": "Maximum quantity per add", "min": 4, "max": 24, "step": 1, "default": 12 },
    { "type": "header", "content": "Delivery explainer" },
    { "type": "text", "id": "ship_title", "label": "Option 1 title", "default": "Ship it to me" },
    { "type": "text", "id": "ship_line", "label": "Option 1 line", "default": "Ships free, no minimum" },
    { "type": "textarea", "id": "ship_copy", "label": "Option 1 text", "default": "Delivered to your address anywhere in the continental United States." },
    { "type": "text", "id": "store_title", "label": "Option 2 title", "default": "Ship to the shop and we'll fit them" },
    { "type": "text", "id": "store_line", "label": "Option 2 line", "default": "Free to Extreme Tires — Sunrise, fitted there" },
    { "type": "textarea", "id": "store_copy", "label": "Option 2 text", "default": "Mounting, balancing, new valve stems and disposal of your old tires. South Florida only — Sunrise, Plantation, Fort Lauderdale, Davie and nearby." },
    { "type": "text", "id": "delivery_note", "label": "Delivery note", "default": "You choose between these in your cart." },
    { "type": "header", "content": "South Florida band" },
    { "type": "text", "id": "band_eyebrow", "label": "Eyebrow", "default": "South Florida" },
    { "type": "text", "id": "band_title", "label": "Heading", "default": "Ship it free to the shop" },
    { "type": "textarea", "id": "band_copy", "label": "Text", "default": "Local buyers can send the order to Extreme Tires — Sunrise at no charge and book an install. We fit them and dispose of the old ones — or send the van out to you instead." },
    { "type": "text", "id": "band_label", "label": "Button", "default": "How install works" },
    { "type": "url", "id": "band_link", "label": "Button link" },
    { "type": "text", "id": "phone", "label": "Phone", "default": "(954) 773-1896" },
    { "type": "header", "content": "Details" },
    { "type": "text", "id": "about_title", "label": "Description heading", "default": "Why this one" },
    { "type": "textarea", "id": "questions_copy", "label": "Questions card text", "default": "Call (954) 773-1896 during shop hours, send a note through the contact form, or stop by 7712 West Oakland Park Blvd, Sunrise, FL 33351." },
    { "type": "url", "id": "contact_link", "label": "Contact page" },
    { "type": "checkbox", "id": "show_related", "label": "Show more from the same collection", "default": true }
  ]
}
{% endschema %}
