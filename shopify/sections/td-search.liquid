{% comment %}
  Search results. The React site has no results page of its own, so this
  borrows its pieces: the dark PageHero, a search card styled like the React
  SearchPanel, ProductCard for product hits, and EmptyState when nothing
  matches. Pages and articles that match are listed after the products.
{% endcomment %}
{%- liquid
  assign ss = section.settings
  assign phone = ss.phone | default: '(954) 773-1896'
  assign phone_href = phone | remove: '(' | remove: ')' | remove: ' ' | remove: '-' | prepend: 'tel:+1'
  assign finder_url = ss.finder_link | default: '/pages/find-my-tires'
  assign sid = section.id
  assign sort_by = search.sort_by | default: search.default_sort_by
-%}

<div class="td-shop td-search" id="td-search-{{ sid }}">
  {%- render 'td-collection-base' -%}

  <header class="td-shop-hero">
    <div class="td-shop-wrap td-shop-hero__inner td-search__heroin">
      <p class="td-shop-eyebrow">{{ ss.eyebrow }}</p>
      <h1 class="td-shop-h1">
        {%- if search.performed and search.terms != blank -%}
          Results for “{{ search.terms | escape }}”
        {%- else -%}
          {{ ss.heading }}
        {%- endif -%}
      </h1>
    </div>
  </header>

  <nav class="td-shop-crumbs" aria-label="Breadcrumb">
    <ol class="td-shop-wrap">
      <li><a href="{{ routes.root_url }}">Home</a></li>
      <li><span aria-current="page">Search</span></li>
    </ol>
  </nav>

  <div class="td-shop-wrap td-search__cardwrap">
    <form class="td-search__card" action="{{ routes.search_url }}" method="get" role="search">
      <div class="td-search__tab" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        Search the store
      </div>
      <div class="td-search__body">
        <label class="td-shop-label" for="td-search-q-{{ sid }}">Size, brand or model</label>
        <div class="td-search__row">
          <input class="td-shop-field" id="td-search-q-{{ sid }}" type="search" name="q" value="{{ search.terms | escape }}" placeholder="e.g. 225/50R17 or Michelin" autocomplete="off">
          <input type="hidden" name="options[prefix]" value="last">
          <button type="submit" class="td-shop-btn td-shop-btn--primary td-search__submit">
            <svg aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            Search
          </button>
        </div>
        <p class="td-search__note">Your size is printed on the sidewall, e.g. 225/50R17. Not sure of it? <a href="{{ finder_url }}">Look it up with Find My Tires</a>.</p>
      </div>
    </form>
  </div>

  <section class="td-shop-section td-search__main">
    <div class="td-shop-wrap">
      {%- if search.performed -%}
        {%- paginate search.results by ss.per_page -%}
          {%- liquid
            assign product_hits = 0
            assign other_hits = 0
            for item in search.results
              if item.object_type == 'product'
                assign product_hits = product_hits | plus: 1
              else
                assign other_hits = other_hits | plus: 1
              endif
            endfor
          -%}
          {%- if search.results_count == 0 -%}
            <div class="td-shop-card td-shop-empty">
              <span class="td-shop-empty__icon" aria-hidden="true">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m13.5 8.5-5 5M8.5 8.5l5 5"/><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
              </span>
              <h2 class="td-shop-empty__title">Nothing matches “{{ search.terms | escape }}”</h2>
              <p class="td-shop-empty__lede">{{ ss.empty_lede }}</p>
              <div class="td-shop-empty__actions">
                <a href="{{ phone_href }}" class="td-shop-btn td-shop-btn--primary td-shop-btn--sm">Call {{ phone }}</a>
                <a href="{{ finder_url }}" class="td-shop-btn td-shop-btn--outline td-shop-btn--sm">Find My Tires</a>
              </div>
            </div>
          {%- else -%}
            <div class="td-search__meta">
              <p class="td-shop-smoke td-search__count" aria-live="polite">
                <span>{{ search.results_count }} {% if search.results_count == 1 %}result{% else %}results{% endif %}</span>
                for “{{ search.terms | escape }}”
              </p>
              {%- if product_hits > 0 and search.sort_options.size > 0 -%}
                <div class="td-search__sort">
                  <span class="td-shop-label" aria-hidden="true">Sort by</span>
                  {%- render 'td-collection-sort', results: search, sort_by: sort_by, id: 'td-search-sort', action: routes.search_url, extra_class: '' -%}
                </div>
              {%- endif -%}
            </div>

            {%- if product_hits > 0 -%}
              <h2 class="td-sr">Products</h2>
              <ul class="td-shop-grid td-shop-grid--4 td-search__grid" role="list">
                {%- for item in search.results -%}
                  {%- if item.object_type == 'product' -%}
                    <li>{%- render 'td-product-card', product: item, heading_level: 3 -%}</li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            {%- endif -%}

            {%- if other_hits > 0 -%}
              <h2 class="td-shop-h3 td-search__pagesh">Pages and guides</h2>
              <ul class="td-search__pages" role="list">
                {%- for item in search.results -%}
                  {%- unless item.object_type == 'product' -%}
                    <li>
                      <a class="td-shop-card td-search__page" href="{{ item.url }}">
                        <span class="td-search__pagetitle">{{ item.title | escape }}</span>
                        <span class="td-search__pagecopy">{{ item.content | strip_html | truncatewords: 26 }}</span>
                      </a>
                    </li>
                  {%- endunless -%}
                {%- endfor -%}
              </ul>
            {%- endif -%}

            {%- if paginate.pages > 1 -%}
              <nav class="td-search__pagesnav" aria-label="Pagination">
                {%- if paginate.previous -%}<a class="td-search__pn" href="{{ paginate.previous.url }}" aria-label="Previous page">&larr;</a>{%- endif -%}
                {%- for part in paginate.parts -%}
                  {%- if part.is_link -%}
                    <a class="td-search__pn tnum" href="{{ part.url }}">{{ part.title }}</a>
                  {%- elsif part.title == paginate.current_page -%}
                    <span class="td-search__pn is-current tnum" aria-current="page">{{ part.title }}</span>
                  {%- else -%}
                    <span class="td-search__pn is-gap">{{ part.title }}</span>
                  {%- endif -%}
                {%- endfor -%}
                {%- if paginate.next -%}<a class="td-search__pn" href="{{ paginate.next.url }}" aria-label="Next page">&rarr;</a>{%- endif -%}
              </nav>
            {%- endif -%}
          {%- endif -%}
        {%- endpaginate -%}
      {%- else -%}
        <ul class="td-search__quick" role="list">
          <li><a class="td-shop-card td-search__page" href="/collections/tires"><span class="td-search__pagetitle">Shop Tires</span><span class="td-search__pagecopy">Every tire we list online, with free shipping to the continental US.</span></a></li>
          <li><a class="td-shop-card td-search__page" href="/collections/wheels"><span class="td-search__pagetitle">Shop Wheels</span><span class="td-search__pagecopy">Wheels, fitment-checked before they ship.</span></a></li>
          <li><a class="td-shop-card td-search__page" href="{{ finder_url }}"><span class="td-search__pagetitle">Find My Tires</span><span class="td-search__pagecopy">Look up the tire size your vehicle takes.</span></a></li>
        </ul>
      {%- endif -%}
    </div>
  </section>
</div>

<style>
  .td-search__heroin { padding-bottom: 4.5rem; }
  .td-search__cardwrap { margin-top: 1.5rem; position: relative; z-index: 1; }
  @media (min-width: 768px) { .td-search__cardwrap { margin-top: -2rem; } }
  .td-search__card { margin: 0; overflow: hidden; border-radius: 12px; border: 1px solid rgba(7,14,26,.1); background: #FFFFFF; box-shadow: var(--td-shadow-lift); }
  .td-search__tab { display: flex; align-items: center; gap: .5rem; min-height: 48px; padding: .875rem 1.25rem; border-top: 3px solid var(--td-drop); font-family: var(--td-display); font-size: 15px; font-weight: 700; }
  .td-search__body { padding: 0 1.25rem 1.25rem; }
  .td-search__row { display: flex; flex-direction: column; gap: .75rem; }
  .td-search__submit { min-height: 48px; white-space: nowrap; }
  .td-search__note { margin-top: .75rem !important; font-size: 12px; line-height: 1.625; color: var(--td-smoke); }
  .td-search__note a { color: var(--td-ink); }
  @media (min-width: 640px) { .td-search__row { flex-direction: row; } .td-search__row .td-shop-field { flex: 1; } }
  @media (min-width: 768px) { .td-search__body { padding: 0 1.5rem 1.5rem; } .td-search__tab { padding-left: 1.5rem; } }

  .td-search__meta { display: flex; flex-direction: column; gap: .75rem; margin-bottom: 1rem; }
  @media (min-width: 640px) { .td-search__meta { flex-direction: row; align-items: center; justify-content: space-between; } }
  .td-search__count { font-size: 14px; }
  .td-search__count span { font-weight: 600; color: var(--td-ink); }
  .td-search__sort { display: flex; align-items: center; gap: .5rem; }
  .td-search__sort .td-shop-label { margin: 0; white-space: nowrap; }
  .td-search__sort .td-shop-field { width: auto; }
  .td-sortform { margin: 0; display: flex; align-items: center; gap: .5rem; }
  .td-search__grid, .td-search__pages, .td-search__quick { list-style: none; margin: 0; padding: 0; }
  .td-search__pagesh { margin-top: 2.5rem !important; margin-bottom: 1rem !important; }
  .td-search__pages, .td-search__quick { display: grid; gap: 1rem; }
  @media (min-width: 640px) { .td-search__pages, .td-search__quick { grid-template-columns: repeat(2, minmax(0,1fr)); } }
  @media (min-width: 1024px) { .td-search__pages, .td-search__quick { grid-template-columns: repeat(3, minmax(0,1fr)); } }
  .td-search__page { display: block; height: 100%; padding: 1.25rem; text-decoration: none; transition: transform .2s ease, box-shadow .2s ease; }
  .td-search__page:hover { transform: translateY(-2px); box-shadow: var(--td-shadow-lift); }
  .td-search__pagetitle { display: block; font-family: var(--td-display); font-size: 1.125rem; font-weight: 800; line-height: 1.2; }
  .td-search__page:hover .td-search__pagetitle { color: var(--td-drop); }
  .td-search__pagecopy { display: block; margin-top: .375rem; font-size: 14px; line-height: 1.6; color: var(--td-smoke); }
  .td-search__pagesnav { display: flex; flex-wrap: wrap; justify-content: center; gap: .5rem; margin-top: 2rem; }
  .td-search__pn { display: inline-flex; align-items: center; justify-content: center; min-width: 44px; min-height: 44px; padding: 0 .75rem; border-radius: 6px; border: 1px solid rgba(7,14,26,.15); background: #FFFFFF; font-family: var(--td-display); font-weight: 700; text-decoration: none; }
  .td-search__pn.is-current { background: var(--td-drop); border-color: var(--td-drop); color: #FFFFFF; }
  .td-search__pn.is-gap { border-color: transparent; background: transparent; }
</style>

<script>
  (function () {
    var root = document.getElementById("td-search-{{ sid }}");
    if (!root) return;
    root.querySelectorAll("[data-td-sort]").forEach(function (sel) {
      sel.addEventListener("change", function () {
        var url = new URL(location.href);
        url.searchParams.set("sort_by", sel.value);
        url.searchParams.delete("page");
        location.href = url.toString();
      });
    });
  })();
</script>

{% schema %}
{
  "name": "TireDrop search",
  "tag": "section",
  "class": "td-section-search",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Search" },
    { "type": "text", "id": "heading", "label": "Heading (before a search)", "default": "Search the store" },
    { "type": "textarea", "id": "empty_lede", "label": "No results text", "default": "Try a tire size like 225/50R17, a brand or a model. If you cannot find your size, call us — we can order sizes this site does not list." },
    { "type": "url", "id": "finder_link", "label": "Find My Tires page" },
    { "type": "text", "id": "phone", "label": "Phone", "default": "(954) 773-1896" },
    { "type": "range", "id": "per_page", "label": "Results per page", "min": 12, "max": 48, "step": 6, "default": 24 }
  ]
}
{% endschema %}
