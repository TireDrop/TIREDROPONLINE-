{% comment %}
  Not-found page, as the React NotFoundPage: a dark band with the big 404,
  then four helpful links and a "Still stuck?" card. The links are blocks so
  they can be edited in the theme editor.
{% endcomment %}
{%- liquid
  assign ss = section.settings
  assign phone = ss.phone | default: '(954) 773-1896'
  assign phone_href = phone | remove: '(' | remove: ')' | remove: ' ' | remove: '-' | prepend: 'tel:+1'
-%}

<div class="td-shop td-404">
  {%- render 'td-collection-base' -%}

  <section class="td-404__band">
    <div class="td-shop-wrap td-404__bandin">
      <p class="td-shop-eyebrow td-404__eyebrow">{{ ss.eyebrow }}</p>
      <p class="td-404__big" aria-hidden="true">404</p>
      <h1 class="td-shop-h1 td-404__title">{{ ss.heading }}</h1>
      <p class="td-shop-lede td-404__lede">{{ ss.lede }}</p>
      <div class="td-404__actions">
        <a href="{{ routes.root_url }}" class="td-shop-btn td-shop-btn--primary">Back to Home</a>
        <a href="{{ phone_href }}" class="td-shop-btn td-shop-btn--ghost">
          <svg aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          Call {{ phone }}
        </a>
      </div>
    </div>
  </section>

  <section class="td-shop-section td-404__links">
    <div class="td-shop-wrap">
      <h2 class="td-shop-h2 td-404__h2">{{ ss.links_heading }}</h2>
      <ul class="td-404__grid" role="list">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>
            <a class="td-shop-card td-404__card" href="{{ block.settings.link | default: '/' }}">
              {%- case block.settings.icon -%}
                {%- comment -%} TD-FIX: 'tire' had no case and fell through to a bare circle. It now draws the shopping-cart icon from td-home-icon. {%- endcomment -%}
                {%- when 'tire' -%}
                  <svg aria-hidden="true" focusable="false" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/></svg>
                {%- when 'wheel' -%}
                  <svg aria-hidden="true" focusable="false" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 12h.01M17 12a5 5 0 0 0-5-5M7 12a5 5 0 0 0 5 5"/></svg>
                {%- when 'truck' -%}
                  <svg aria-hidden="true" focusable="false" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.62l-3.48-4.35A1 1 0 0 0 17.52 8H14"/><circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/></svg>
                {%- when 'store' -%}
                  <svg aria-hidden="true" focusable="false" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m2 7 4.41-4.41A2 2 0 0 1 7.83 2h8.34a2 2 0 0 1 1.42.59L22 7"/><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><path d="M15 22v-4a2 2 0 0 0-2-2h-2a2 2 0 0 0-2 2v4"/><path d="M2 7h20"/></svg>
                {%- else -%}
                  <svg aria-hidden="true" focusable="false" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/></svg>
              {%- endcase -%}
              <h3 class="td-shop-h3">{{ block.settings.title }}</h3>
              <p>{{ block.settings.copy }}</p>
            </a>
          </li>
        {%- endfor -%}
      </ul>

      <div class="td-shop-card td-404__stuck">
        <div>
          <h3 class="td-shop-h3">Still stuck?</h3>
          <p>
            <a href="{{ routes.search_url }}">Search the store</a>, or send us a message through the
            <a href="{{ ss.contact_link | default: '/pages/contact' }}">contact form</a>.
          </p>
        </div>
        <a href="{{ phone_href }}" class="td-shop-btn td-shop-btn--dark td-shop-btn--sm">
          <svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          {{ phone }}
        </a>
      </div>
    </div>
  </section>
</div>

<style>
  .td-404__band { background: radial-gradient(120% 90% at 50% -10%, #17293F 0%, #0A1526 45%, #070E1A 100%); color: #FFFFFF; }
  .td-404__bandin { padding-top: 4rem; padding-bottom: 4rem; }
  @media (min-width: 768px) { .td-404__bandin { padding-top: 6rem; padding-bottom: 6rem; } }
  .td-404__eyebrow { color: var(--td-volt); margin-bottom: .75rem !important; }
  .td-404__big { font-family: var(--td-display); font-weight: 400; font-size: 5rem; line-height: .85; color: var(--td-volt); letter-spacing: -.02em; }
  @media (min-width: 640px) { .td-404__big { font-size: 8rem; } }
  @media (min-width: 768px) { .td-404__big { font-size: 11rem; } }
  .td-404__title { margin-top: 1rem !important; max-width: 48rem; color: #FFFFFF; }
  .td-404__lede { margin-top: 1.25rem !important; max-width: 36rem; color: rgba(255,255,255,.72); }
  .td-404__actions { margin-top: 2rem; display: flex; flex-wrap: wrap; gap: .75rem; }
  .td-404__links { background: #FFFFFF; }
  .td-404__h2 { margin-bottom: 2rem !important; }
  .td-404__grid { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.25rem; }
  @media (min-width: 640px) { .td-404__grid { grid-template-columns: repeat(2, minmax(0,1fr)); } }
  @media (min-width: 1024px) { .td-404__grid { grid-template-columns: repeat(4, minmax(0,1fr)); } }
  .td-404__card { display: block; height: 100%; padding: 1.5rem; text-decoration: none; transition: transform .2s ease, box-shadow .2s ease; }
  .td-404__card:hover { transform: translateY(-2px); box-shadow: var(--td-shadow-lift); }
  .td-404__card svg { display: block; margin-bottom: 1rem; color: var(--td-drop); }
  .td-404__card p { margin-top: .5rem !important; font-size: 14px; line-height: 1.625; color: var(--td-smoke); }
  .td-404__stuck { margin-top: 2rem; padding: 1.5rem; border-left: 4px solid var(--td-amber); display: flex; flex-direction: column; gap: 1rem; }
  .td-404__stuck p { margin-top: .5rem !important; max-width: 36rem; font-size: 14px; line-height: 1.625; color: var(--td-smoke); }
  .td-404__stuck p a { text-decoration: underline; }
  .td-404__stuck p a:hover { color: var(--td-drop); }
  .td-404__stuck .td-shop-btn { flex-shrink: 0; }
  @media (min-width: 640px) { .td-404__stuck { flex-direction: row; align-items: center; justify-content: space-between; } }
</style>

{% schema %}
{
  "name": "TireDrop 404",
  "tag": "section",
  "class": "td-section-404",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Error 404" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "This one is flat. The rest of the site is fine." },
    { "type": "textarea", "id": "lede", "label": "Text", "default": "The page you were looking for moved, got renamed, or never existed. Nothing you did wrong. Here is where most people were headed anyway — or call us and we will point you straight at it." },
    { "type": "text", "id": "links_heading", "label": "Links heading", "default": "Try one of these" },
    { "type": "url", "id": "contact_link", "label": "Contact page" },
    { "type": "text", "id": "phone", "label": "Phone", "default": "(954) 773-1896" }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Helpful link",
      "limit": 8,
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [
          { "value": "tire", "label": "Tire" }, { "value": "wheel", "label": "Wheel" },
          { "value": "truck", "label": "Truck" }, { "value": "store", "label": "Shop" }
        ], "default": "tire" },
        { "type": "text", "id": "title", "label": "Title", "default": "Shop Tires" },
        { "type": "textarea", "id": "copy", "label": "Text" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "TireDrop 404" }]
}
{% endschema %}
