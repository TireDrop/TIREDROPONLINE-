  }
  .td-ts-aside__note svg { flex: none; margin-top: .2rem; color: #0068E8; }

  /* ---- cards ---- */
  .td-ts-card { min-width: 0; background: #FFFFFF; border: 1px solid #E3E8EF; border-radius: 12px; padding: 1.25rem; }
  .td-ts-grid2, .td-ts-grid3 { display: grid; gap: 1rem; }
