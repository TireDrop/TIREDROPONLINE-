  .td-ts a { color: #0068E8; text-underline-offset: 2px; }
  .td-ts a:hover { color: #0053C4; }
  .td-ts :focus-visible { outline: 3px solid #0068E8; outline-offset: 2px; }

  /* ---- step one ---- */
  .td-ts-tool { display: grid; gap: 2rem; }
  .td-ts-tool__main { min-width: 0; }
  .td-ts-form { margin-top: 1.5rem; }
