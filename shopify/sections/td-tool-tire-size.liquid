    display: block; width: 100%; height: 48px; min-height: 48px; margin: 0;
    padding: 0 .875rem; border: 1px solid #7A8494; border-radius: 10px;
    background: #FFFFFF; color: #070E1A;
    font-family: var(--font-heading--family, inherit); font-weight: 700;
    font-size: 16px; letter-spacing: -.005em; font-variant-numeric: tabular-nums;
