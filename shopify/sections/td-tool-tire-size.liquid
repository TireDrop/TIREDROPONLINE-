    display: flex; gap: .5rem; align-items: flex-start;
    margin: 1rem 0 0; padding: 1.25rem; border-radius: 12px;
    background: #FFFFFF; border: 1px solid #E3E8EF;
    font-size: .9375rem; line-height: 1.6; color: #586274;
  }
  .td-ts-note svg { flex: none; margin-top: .2rem; color: #0068E8; }
