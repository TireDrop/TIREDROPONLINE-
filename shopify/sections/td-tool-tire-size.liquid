    function renderCompare(cmp, loadFrom, loadTo) {
      var h = [];
      h.push(head("Side by side", cmp.from.normalized + " against " + cmp.to.normalized,
        "Both tires below are drawn at the same scale, sitting on the same ground. The difference you can see is the difference you would get.", UID + "-cmp"));
      h.push('<div class="td-ts-cmp"><div class="td-ts-panel">' + overlapSvg(cmp.from, cmp.to));
      h.push('<ul class="td-ts-legend">' +
        '<li><span class="td-ts-legend__key td-ts-legend__key--from" aria-hidden="true"></span><strong>' + esc(cmp.from.normalized) + '</strong><span class="td-ts-legend__tall">' + inches(cmp.from.overallDiameter) + " tall</span></li>" +
        '<li><span class="td-ts-legend__key td-ts-legend__key--to" aria-hidden="true"></span><strong>' + esc(cmp.to.normalized) + '</strong><span class="td-ts-legend__tall">' + inches(cmp.to.overallDiameter) + " tall</span></li></ul>");
      h.push('<p class="td-ts-caption">Circles are the tires and their wheels. The bars underneath are the tread widths at the same scale.</p></div>');

      h.push('<div class="td-ts-cmp__side"><div class="td-ts-card"><p class="td-ts-card__eyebrow">What changes</p>');
      h.push(delta("Overall diameter", signed(cmp.diameterChange, 2) + "%", signed(cmp.diameterChangeIn, 2) + " in", "diameter"));
      h.push(delta("Ground clearance", signed(cmp.clearanceChangeIn, 2) + " in", "Half the diameter change — the axle moves by the change in radius", "clearance"));
      h.push(delta("Section width", signed(cmp.widthChangeMm, 0) + " mm", signed(cmp.widthChangeMm / 25.4, 2) + " in across", "width"));
      h.push(delta("Sidewall height", signed(cmp.sidewallChangeIn, 2) + " in", signed(cmp.sidewallChangeIn * 25.4, 0) + " mm of sidewall", "sidewall"));
      h.push(delta("Revolutions per mile", signed(cmp.revsChange, 2) + "%", commas(cmp.from.revsPerMile) + " → " + commas(cmp.to.revsPerMile) + ", unloaded", "revs"));
      h.push("</div>");

      h.push('<div class="td-ts-card" data-ts-speedo><p class="td-ts-card__eyebrow">' + GAUGE_ICON + "Your speedometer</p>");
      h.push('<p class="td-ts-speedo__lead">At an indicated <b>60</b> you would really be doing <b class="td-ts-drop" data-speedo-lead>' + cmp.actualAt(60).toFixed(1) + "</b> mph.</p>");
      h.push('<div class="td-ts-speedo__grid">');
      [30, 60, 75].forEach(function (mph) {
        h.push('<div class="td-ts-speedo__cell"><p class="td-ts-speedo__reads">Reads ' + mph + '</p><p class="td-ts-speedo__num" data-speedo="' + mph + '">' + cmp.actualAt(mph).toFixed(1) +
          '</p><p class="td-ts-speedo__unit">actual mph</p></div>');
      });
      h.push('</div><p class="td-ts-fine">Calculated from nominal diameters. A loaded tire sits slightly shorter than its free diameter, so the real error is usually a shade smaller than this.</p></div></div></div>');

      // Verdict
      var ok = cmp.withinTolerance;
      h.push('<div class="td-ts-verdict' + (ok ? "" : " td-ts-verdict--out") + '" data-verdict="' + (ok ? "inside" : "outside") + '"><div class="td-ts-badges">');
      h.push(ok ? '<span class="td-ts-badge td-ts-badge--drop">Inside ±' + cmp.tolerance + "%</span>" : '<span class="td-ts-badge td-ts-badge--amber">Outside ±' + cmp.tolerance + "%</span>");
      if (!cmp.sameRim) h.push('<span class="td-ts-badge ' + (ok ? "td-ts-badge--soft" : "td-ts-badge--ink") + '">Different wheel size</span>');
      h.push("</div>");
      h.push('<h3 class="td-ts-h3">' + (ok
        ? "Diameter moves " + signed(cmp.diameterChange, 1) + "% — inside the ±3% most fitment guides work to."
        : "Diameter moves " + signed(cmp.diameterChange, 1) + "% — past the " + cmp.tolerance + "% most fitment guides stop at.") + "</h3>");
      h.push('<div class="td-ts-verdict__body">');
      if (ok) {
        h.push("<p>Your speedometer would read about <b>" + Math.abs(cmp.speedoErrorAt60).toFixed(1) + " mph</b> " + (cmp.speedoErrorAt60 >= 0 ? "low" : "high") +
          " at an indicated 60, and your odometer by the same proportion. Ground clearance changes by " + signed(cmp.clearanceChangeIn, 2) + " in.</p>");
      } else {
        h.push("<p>Your speedometer, odometer, ABS and traction control all work off wheel rotation, so all of them would now be reading " + Math.abs(cmp.diameterChange).toFixed(1) +
          "% out. At an indicated 60 you would be doing <b>" + cmp.actualAt(60).toFixed(1) + "</b>, and every mile logged would be off by the same margin.</p>");
      }
      if (!cmp.sameRim) {
        h.push("<p>These are different wheel diameters — <b>" + esc(cmp.from.rimDiameter) + " in</b> against <b>" + esc(cmp.to.rimDiameter) +
          " in</b>. This is a wheel change, not just a tire change: the new size will not mount on the wheels you have now.</p>");
      }
      if (loadFrom && loadTo && loadTo < loadFrom) {
        h.push("<p>The replacement also carries less: <b>" + commas(loadTo) + " lbs</b> per tire against <b>" + commas(loadFrom) + " lbs</b>. Do not go below the load index on your door placard.</p>");
      }
      h.push("<p>We are not going to tell you this swap is safe, because a size calculator cannot see your car. It does not know your wheel width, your offset, how much room is in the arches, or how far the suspension travels. Check clearance at full steering lock and over full suspension travel, and check the placard in your driver's door jamb and your owner's manual for the sizes and load ratings your car was built for.</p>");
      h.push("</div></div>");
      return h.join("");
    }

    function shopCard(g, role) {
      var href = "/search?q=" + encodeURIComponent(g.normalized) + "&type=product";
      return '<div class="td-ts-card">' + (role ? '<p class="td-ts-shop__role">' + esc(role) + "</p>" : "") +
        '<p class="td-ts-shop__size">' + esc(g.normalized) + "</p>" +
        '<a class="td-ts-btn td-ts-btn--primary" data-shop="' + esc(g.normalized) + '" href="' + esc(href) + '" aria-label="See tires in this size: ' + esc(g.normalized) + '">See tires in this size</a></div>';
    }

    function renderShop(geo, vsGeo) {
      var two = vsGeo && vsGeo.normalized !== geo.normalized;
      var h = [];
      h.push(head("Shop this size", two ? "Tires in these sizes" : "Tires in " + geo.normalized, null, UID + "-shop"));
      h.push('<div class="td-ts-shop' + (two ? " td-ts-shop--two" : "") + '">');
      h.push(shopCard(geo, two ? "On the car now" : null));
      if (two) h.push(shopCard(vsGeo, "The one you are considering"));
      h.push("</div>");
      h.push('<p class="td-ts-shop__call">Or call <a href="' + PHONE_HREF + '">' + PHONE + "</a> and we will help you find the size.</p>");
      return h.join("");
    }

    /* ------------------------------------------------------------------
     * State <-> URL, and the render loop
     * ------------------------------------------------------------------ */
    var bands = {};
    Array.prototype.forEach.call(root.querySelectorAll("[data-band]"), function (el) { bands[el.getAttribute("data-band")] = el; });
    function fill(name, html) {
      var band = bands[name];
      if (html == null) { band.hidden = true; band.querySelector("[data-fill]").innerHTML = ""; band.removeAttribute("aria-labelledby"); return; }
      band.querySelector("[data-fill]").innerHTML = html;
      band.hidden = false;
      var h2 = band.querySelector("h2[id]");
      if (h2) band.setAttribute("aria-labelledby", h2.id);
    }
    function stripe() {
      // Alternate white and fog down whatever bands are showing.
      var n = 0;
      ["input", "decoded", "figures", "compare", "shop", "how", "faq"].forEach(function (k) {
        var b = bands[k];
        if (!b || b.hidden) return;
        b.classList.toggle("td-ts-band--alt", n % 2 === 1);
        n++;
      });
    }

    function writeUrl() {
      var sp = new URLSearchParams(location.search);
      [["size", sizeEl.value], ["vs", vsEl.value]].forEach(function (kv) {
        if (kv[1]) sp.set(kv[0], kv[1]); else sp.delete(kv[0]);
      });
      var qs = sp.toString();
      try { history.replaceState(history.state, "", location.pathname + (qs ? "?" + qs : "") + location.hash); } catch (e) { /* sandboxed */ }
    }

    var errTimers = {};
    var lastRead = {};
    function setError(key, msg) {
      var el = errEls[key], input = inputs[key];
      var help = UID + "-" + key + "-help", errId = UID + "-" + key + "-err";
      if (msg) {
        var html = WARN_ICON + "<span>" + msg + "</span>";
        if (el.innerHTML !== html) el.innerHTML = html;
        el.hidden = false;
        input.setAttribute("aria-invalid", "true");
        input.setAttribute("aria-describedby", help + " " + errId);
      } else {
        el.hidden = true;
        el.innerHTML = "";
        input.removeAttribute("aria-invalid");
        input.setAttribute("aria-describedby", help);
      }
    }
    // Errors wait until typing pauses, so "225/" on its way to "225/45R17"
    // is not shouted at. Valid or empty clears at once.
    function scheduleErrors(immediate) {
      ["size", "vs"].forEach(function (key) {
        clearTimeout(errTimers[key]);
        var r = lastRead[key];
        if (!r || !r.error) { setError(key, null); return; }
        if (immediate) setError(key, r.error);
        else errTimers[key] = setTimeout(function () { setError(key, lastRead[key] && lastRead[key].error); }, 600);
      });
    }

    function render() {
      var sizeRaw = sizeEl.value, vsRaw = vsEl.value;
      var a = readSize(sizeRaw), b = readSize(vsRaw);
      lastRead = { size: a, vs: b };
      var geo = a.geo, vsGeo = b.geo;
      var cmp = geo && vsGeo ? TD.compareSizes(geo, vsGeo) : null;
      var typedSomething = sizeRaw.trim().length > 0;
      var loadFrom = geo && geo.loadIndex ? loadPounds(geo.loadIndex) : null;
      var loadTo = vsGeo && vsGeo.loadIndex ? loadPounds(vsGeo.loadIndex) : null;
      var serviceTyped = /^\s*(P|LT|ST)/i.test(sizeRaw) ? sizeRaw.trim().slice(0, 2).toUpperCase().replace(/[^A-Z]/g, "") : null;

      // One-line summary for the live region.
      var status;
      if (geo) {
        status = "<strong class=\"td-ts-tnum\">" + esc(geo.normalized) + "</strong> — <span class=\"td-ts-tnum\">" + inches(geo.overallDiameter) + "</span> overall diameter, <span class=\"td-ts-tnum\">" +
          inches(geo.sidewallIn) + "</span> of sidewall, <span class=\"td-ts-tnum\">" + commas(geo.revsPerMile) + "</span> revolutions per mile unloaded.";
        if (cmp) {
          status += " Against " + esc(cmp.to.normalized) + ": <span class=\"td-ts-tnum\">" + signed(cmp.diameterChange, 1) + "%</span> diameter, and <span class=\"td-ts-tnum\">" +
            cmp.actualAt(60).toFixed(1) + "</span> mph at an indicated 60.";
        }
      } else if (typedSomething) {
        status = "That is not a size we can read yet.";
      } else {
        status = "Type a size above and the decoded result appears here and in the sections below.";
      }
      if (statusEl.innerHTML !== status) statusEl.innerHTML = status;

      fill("decoded", geo ? renderDecoded(geo, decodeParts(geo), serviceTyped) : null);
      fill("figures", geo ? renderFigures(geo, loadFrom) : null);
      fill("compare", cmp ? renderCompare(cmp, loadFrom, loadTo) : null);
      fill("shop", geo ? renderShop(geo, vsGeo) : null);
      bands.how.hidden = typedSomething;
      stripe();

      swapBtn.disabled = !sizeRaw && !vsRaw;
      copyBtn.disabled = !typedSomething;
    }

    function update(immediateErrors) {
      writeUrl();
      copyLabel.textContent = "Copy link to this result";
      render();
      scheduleErrors(immediateErrors);
    }

    [sizeEl, vsEl].forEach(function (el) {
      el.addEventListener("input", function () { update(false); });
      el.addEventListener("change", function () { scheduleErrors(true); });
      el.addEventListener("blur", function () { scheduleErrors(true); });
    });
    q('[data-ts="form"]').addEventListener("submit", function (e) { e.preventDefault(); update(true); });
    Array.prototype.forEach.call(root.querySelectorAll("[data-ts-example]"), function (btn) {
      btn.addEventListener("click", function () { sizeEl.value = btn.getAttribute("data-ts-example"); update(true); });
    });
    swapBtn.addEventListener("click", function () {
      var s = sizeEl.value; sizeEl.value = vsEl.value; vsEl.value = s; update(true);
    });
    copyBtn.addEventListener("click", function () {
      var url = location.href;
      function done(ok) { copyLabel.textContent = ok ? "Link copied" : "Copy the address bar to share this"; }
      function fallback() {
        try {
          var ta = document.createElement("textarea");
          ta.value = url; ta.setAttribute("readonly", ""); ta.style.position = "fixed"; ta.style.opacity = "0";
          document.body.appendChild(ta); ta.select();
          var ok = document.execCommand("copy");
          document.body.removeChild(ta); done(ok);
        } catch (e) { done(false); }
      }
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(url).then(function () { done(true); }, fallback);
      } else { fallback(); }
    });

    // Deep links: ?size= and ?vs= fill the inputs on load.
    var params = new URLSearchParams(location.search);
    sizeEl.value = params.get("size") || "";
    vsEl.value = params.get("vs") || "";
    render();
    scheduleErrors(true);
  })();
</script>

{% schema %}
{
  "name": "TireDrop tire size tool",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Free tool" },
    { "type": "text", "id": "heading", "label": "Page heading (h1)", "default": "Tire Size Decoder" },
    { "type": "textarea", "id": "lede", "label": "Supporting copy", "default": "Type what is written on your sidewall. We will draw it, explain every part of the marking in plain English, and show you exactly what changes if you fit something different." }
  ],
  "presets": [{ "name": "TireDrop tire size tool" }]
}
{% endschema %}
