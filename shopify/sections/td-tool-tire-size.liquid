  .td-ts-band { background: #FFFFFF; }
  .td-ts-band--alt { background: #F4F6FA; }
  .td-ts-inner { max-width: 1280px; margin: 0 auto; padding: 3.5rem 1rem; }

  /* ---- type ---- */
  .td-ts-head { max-width: 42rem; margin: 0 auto 2rem; text-align: center; }
  .td-ts-eyebrow {
    font-family: var(--font-subheading--family, inherit);
    font-size: .75rem; font-weight: 700; letter-spacing: .09em;
    text-transform: uppercase; color: #0068E8; margin: 0 0 .625rem; text-wrap: balance;
  }
  .td-ts-h1, .td-ts-h2, .td-ts-h3 {
    font-family: var(--font-heading--family, inherit);
    color: #070E1A; margin: 0; text-wrap: balance;
  }
  .td-ts-h1 { font-weight: 800; letter-spacing: -.02em; line-height: 1.04; font-size: clamp(2.25rem, 6vw, 3.25rem); }
  .td-ts-h2 { font-weight: 800; letter-spacing: -.02em; line-height: 1.08; font-size: clamp(1.75rem, 4vw, 2.5rem); overflow-wrap: anywhere; }
  .td-ts-h3 { font-weight: 700; letter-spacing: -.01em; line-height: 1.2; font-size: 1.125rem; }
  .td-ts-h3--lg { font-size: 1.5rem; }
  .td-ts-lede { margin: .875rem auto 0; max-width: 36rem; text-wrap: pretty; font-size: 1.0625rem; line-height: 1.6; color: #586274; }
