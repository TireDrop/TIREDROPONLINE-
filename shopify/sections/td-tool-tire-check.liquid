  .td-tc-fieldset--gap { margin-top: 1.25rem; }

  .td-tc-seg { display: grid; gap: .5rem; grid-template-columns: repeat(var(--td-tc-n, 1), minmax(0, 1fr)); }
  .td-tc-seg--2 { --td-tc-n: 2; }
  .td-tc-seg--3 { --td-tc-n: 1; }
  .td-tc-seg__opt { position: relative; display: block; }
