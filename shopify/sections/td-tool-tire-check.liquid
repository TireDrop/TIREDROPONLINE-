  .td-tc-fig__sub { margin-top: .375rem; font-size: .8125rem; line-height: 1.5; color: #586274; }
  .td-tc-lifebar { margin-top: 1rem; height: 10px; border-radius: 999px; background: #E3E8EF; overflow: hidden; }
  .td-tc-lifebar__fill { height: 100%; border-radius: 999px; background: #0068E8; }
