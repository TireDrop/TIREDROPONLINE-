    background: #EFF5FF; color: #070E1A;
  }
  .td-tc-badge--fine { background: #0068E8; color: #FFFFFF; }
  .td-tc-badge--soon { background: #F5A623; color: #070E1A; }
  .td-tc-badge--replace { background: #B42318; color: #FFFFFF; }
  .td-tc-badge--soft { background: #EFF5FF; color: #070E1A; }
  .td-tc-icon { display: inline-flex; width: 22px; height: 22px; flex: 0 0 auto; }
  .td-tc-icon:empty { display: none; }
  .td-tc-icon svg { width: 100%; height: 100%; }
  .td-tc-icon--fine { color: #0068E8; }
  .td-tc-icon--soon { color: #8A4F00; }
  .td-tc-icon--replace { color: #B42318; }

  .td-tc-figs { display: grid; gap: .75rem; }
  .td-tc-fig { background: #F4F6FA; border-radius: 8px; padding: 1rem; }
  .td-tc-fig__value {
    font-family: var(--font-heading--family, inherit);
    font-size: 1.6rem; font-weight: 800; line-height: 1.05; color: #070E1A;
