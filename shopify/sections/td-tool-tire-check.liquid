  .is-replace .td-tc-lifebar__fill { background: #B42318; }

  /* Verdict */
  .td-tc-verdict { background: #FFFFFF; border: 1px solid #E3E8EF; border-radius: 12px; padding: 1.5rem; }
  .td-tc-verdict--fine { background: #EFF5FF; border-left: 4px solid #0068E8; }
  .td-tc-verdict--soon { border-left: 4px solid #F5A623; }
  .td-tc-verdict--replace { border-left: 4px solid #B42318; }
  .td-tc-verdict__title {
    font-family: var(--font-heading--family, inherit);
    font-weight: 800; letter-spacing: -.015em; line-height: 1.1;
    font-size: clamp(1.5rem, 3.4vw, 2.125rem); margin: 0; color: #070E1A; text-wrap: balance;
  }
  .td-tc-verdict__body { margin-top: 1rem; max-width: 42rem; font-size: 1.0625rem; line-height: 1.6; color: #586274; }
  .td-tc-verdict__list { list-style: none; margin: 1.25rem 0 0; padding: 0; max-width: 42rem; display: grid; gap: .75rem; }
  .td-tc-verdict__list li { display: flex; gap: .75rem; font-size: 1.0625rem; line-height: 1.6; color: #586274; }
  .td-tc-verdict__list li::before {
    content: ""; flex: 0 0 auto; width: 6px; height: 6px; margin-top: .7em;
    border-radius: 999px; background: #8A4F00;
