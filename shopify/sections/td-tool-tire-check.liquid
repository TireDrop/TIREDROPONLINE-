  .td-tc-choice:hover { border-color: #070E1A; }
  .td-tc-choice input { width: 20px; height: 20px; margin: 0; flex: 0 0 auto; accent-color: #0068E8; cursor: pointer; }
  .td-tc-choice:has(input:checked) { border-color: #0068E8; background: #EFF5FF; color: #070E1A; }
