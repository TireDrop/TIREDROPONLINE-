{% comment %}
  "Do I need tires yet?" — the tire check tool, ported from
  src/pages/tools/TireCheckPage.jsx.

  All arithmetic comes from td-tiremath.js (window.TireDrop), which is
  generated from src/data/tireMath.js. Nothing here recomputes tread status,
  life left or tire age: it only chooses which words to show for what those
  functions return.

  Honesty rules this port keeps:
  - It never calls a tire safe. It reports what the tread and date code say,
    and the note on what it cannot see (sidewall, repairs, belts, uneven
    wear) is always on the page, not only under a good result.
  - Age is shown in whole years rounded down, the way decodeDot's caller in
    the React page did it: 11.5 years reads "about 11", never 12.
  - An unreadable gauge reading says so, with role="alert" and aria-invalid.
    It never falls back to a default depth.

  State lives in the URL (method, coin, bars, nd, tread, gauge, dot, size),
  the same parameters the React page used, so old deep links keep working.
{% endcomment %}

{%- liquid
  assign search_url = routes.search_url | default: '/search'
  assign all_url = routes.all_products_collection_url | default: '/collections/all'
-%}

<section
  id="td-tc-{{ section.id }}"
  class="td-tc"
  data-search-url="{{ search_url }}"
  data-all-url="{{ all_url }}"
>
  {%- comment -%} ---------------- Head ---------------- {%- endcomment -%}
  <div class="td-tc-band">
    <div class="td-tc-inner">
      <header class="td-tc-head td-tc-head--page">
        {% if section.settings.eyebrow != blank %}
          <p class="td-tc-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}
        <h1 class="td-tc-h1">{{ section.settings.heading | default: 'Do I need tires yet?' | escape }}</h1>
        {% if section.settings.lede != blank %}
          <p class="td-tc-lede">{{ section.settings.lede | escape }}</p>
        {% endif %}
        {% if section.settings.promise != blank %}
          <p class="td-tc-promise">{{ section.settings.promise | escape }}</p>
        {% endif %}
      </header>
    </div>
  </div>

  {%- comment -%} ---------------- Step one: tread ---------------- {%- endcomment -%}
  <div class="td-tc-band td-tc-band--fog">
    <div class="td-tc-inner">
      <div class="td-tc-head">
        <p class="td-tc-eyebrow">Step one</p>
        <h2 class="td-tc-h2">How much tread is left?</h2>
        <p class="td-tc-lede">Three ways in, depending on what you have to hand. Check three spots across each tire and use the shallowest reading — tires rarely wear evenly, and the worn edge is the one that decides.</p>
      </div>

      <div class="td-tc-grid td-tc-grid--tread">
        <div class="td-tc-card td-tc-card--pad">
          <fieldset class="td-tc-fieldset">
            <legend class="td-tc-label">What are you using?</legend>
            <div class="td-tc-seg td-tc-seg--3">
              <label class="td-tc-seg__opt">
                <input type="radio" name="td-tc-method" value="coin" data-tc="method">
                <span>A coin</span>
              </label>
              <label class="td-tc-seg__opt">
                <input type="radio" name="td-tc-method" value="gauge" data-tc="method">
                <span>A depth gauge</span>
              </label>
              <label class="td-tc-seg__opt">
                <input type="radio" name="td-tc-method" value="bars" data-tc="method">
                <span>The wear bars</span>
              </label>
            </div>
          </fieldset>

          {%- comment -%} Coin {%- endcomment -%}
          <div class="td-tc-method" data-tc-panel="coin">
            <fieldset class="td-tc-fieldset">
              <legend class="td-tc-label">Which coin?</legend>
              <div class="td-tc-seg td-tc-seg--2">
                <label class="td-tc-seg__opt">
                  <input type="radio" name="td-tc-coin" value="penny" data-tc="coin">
                  <span>Penny</span>
                </label>
                <label class="td-tc-seg__opt">
                  <input type="radio" name="td-tc-coin" value="quarter" data-tc="coin">
                  <span>Quarter</span>
                </label>
              </div>
            </fieldset>

            <div class="td-tc-figure-frame" data-tc-out="coin-diagram"></div>

            <div class="td-tc-slider-head">
              <label for="td-tc-slider-{{ section.id }}" class="td-tc-label td-tc-label--inline">Drag until the picture matches your tire</label>
              <output class="td-tc-slider-value" for="td-tc-slider-{{ section.id }}" data-tc-out="slider-value">6/32"</output>
            </div>
            <input
              id="td-tc-slider-{{ section.id }}"
              class="td-tc-range"
              type="range"
              min="0"
              max="12"
              step="0.5"
              value="6"
              data-tc="tread"
              aria-describedby="td-tc-slider-help-{{ section.id }}"
            >
            <div class="td-tc-range-ends" aria-hidden="true">
              <span>Coin sits on top</span>
              <span>Coin sinks in deep</span>
            </div>
            <p id="td-tc-slider-help-{{ section.id }}" class="td-tc-copy">
              <span data-tc-out="coin-help"></span>
              <span class="td-tc-ink" data-tc-out="coin-now"></span>
            </p>
          </div>

          {%- comment -%} Gauge {%- endcomment -%}
          <div class="td-tc-method" data-tc-panel="gauge" hidden>
            <label for="td-tc-gauge-{{ section.id }}" class="td-tc-label">Depth reading, in 32nds of an inch</label>
            <div class="td-tc-gauge-row">
              <input
                id="td-tc-gauge-{{ section.id }}"
                class="td-tc-input td-tc-input--gauge"
                type="text"
                inputmode="decimal"
                autocomplete="off"
                placeholder="6"
                data-tc="gauge"
              >
              <span class="td-tc-suffix" aria-hidden="true">/32"</span>
            </div>
            <p id="td-tc-gauge-error-{{ section.id }}" class="td-tc-error" role="alert" data-tc-out="gauge-error"></p>
            <p class="td-tc-copy">A pin-style gauge reads in 32nds straight off the barrel. Sit the shoulders of the gauge flat on the tread blocks and push the pin to the bottom of a main groove — not into a sipe, and not on top of a wear bar, both of which will read shallow.</p>
            <p class="td-tc-copy">Some gauges read in millimetres. Divide the millimetre reading by 0.79 to get 32nds — 4 mm is almost exactly 5/32".</p>
          </div>

          {%- comment -%} Wear bars {%- endcomment -%}
          <div class="td-tc-method" data-tc-panel="bars" hidden>
            <div class="td-tc-figure-frame" data-tc-out="bar-diagram"></div>
            <fieldset class="td-tc-fieldset td-tc-fieldset--gap">
              <legend class="td-tc-label">What do the bars look like?</legend>
              <div class="td-tc-choices">
                <label class="td-tc-choice">
                  <input type="radio" name="td-tc-bars" value="above" data-tc="bars">
                  <span>Tread sits clearly above the bars</span>
                </label>
                <label class="td-tc-choice">
                  <input type="radio" name="td-tc-bars" value="close" data-tc="bars">
                  <span>Tread is nearly down to the bars</span>
                </label>
                <label class="td-tc-choice">
                  <input type="radio" name="td-tc-bars" value="flush" data-tc="bars">
                  <span>Bars are flush with the tread</span>
                </label>
              </div>
            </fieldset>
            <p class="td-tc-copy">Tread wear indicators are short raised bars molded across the bottom of the main grooves, every few inches around the tire. Look for the small triangle, TWI mark or brand logo on the shoulder — it points at the nearest one.</p>
          </div>
        </div>

        {%- comment -%} Tread result {%- endcomment -%}
        <div class="td-tc-card td-tc-result" data-tc-out="tread-card" aria-live="polite">
          <div data-tc-out="tread-empty">
            <p class="td-tc-label">Your reading</p>
            <p class="td-tc-copy td-tc-copy--flush" data-tc-out="tread-empty-copy"></p>
            <button type="button" class="td-tc-btn td-tc-btn--outline td-tc-btn--sm" data-tc-action="use-coin" hidden>
              Use a coin instead <span aria-hidden="true">&rarr;</span>
            </button>
          </div>

          <div data-tc-out="tread-full" hidden>
            <div class="td-tc-badge-row">
              <span class="td-tc-icon" data-tc-out="tread-icon" aria-hidden="true"></span>
              <span class="td-tc-badge" data-tc-out="tread-badge"></span>
            </div>
            <div class="td-tc-figs">
              <div class="td-tc-fig">
                <p class="td-tc-label td-tc-label--tight">Tread depth</p>
                <p class="td-tc-fig__value" data-tc-out="tread-depth"></p>
                <p class="td-tc-fig__sub" data-tc-out="tread-precision"></p>
              </div>
              <div class="td-tc-fig">
                <p class="td-tc-label td-tc-label--tight">Usable life left</p>
                <p class="td-tc-fig__value" data-tc-out="tread-life"></p>
                <p class="td-tc-fig__sub">Measured against the 2/32" legal limit, not against zero. The last 2/32" is not yours to use.</p>
              </div>
            </div>
            <div class="td-tc-lifebar" aria-hidden="true"><div class="td-tc-lifebar__fill" data-tc-out="tread-bar"></div></div>
            <p class="td-tc-copy" data-tc-out="tread-copy"></p>
            <p class="td-tc-small td-tc-rule" data-tc-out="tread-note"></p>

            <fieldset class="td-tc-fieldset td-tc-fieldset--gap">
              <legend class="td-tc-label">Compare the percentage against</legend>
              <div class="td-tc-choices">
                <label class="td-tc-choice"><input type="radio" name="td-tc-nd" value="10" data-tc="nd"><span>10/32" — typical passenger or touring tire</span></label>
                <label class="td-tc-choice"><input type="radio" name="td-tc-nd" value="12" data-tc="nd"><span>12/32" — many all-terrain and light-truck tires</span></label>
                <label class="td-tc-choice"><input type="radio" name="td-tc-nd" value="14" data-tc="nd"><span>14/32" — deep winter and heavy LT tires</span></label>
              </div>
            </fieldset>
            <p class="td-tc-small">This only changes the percentage, never the verdict. Most passenger tires leave the factory at 10–11/32"; truck and winter tires start deeper, so pick the closest match or a new winter tire will read under 100%.</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  {%- comment -%} ---------------- Step two: age ---------------- {%- endcomment -%}
  <div class="td-tc-band">
    <div class="td-tc-inner">
      <div class="td-tc-head">
        <p class="td-tc-eyebrow">Step two</p>
        <h2 class="td-tc-h2">How old is the rubber?</h2>
        <p class="td-tc-lede">Tread wears; rubber ages on its own schedule. The DOT code stamped on the sidewall is the only honest answer to how old a tire is — the day you bought it is not the day it was built.</p>
      </div>

      <div class="td-tc-grid td-tc-grid--age">
        <div class="td-tc-card td-tc-card--pad">
          <label for="td-tc-dot-{{ section.id }}" class="td-tc-label">The last four digits of the DOT code</label>
          <input
            id="td-tc-dot-{{ section.id }}"
            class="td-tc-input td-tc-input--dot"
            type="text"
            inputmode="numeric"
            autocomplete="off"
            placeholder="3421"
            aria-describedby="td-tc-dot-help-{{ section.id }}"
            data-tc="dot"
          >
          <p id="td-tc-dot-help-{{ section.id }}" class="td-tc-copy">Paste the whole serial if it is easier — only the last four digits carry the date. The first two are the week, the last two are the year: <span class="td-tc-ink">3421</span> is the 34th week of 2021.</p>

          <div class="td-tc-figure-frame td-tc-figure-frame--dark">
            <svg viewBox="0 0 400 200" class="td-tc-svg" role="img" aria-label="A tire sidewall stamped DOT U2LL LMLR 3421, with the last four digits — 3421, week 34 of 2021 — highlighted as the date code.">
              <rect x="0" y="0" width="400" height="200" rx="10" fill="#101C2E"/>
              <path d="M 12 186 Q 200 86 388 186" fill="none" stroke="#22344C" stroke-width="52" stroke-linecap="round"/>
              <path d="M 12 186 Q 200 86 388 186" fill="none" stroke="#334A69" stroke-width="2"/>
              <text x="256" y="143" text-anchor="end" font-size="20" font-weight="700" letter-spacing="2" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" fill="#E9F2FF">DOT U2LL LMLR</text>
              <rect x="264" y="118" width="80" height="38" rx="7" fill="#00B4FC"/>
              <text x="304" y="144" text-anchor="middle" font-size="22" font-weight="800" letter-spacing="2" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" fill="#070E1A">3421</text>
              <line x1="304" y1="116" x2="304" y2="96" stroke="#00B4FC" stroke-width="2"/>
              <text x="304" y="82" text-anchor="middle" font-size="17" font-weight="700" fill="#00B4FC">The last four digits</text>
              <text x="304" y="58" text-anchor="middle" font-size="16" font-weight="600" fill="#9FB4D0">week 34 of 2021</text>
            </svg>
          </div>

          <h3 class="td-tc-h3">Where to find it</h3>
          <ol class="td-tc-steps">
            <li><span class="td-tc-steps__n" aria-hidden="true">1</span><span>Look on the sidewall for the letters DOT, followed by a run of letters and numbers. It is molded in, the same colour as the tire, so it is easier to feel than to see.</span></li>
            <li><span class="td-tc-steps__n" aria-hidden="true">2</span><span><span class="td-tc-ink">This is where everyone gets stuck:</span> the full code with the date on the end is normally only stamped on one side of the tire. If the side facing you ends after the plant and size codes, the date is on the inboard face — look from under the car, or turn the wheel to full lock to see the inside of a front tire.</span></li>
            <li><span class="td-tc-steps__n" aria-hidden="true">3</span><span>Four digits inside a small oval, right at the end. Three digits instead of four means the tire was built before 2000.</span></li>
          </ol>
        </div>

        {%- comment -%} Age result {%- endcomment -%}
        <div class="td-tc-card td-tc-result" data-tc-out="age-card" aria-live="polite">
          <div data-tc-out="age-empty">
            <p class="td-tc-label">Age check</p>
            <p class="td-tc-copy td-tc-copy--flush">Type the four digits and this will tell you the week the tire was built, how old it is now, and what that means.</p>
          </div>

          <div data-tc-out="age-unreadable" hidden>
            <div class="td-tc-badge-row">
              <span class="td-tc-badge td-tc-badge--soft">Can't read that</span>
            </div>
            <p class="td-tc-copy td-tc-copy--flush">That is not a date code this page can decode. It needs four digits where the first two are a week from 01 to 53 — so <span class="td-tc-ink">0624</span> works and <span class="td-tc-ink">6024</span> cannot, because there is no 60th week. Check you have the last four digits of the DOT serial rather than the load index or the size.</p>
          </div>

          <div data-tc-out="age-legacy" hidden>
            <div class="td-tc-badge-row">
              <span class="td-tc-icon td-tc-icon--replace" aria-hidden="true"></span>
              <span class="td-tc-badge td-tc-badge--replace">Pre-2000 tire</span>
            </div>
            <p class="td-tc-copy td-tc-copy--flush">Three digits means the tire was built before 2000, when the code did not carry a decade. Which year stopped mattering a long time ago: that tire is at least twenty-five years old and belongs off the car whatever the tread looks like — including if it is the spare that has never touched the road.</p>
          </div>

          <div data-tc-out="age-full" hidden>
            <div class="td-tc-badge-row">
              <span class="td-tc-icon" data-tc-out="age-icon" aria-hidden="true"></span>
              <span class="td-tc-badge" data-tc-out="age-badge"></span>
            </div>
            <div class="td-tc-figs">
              <div class="td-tc-fig">
                <p class="td-tc-label td-tc-label--tight">Built</p>
                <p class="td-tc-fig__value" data-tc-out="age-built"></p>
                <p class="td-tc-fig__sub" data-tc-out="age-built-sub"></p>
              </div>
              <div class="td-tc-fig">
                <p class="td-tc-label td-tc-label--tight">Age today</p>
                <p class="td-tc-fig__value" data-tc-out="age-years"></p>
                <p class="td-tc-fig__sub">In whole years, rounded down.</p>
              </div>
            </div>
            <p class="td-tc-copy" data-tc-out="age-copy"></p>
            <p class="td-tc-small td-tc-rule">Six and ten years are manufacturer guidance, not law — no US state puts an age limit on a passenger tire. Rubber ages whether the tire is driven or parked, which is why a spare with full tread can still be past it, and heat and sun move it along faster than a garage does.</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  {%- comment -%} ---------------- The answer ---------------- {%- endcomment -%}
  <div class="td-tc-band td-tc-band--fog">
    <div class="td-tc-inner td-tc-inner--narrow">
      <div class="td-tc-head">
        <p class="td-tc-eyebrow">The answer</p>
        <h2 class="td-tc-h2">So — do you need tires?</h2>
      </div>

      <div aria-live="polite" data-tc-out="verdict"></div>

      {%- comment -%}
        Always on the page, whatever the result — including before anything is
        entered. The tool reads two numbers and must not be taken as answering
        a third question it cannot see.
      {%- endcomment -%}
      <aside class="td-tc-cannot" aria-label="What this check cannot see" data-tc-out="cannot-see">
        <p><strong>One thing this cannot do:</strong> it reads tread depth and date code, and nothing else. It has not seen a bulge or a cut in your sidewall, an old repair, a belt starting to separate, or wear running unevenly across the tread — any of which can finish a tire that still measures fine here. If something looks wrong, or the car pulls, shakes or sits oddly, have someone look at it properly.</p>
      </aside>

      <div class="td-tc-card td-tc-card--pad td-tc-size">
        <h3 class="td-tc-h3 td-tc-h3--flush">Know your size? Carry it through.</h3>
        <p class="td-tc-copy">It is on the sidewall in the form 215/60R16, and on the placard inside the driver's door. Enter it and every link on this page points at your size — including if you bookmark or share this result.</p>
        <div class="td-tc-size-row">
          <div class="td-tc-size-field">
            <label for="td-tc-size-{{ section.id }}" class="td-tc-label">Your tire size</label>
            <input
              id="td-tc-size-{{ section.id }}"
              class="td-tc-input"
              type="text"
              autocomplete="off"
              placeholder="215/60R16"
              aria-describedby="td-tc-size-msg-{{ section.id }}"
              data-tc="size"
            >
          </div>
          <a href="{{ search_url }}" class="td-tc-btn td-tc-btn--outline" data-tc-out="size-link" hidden></a>
        </div>
        <p id="td-tc-size-msg-{{ section.id }}" class="td-tc-small" aria-live="polite" data-tc-out="size-msg">Optional. Everything above works without it.</p>
      </div>
    </div>
  </div>

  {%- comment -%} ---------------- FAQ ---------------- {%- endcomment -%}
  <div class="td-tc-band">
    <div class="td-tc-inner td-tc-inner--narrow">
      <div class="td-tc-head">
        <p class="td-tc-eyebrow">Questions</p>
        <h2 class="td-tc-h2">The things people ask next</h2>
        <p class="td-tc-lede">Short answers, including the ones that mean you do not need to buy anything.</p>
      </div>
      <div class="td-tc-faq">
        <details>
          <summary>How often should I actually check?</summary>
          <p>Once a month, at the same time you check pressures, and again before any long drive. It takes under a minute per tire. Check three spots across each tire — outer shoulder, middle, inner shoulder — because a tire rarely wears evenly, and the shallowest reading is the one that counts.</p>
        </details>
        <details>
          <summary>Does the spare count?</summary>
          <p>Yes, and it is the one nobody checks. A full-size spare ages in the trunk at the same rate as the four doing the work, so a spare with beautiful tread can still be a ten-year-old tire. Check its date code and its pressure twice a year. A temporary compact spare is a different animal: it carries its own speed and distance limits printed on the sidewall, usually 50 mph and a short trip to a shop.</p>
        </details>
        <details>
          <summary>What does uneven wear tell me?</summary>
          <p>Worn down the centre with the shoulders still full means over-inflation — the tire is crowned and riding on its middle. Worn on both shoulders with the centre full means the opposite: chronic under-inflation. Worn on one shoulder only is alignment, usually camber or toe, and no new tire will survive it until the alignment is fixed. Patchy or scalloped wear that you can feel with your palm points at worn shocks, struts or a wheel that is out of balance.</p>
        </details>
        <details>
          <summary>The tread is fine. Does age really matter?</summary>
          <p>It does, and this is the part the tread check cannot see. Rubber cures and hardens over time whether the tire is driven or parked, which is why a barely-used spare or a low-mileage car on original tires can be past it with most of the tread still there. Six years is the usual point at which manufacturers ask for a yearly inspection, and ten years is the usual hard stop — but both are manufacturer guidance, not law. Heat and sunlight, which South Florida has in quantity, move it along faster.</p>
        </details>
        <details>
          <summary>Is 2/32" really the legal line?</summary>
          <p>In most US states, yes — it is the point at which a tire is legally worn out, and it is what the penny test finds. A handful of states word it differently or set the bar elsewhere, so treat 2/32" as the floor rather than the whole answer. Either way, well before that, wet braking has already fallen off sharply: below 4/32" the grooves can no longer move enough water out of the way.</p>
        </details>
        <details>
          <summary>Do I have to replace all four?</summary>
          <p>Not always. On a front- or rear-wheel-drive car, two is fine if the other two still have real tread — and the new pair goes on the rear axle regardless of which end drives, because a car that loses grip at the back first is much harder to catch. All-wheel drive is stricter: many manufacturers require all four within a small difference in circumference, so a single replacement on a worn set can cook a differential. Check the owner's manual before buying one tire.</p>
        </details>
      </div>
    </div>
  </div>
</section>

<style>
  .td-tc {
    background: #FFFFFF; color: #070E1A;
    font-family: var(--font-body--family, inherit);
    font-size: 1rem; line-height: 1.5;
  }
  .td-tc *, .td-tc *::before, .td-tc *::after { box-sizing: border-box; }
  .td-tc [hidden] { display: none !important; }
  :where(.td-tc) p { margin: 0; }

  .td-tc-band { padding: 3.5rem 0; }
  .td-tc-band--fog { background: #F4F6FA; }
  .td-tc-inner { max-width: 1280px; margin: 0 auto; padding: 0 1rem; }
  .td-tc-inner--narrow > * { max-width: 56rem; margin-left: auto; margin-right: auto; }

  /* Section heads: centred, as on the homepage bands. */
  .td-tc-head { max-width: 42rem; margin: 0 auto 2rem; text-align: center; }
  .td-tc-head--page { margin-bottom: 0; }
  .td-tc-eyebrow {
    font-family: var(--font-subheading--family, inherit);
    font-size: .75rem; font-weight: 700; letter-spacing: .09em;
    text-transform: uppercase; color: #0068E8; margin: 0 0 .625rem; text-wrap: balance;
  }
  .td-tc-h1 {
    font-family: var(--font-heading--family, inherit);
    font-weight: 800; letter-spacing: -.02em; line-height: 1.02;
    font-size: clamp(2.25rem, 6vw, 3.5rem); margin: 0; color: #070E1A;
    text-wrap: balance;
  }
  .td-tc-h2 {
    font-family: var(--font-heading--family, inherit);
    font-weight: 800; letter-spacing: -.02em; line-height: 1.05;
    font-size: clamp(1.75rem, 4vw, 2.5rem); margin: 0; color: #070E1A;
    text-wrap: balance;
  }
  .td-tc-h3 {
    font-family: var(--font-heading--family, inherit);
    font-weight: 700; line-height: 1.2; font-size: 1.125rem;
    margin: 1.5rem 0 .75rem; color: #070E1A; text-wrap: balance;
  }
  .td-tc-h3--flush { margin-top: 0; margin-bottom: .5rem; }
  .td-tc-lede {
    margin: .875rem auto 0; max-width: 36rem; text-wrap: pretty;
