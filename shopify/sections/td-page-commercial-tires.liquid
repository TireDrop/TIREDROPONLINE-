{% comment %}
  Fleet & commercial tires — the Shopify port of src/pages/shop/CommercialTiresPage.jsx.

  The quote form is Shopify's native contact form, so a request lands in the
  store inbox. Fields mirror React's; the ones Shopify knows (name, email,
  phone, body) keep their standard names and the rest go in as
  contact[Field name]. React's validation messages are shown on submit by the
  script at the bottom; without JavaScript the browser's own required-field
  checks still stop an empty submit. After the post, Shopify's success or
  error state replaces or tops the form.

  The catalog band shows products from the chosen collection. The catalog is
  empty today, so with no collection (or an empty one) it shows an honest
  "call or ask for a quote" panel instead of a grid.
{% endcomment %}
{%- liquid
  assign ss = section.settings
  assign phone = ss.phone | default: '(954) 773-1896'
  assign phone_digits = phone | remove: '(' | remove: ')' | remove: ' ' | remove: '-' | remove: '.'
  assign phone_href = 'tel:+1' | append: phone_digits
  assign uid = 'td-fleet-' | append: section.id
  assign fleet_products = ss.collection.products
  assign fleet_count = 0
  if ss.collection != blank
    assign fleet_count = ss.collection.products_count
  endif
-%}
{%- render 'td-pg-kit' -%}

<div class="td-pg td-pg-fleet" id="td-pg-{{ section.id }}">
  <header class="td-pg-hero">
    <div class="td-pg-wrap td-pg-hero__inner">
      {%- if ss.hero_eyebrow != blank -%}<p class="td-pg-eyebrow">{{ ss.hero_eyebrow }}</p>{%- endif -%}
      <h1>{{ ss.hero_heading }}</h1>
      {%- if ss.hero_lede != blank -%}<p class="td-pg-hero__lede">{{ ss.hero_lede }}</p>{%- endif -%}
      <div class="td-pg-hero__extra">
        <div class="td-pg-btns td-pg-fleet__hero-btns">
          <a class="td-pg-btn td-pg-btn--primary" href="#fleet-quote">{{ ss.hero_cta_label | default: 'Request a quote' }}</a>
          <a class="td-pg-btn td-pg-btn--ghost" href="{{ phone_href }}">{% render 'td-pg-icon', name: 'phone', size: 18 %}{{ phone }}</a>
        </div>
      </div>
    </div>
  </header>

  <nav class="td-pg-crumbs" aria-label="Breadcrumb">
    <ol class="td-pg-wrap">
      <li><a href="{{ routes.root_url }}">Home</a></li>
      <li>{% render 'td-pg-icon', name: 'chevron-right', size: 13 %}<span aria-current="page">{{ ss.crumb | default: 'Commercial Tires' }}</span></li>
    </ol>
  </nav>

  {%- comment -%} ---------- Why fleets call ---------- {%- endcomment -%}
  <section class="td-pg-sec td-pg-sec--fog" aria-labelledby="td-pg-{{ section.id }}-why">
    <div class="td-pg-wrap">
      <div class="td-pg-head td-pg-head--center"><div class="td-pg-head__text">
        {%- if ss.why_eyebrow != blank -%}<p class="td-pg-eyebrow">{{ ss.why_eyebrow }}</p>{%- endif -%}
        <h2 class="td-pg-h2" id="td-pg-{{ section.id }}-why">{{ ss.why_heading }}</h2>
        {%- if ss.why_lede != blank -%}<p class="td-pg-lede">{{ ss.why_lede }}</p>{%- endif -%}
      </div></div>
      <div class="td-pg-grid td-pg-grid--3">
        {%- for block in section.blocks -%}{%- if block.type == 'value' -%}
          <div class="td-pg-card td-pg-card--pad" {{ block.shopify_attributes }}>
            {% render 'td-pg-icon', name: block.settings.icon, size: 24, cls: 'td-pg-icon--lead td-pg-fleet__vicon' %}
            <h3 class="td-pg-h3">{{ block.settings.title }}</h3>
            <p class="td-pg-body td-pg-mt1">{{ block.settings.body | replace: '[phone]', phone }}</p>
          </div>
        {%- endif -%}{%- endfor -%}
      </div>
    </div>
  </section>

  {%- comment -%} ---------- In the catalog ---------- {%- endcomment -%}
  <section class="td-pg-sec td-pg-sec--bone" aria-labelledby="td-pg-{{ section.id }}-cat">
    <div class="td-pg-wrap">
      <div class="td-pg-head td-pg-head--action">
        <div class="td-pg-head__text">
          {%- if ss.cat_eyebrow != blank -%}<p class="td-pg-eyebrow">{{ ss.cat_eyebrow }}</p>{%- endif -%}
          <h2 class="td-pg-h2" id="td-pg-{{ section.id }}-cat">{{ ss.cat_heading }}</h2>
          {%- if fleet_count > 0 and ss.cat_lede != blank -%}<p class="td-pg-lede">{{ ss.cat_lede }}</p>{%- endif -%}
        </div>
        {%- if ss.cat_link_label != blank -%}
          <div class="td-pg-head__action">
            <a class="td-pg-btn td-pg-btn--outline td-pg-btn--sm" href="{{ ss.cat_link | default: ss.collection.url | default: routes.all_products_collection_url }}">{{ ss.cat_link_label }}</a>
          </div>
        {%- endif -%}
      </div>
      {%- if fleet_count > 0 -%}
        {%- render 'td-collection-base' -%}
        <div class="td-shop">
          <ul class="td-shop-grid td-pg-fleet__grid" role="list">
            {%- for product in fleet_products limit: 8 -%}
              <li>{%- render 'td-product-card', product: product, heading_level: 3 -%}</li>
            {%- endfor -%}
          </ul>
        </div>
      {%- else -%}
        <div class="td-pg-card td-pg-fleet__empty">
          {% render 'td-pg-icon', name: 'truck', size: 26 %}
          <h3 class="td-pg-h3">{{ ss.empty_heading | default: 'Commercial sizes are priced per quote' }}</h3>
          <p class="td-pg-body">{{ ss.empty_text | replace: '[phone]', phone }}</p>
          <div class="td-pg-btns">
            <a class="td-pg-btn td-pg-btn--primary td-pg-btn--sm" href="#fleet-quote">{{ ss.hero_cta_label | default: 'Request a quote' }}</a>
            <a class="td-pg-btn td-pg-btn--outline td-pg-btn--sm" href="{{ phone_href }}">{% render 'td-pg-icon', name: 'phone', size: 16 %}{{ phone }}</a>
          </div>
        </div>
      {%- endif -%}
    </div>
  </section>

  {%- comment -%} ---------- Fleet quote ---------- {%- endcomment -%}
  <section class="td-pg-sec td-pg-sec--fog td-pg-fleet__quote" id="fleet-quote" aria-labelledby="td-pg-{{ section.id }}-quote">
    <div class="td-pg-wrap td-pg-fleet__layout">
      <div class="td-pg-fleet__main">
        <div class="td-pg-head"><div class="td-pg-head__text">
          {%- if ss.quote_eyebrow != blank -%}<p class="td-pg-eyebrow">{{ ss.quote_eyebrow }}</p>{%- endif -%}
          <h2 class="td-pg-h2" id="td-pg-{{ section.id }}-quote">{{ ss.quote_heading }}</h2>
          {%- if ss.quote_lede != blank -%}<p class="td-pg-lede">{{ ss.quote_lede }}</p>{%- endif -%}
        </div></div>

        {%- form 'contact', id: uid, class: 'td-pg-fleet__form-wrap' -%}
          {%- if form.posted_successfully? -%}
            <div class="td-pg-card td-pg-fleet__state td-pg-fleet__state--ok" role="status" tabindex="-1" data-focus>
              {% render 'td-pg-icon', name: 'circle-check', size: 36 %}
              <h3 class="td-pg-h3">{{ ss.ok_heading | default: 'Quote request received' }}</h3>
              <p class="td-pg-body td-pg-mt1">{{ ss.ok_text }}</p>
              <p class="td-pg-body td-pg-mt2">Need it sooner? Call {{ phone }} and ask for fleet service.</p>
              <div class="td-pg-btns td-pg-mt3">
                <a class="td-pg-btn td-pg-btn--primary td-pg-btn--sm" href="{{ phone_href }}">{% render 'td-pg-icon', name: 'phone', size: 16 %}{{ phone }}</a>
                <a class="td-pg-btn td-pg-btn--outline td-pg-btn--sm" href="{{ page.url }}#fleet-quote">Submit another vehicle list</a>
              </div>
            </div>
          {%- else -%}
            {%- if form.errors -%}
              <div class="td-pg-card td-pg-fleet__state td-pg-fleet__state--err" role="alert" tabindex="-1" data-focus>
                {% render 'td-pg-icon', name: 'phone', size: 36 %}
                <h3 class="td-pg-h3">That quote did not go through</h3>
                <div class="td-pg-body td-pg-mt1 td-pg-fleet__errors">{{ form.errors | default_errors }}</div>
                <p class="td-pg-body td-pg-mt2">Your list did not arrive, so nobody here is working on it yet. Fix the field above and send it again, or call <a href="{{ phone_href }}">{{ phone }}</a> during shop hours and ask for fleet service — we can price the list while you are on the line.</p>
                {%- if ss.email != blank -%}<p class="td-pg-body td-pg-mt2">Rather write it out? Send the same details to <a href="mailto:{{ ss.email }}">{{ ss.email }}</a>.</p>{%- endif -%}
              </div>
            {%- endif -%}

            <div class="td-pg-card td-pg-fleet__form" data-fleet-form>
              <input type="hidden" name="contact[Topic]" value="Fleet quote">
              <div class="td-pg-fleet__fields">
                <div class="td-pg-field">
                  <label for="{{ uid }}-company">Company name</label>
                  <input id="{{ uid }}-company" name="contact[Company]" type="text" autocomplete="organization" required
                    data-msg="Enter your company name." aria-describedby="{{ uid }}-company-err">
                  <p class="td-pg-field__err" id="{{ uid }}-company-err" hidden></p>
                </div>
                <div class="td-pg-field">
                  <label for="{{ uid }}-name">Contact name</label>
                  <input id="{{ uid }}-name" name="contact[name]" type="text" autocomplete="name" required
                    data-msg="Tell us who we should ask for." aria-describedby="{{ uid }}-name-err">
                  <p class="td-pg-field__err" id="{{ uid }}-name-err" hidden></p>
                </div>
                <div class="td-pg-field">
                  <label for="{{ uid }}-phone">Phone</label>
                  <input id="{{ uid }}-phone" name="contact[phone]" type="tel" autocomplete="tel" placeholder="(555) 555-5555" required
                    data-msg="A phone number gets you a faster quote." data-phone aria-describedby="{{ uid }}-phone-err">
                  <p class="td-pg-field__err" id="{{ uid }}-phone-err" hidden></p>
                </div>
                <div class="td-pg-field">
                  <label for="{{ uid }}-email">Email</label>
                  <input id="{{ uid }}-email" name="contact[email]" type="email" autocomplete="email" spellcheck="false" autocapitalize="off" required
                    data-msg="Enter an email for the written quote." data-email
                    {% if form.errors contains 'email' %}aria-invalid="true"{% endif %} aria-describedby="{{ uid }}-email-err">
                  <p class="td-pg-field__err" id="{{ uid }}-email-err" hidden></p>
                </div>
                <div class="td-pg-field">
                  <label for="{{ uid }}-fleet">Fleet size</label>
                  <select id="{{ uid }}-fleet" name="contact[Fleet size]" required data-msg="Choose your fleet size." aria-describedby="{{ uid }}-fleet-err">
                    <option value="">Select a range</option>
                    {%- assign ranges = ss.fleet_sizes | newline_to_br | split: '<br />' -%}
                    {%- for r in ranges -%}{%- assign r = r | strip -%}{%- if r != blank -%}
                      <option value="{{ r | escape }}">{{ r }}</option>
                    {%- endif -%}{%- endfor -%}
                  </select>
                  <p class="td-pg-field__err" id="{{ uid }}-fleet-err" hidden></p>
                </div>
                <div class="td-pg-field">
                  <label for="{{ uid }}-sizes">Tire sizes needed</label>
                  <input id="{{ uid }}-sizes" name="contact[Tire sizes]" type="text" placeholder="245/75R16, 225/75R16" required
                    data-msg="List at least one tire size, e.g. 245/75R16." aria-describedby="{{ uid }}-sizes-err">
                  <p class="td-pg-field__err" id="{{ uid }}-sizes-err" hidden></p>
                </div>
                <div class="td-pg-field td-pg-field--wide">
                  <label for="{{ uid }}-body">Anything else (optional)</label>
                  <textarea id="{{ uid }}-body" name="contact[body]" rows="4" placeholder="Yard address, preferred service window, current tire brand, PO requirements."></textarea>
                </div>
              </div>
              <button type="submit" class="td-pg-btn td-pg-btn--primary td-pg-fleet__submit">{{ ss.submit_label | default: 'Request fleet quote' }}</button>
              <p class="td-pg-fleet__note">{{ ss.privacy_note }}</p>
            </div>
          {%- endif -%}
        {%- endform -%}
      </div>

      <aside class="td-pg-card td-pg-card--pad td-pg-fleet__aside" aria-labelledby="td-pg-{{ section.id }}-talk">
        <h2 class="td-pg-h3" id="td-pg-{{ section.id }}-talk">{{ ss.aside_heading | default: 'Talk to a fleet specialist' }}</h2>
        <p class="td-pg-body td-pg-mt1">{{ ss.aside_text }}</p>
        <a class="td-pg-btn td-pg-btn--primary td-pg-btn--sm td-pg-fleet__full" href="{{ phone_href }}">{% render 'td-pg-icon', name: 'phone', size: 16 %}{{ phone }}</a>

        <h3 class="td-pg-fleet__label">Shop hours</h3>
        {%- assign rows = ss.hours | newline_to_br | split: '<br />' -%}
        <dl class="td-pg-fleet__hours">
          {%- for row in rows -%}{%- assign parts = row | strip | split: '|' -%}{%- if parts.size > 1 -%}
            <div><dt>{{ parts[0] | strip }}</dt><dd>{{ parts[1] | strip }}</dd></div>
          {%- endif -%}{%- endfor -%}
        </dl>

        <h3 class="td-pg-fleet__label">Shop address</h3>
        <p class="td-pg-body">{{ ss.address }}</p>
        {%- if ss.maps_url != blank -%}
          <a class="td-pg-btn td-pg-btn--outline td-pg-btn--sm td-pg-fleet__full" href="{{ ss.maps_url }}" target="_blank" rel="noopener">Get directions<span class="td-pg-sr"> (opens in a new tab)</span></a>
        {%- endif -%}

        <h3 class="td-pg-fleet__label">Shipping</h3>
        <p class="td-pg-body">{{ ss.aside_shipping }}</p>

        <h3 class="td-pg-fleet__label">On-site install</h3>
        <p class="td-pg-body">{{ ss.aside_install }}</p>
      </aside>
    </div>
  </section>
</div>

<script>
  (function () {
    var root = document.getElementById('td-pg-{{ section.id }}');
    if (!root) return;

    // After a post, move focus to the success or error message so it is announced.
    var state = root.querySelector('[data-focus]');
    if (state) {
      var quote = document.getElementById('fleet-quote');
      if (quote && quote.scrollIntoView) quote.scrollIntoView();
      state.focus({ preventScroll: true });
    }

    var box = root.querySelector('[data-fleet-form]');
    if (!box) return;
    var form = box.closest('form');
    // The script takes over from the browser's bubbles so the messages match React's.
    form.setAttribute('novalidate', '');
    var fields = box.querySelectorAll('[data-msg]');

    function check(el) {
      var v = (el.value || '').trim();
      var msg = '';
      if (!v) msg = el.getAttribute('data-msg');
      else if (el.hasAttribute('data-phone') && v.replace(/\D/g, '').length < 10) msg = 'Enter a 10-digit phone number.';
      else if (el.hasAttribute('data-email') && !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v)) msg = 'That email address does not look right.';
      var err = document.getElementById(el.getAttribute('aria-describedby'));
      if (err) { err.textContent = msg; err.hidden = !msg; }
      if (msg) el.setAttribute('aria-invalid', 'true'); else el.removeAttribute('aria-invalid');
      return !msg;
    }

    form.addEventListener('submit', function (e) {
      var first = null;
      Array.prototype.forEach.call(fields, function (el) { if (!check(el) && !first) first = el; });
      if (first) { e.preventDefault(); first.focus(); return; }
      var btn = form.querySelector('button[type="submit"]');
      if (btn) { btn.disabled = true; btn.textContent = 'Sending…'; }
    });
    Array.prototype.forEach.call(fields, function (el) {
      el.addEventListener('change', function () { if (el.getAttribute('aria-invalid')) check(el); });
      el.addEventListener('input', function () { if (el.getAttribute('aria-invalid')) check(el); });
    });
  })();
</script>

<style>
  /* ---- Commercial page only ---- */
  .td-pg-fleet__hero-btns { flex-direction: row; flex-wrap: wrap; }
  .td-pg-fleet__vicon { margin-bottom: .75rem; }
  .td-pg-fleet .td-pg-card .td-pg-fleet__vicon + h3 { margin-top: 0; }
  .td-pg-fleet__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .75rem; list-style: none; margin: 0; padding: 0; }
  .td-pg-fleet__empty { display: grid; gap: .75rem; justify-items: start; padding: 1.5rem; }
  .td-pg-fleet__empty > .td-pg-icon { color: #0068E8; }
  .td-pg-fleet__empty .td-pg-body { max-width: 40rem; }
  .td-pg-fleet__empty .td-pg-btns { margin-top: .5rem; }
  .td-pg-fleet__quote { scroll-margin-top: 5rem; }
  .td-pg-fleet__layout { display: grid; gap: 2.5rem; }
  .td-pg-fleet__main { min-width: 0; }
  .td-pg-fleet__form { padding: 1.5rem; }
  .td-pg-fleet__fields { display: grid; gap: 1.25rem; }
  .td-pg-field label { display: block; margin-bottom: .375rem; font-family: var(--font-heading--family, inherit); font-size: .6875rem;
    font-weight: 700; letter-spacing: .07em; text-transform: uppercase; color: #586274; }
  .td-pg-field input, .td-pg-field select, .td-pg-field textarea { display: block; width: 100%; min-height: 44px; padding: .625rem .875rem;
    border-radius: 6px; border: 1px solid rgba(7,14,26,.12); background: #FFFFFF; color: #070E1A; font: inherit; font-size: 16px;
    box-shadow: inset 0 1px 2px rgba(7,14,26,.04); }
  .td-pg-field textarea { resize: vertical; }
  .td-pg-field ::placeholder { color: rgba(88,98,116,.75); }
  .td-pg-field input:focus, .td-pg-field select:focus, .td-pg-field textarea:focus { border-color: #0068E8; outline: 2px solid rgba(0,104,232,.35); outline-offset: 0; }
  .td-pg-field [aria-invalid="true"] { border-color: #0068E8; }
  .td-pg-field__err { margin-top: .25rem !important; font-size: .75rem; font-weight: 500; color: #0068E8; }
  .td-pg-fleet__submit { width: 100%; margin-top: 1.5rem; }
  .td-pg-fleet__submit:disabled { opacity: .6; cursor: not-allowed; }
  .td-pg-fleet__note { margin-top: .75rem !important; font-size: .75rem; color: #586274; }
  .td-pg-fleet__state { padding: 2rem; margin-bottom: 1.5rem; border-left: 4px solid #0068E8; }
  .td-pg-fleet__state > .td-pg-icon { margin-bottom: 1rem; color: #0068E8; }
  .td-pg-fleet__state--err { border-left-color: #F5A623; }
  .td-pg-fleet__state:focus { outline: 2px solid #0068E8; outline-offset: 2px; }
  .td-pg-fleet__errors ul { margin: .25rem 0 0; padding-left: 1.25rem; list-style: disc; }
  .td-pg-fleet__aside { height: fit-content; }
  .td-pg-fleet__full { width: 100%; margin-top: 1rem; }
  .td-pg-fleet__label { margin: 1.5rem 0 .375rem !important; font-size: .6875rem !important; font-weight: 700 !important; letter-spacing: .07em !important;
    text-transform: uppercase; color: #586274; font-variation-settings: normal !important; }
  .td-pg-fleet__hours { display: grid; gap: .25rem; font-size: .875rem; }
  .td-pg-fleet__hours div { display: flex; justify-content: space-between; gap: 1rem; }
  .td-pg-fleet__hours dt { color: #586274; }
  .td-pg-fleet__hours dd { font-weight: 500; color: #070E1A; }
  @media (min-width: 640px) {
    .td-pg-fleet__grid { gap: 1.25rem; }
    .td-pg-fleet__fields { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .td-pg-field--wide { grid-column: 1 / -1; }
    .td-pg-fleet__submit { width: auto; }
    .td-pg-fleet__empty { padding: 2rem; }
  }
  @media (min-width: 768px) { .td-pg-fleet__form { padding: 2rem; } }
  @media (min-width: 1024px) { .td-pg-fleet__layout { grid-template-columns: minmax(0, 1fr) 380px; } }
  @media (min-width: 1280px) { .td-pg-fleet__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
</style>

{% schema %}
{
  "name": "TireDrop fleet page",
  "tag": "div",
  "class": "td-pg-section",
  "settings": [
    { "type": "text", "id": "phone", "label": "Phone number", "default": "(954) 773-1896", "info": "Written anywhere copy says [phone], and dialled by the call buttons." },
    { "type": "text", "id": "email", "label": "Email shown if a quote fails", "default": "info@tiredroponline.com" },
    { "type": "text", "id": "crumb", "label": "Breadcrumb label", "default": "Commercial Tires" },
    { "type": "header", "content": "Hero" },
    { "type": "text", "id": "hero_eyebrow", "label": "Eyebrow", "default": "Commercial" },
    { "type": "text", "id": "hero_heading", "label": "Heading", "default": "Fleet & Commercial Tires" },
    { "type": "textarea", "id": "hero_lede", "label": "Lede" },
    { "type": "text", "id": "hero_cta_label", "label": "Quote button", "default": "Request a quote" },
    { "type": "header", "content": "Why fleets call" },
    { "type": "text", "id": "why_eyebrow", "label": "Eyebrow", "default": "Why fleets call us" },
    { "type": "text", "id": "why_heading", "label": "Heading", "default": "Downtime is the expensive part" },
    { "type": "textarea", "id": "why_lede", "label": "Lede" },
    { "type": "header", "content": "Catalog" },
    { "type": "collection", "id": "collection", "label": "Commercial tire collection", "info": "Up to eight products show here. Leave empty (or empty the collection) and a call-or-quote panel shows instead." },
    { "type": "text", "id": "cat_eyebrow", "label": "Eyebrow", "default": "In the catalog" },
    { "type": "text", "id": "cat_heading", "label": "Heading", "default": "Commercial tires we ship" },
    { "type": "textarea", "id": "cat_lede", "label": "Lede (shown only when products are listed)" },
    { "type": "text", "id": "cat_link_label", "label": "Catalog button", "default": "View in the tire catalog" },
    { "type": "url", "id": "cat_link", "label": "Catalog link" },
    { "type": "text", "id": "empty_heading", "label": "No-products heading", "default": "Commercial sizes are priced per quote" },
    { "type": "textarea", "id": "empty_text", "label": "No-products text" },
    { "type": "header", "content": "Quote form" },
    { "type": "text", "id": "quote_eyebrow", "label": "Eyebrow", "default": "Fleet quote" },
    { "type": "text", "id": "quote_heading", "label": "Heading", "default": "Request a quote" },
    { "type": "textarea", "id": "quote_lede", "label": "Lede" },
    { "type": "textarea", "id": "fleet_sizes", "label": "Fleet size options (one per line)", "default": "1–5 vehicles\n6–15 vehicles\n16–40 vehicles\n40+ vehicles" },
    { "type": "text", "id": "submit_label", "label": "Submit button", "default": "Request fleet quote" },
    { "type": "text", "id": "privacy_note", "label": "Note under the button", "default": "We use these details to price your quote and schedule service — nothing else." },
    { "type": "text", "id": "ok_heading", "label": "Success heading", "default": "Quote request received" },
