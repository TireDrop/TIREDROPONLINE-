{% comment %}
  Cart page, laid out like the React /cart: line items with a quantity
  stepper and remove link, a delivery choice, trust cards, and an order
  summary rail with the checkout button.

  Everything posts through Shopify's own cart form: quantities as updates[],
  the delivery choice as the cart attribute attributes[Delivery], and the
  checkout button as name="checkout". The delivery choice is recorded on the
  order for the shop to act on; it does not add an install charge, because
  the store has no install product to charge.
{% endcomment %}
{%- liquid
  assign ss = section.settings
  assign phone = ss.phone | default: '(954) 773-1896'
  assign phone_href = phone | remove: '(' | remove: ')' | remove: ' ' | remove: '-' | prepend: 'tel:+1'
  assign sid = section.id
  assign delivery = cart.attributes.Delivery | default: ss.ship_value
-%}

<div class="td-shop td-cart" id="td-cart-{{ sid }}">
  {%- render 'td-collection-base' -%}

  <nav class="td-shop-crumbs" aria-label="Breadcrumb">
    <ol class="td-shop-wrap">
      <li><a href="{{ routes.root_url }}">Home</a></li>
      <li><span aria-current="page">Cart</span></li>
    </ol>
  </nav>

  <div class="td-shop-wrap td-cart__page">
    <header class="td-cart__head">
      {%- if ss.eyebrow != blank -%}<p class="td-shop-eyebrow">{{ ss.eyebrow }}</p>{%- endif -%}
      <h1 class="td-shop-h1">{{ ss.heading }}</h1>
      <p class="td-shop-lede td-cart__lede">
        {%- if cart.item_count > 0 -%}
          {{ cart.item_count }} {% if cart.item_count == 1 %}item{% else %}items{% endif %} ready to ship. {{ ss.lede_suffix }}
        {%- else -%}
          Nothing in here yet.
        {%- endif -%}
      </p>
    </header>

    {%- if cart.item_count == 0 -%}
      <div class="td-shop-card td-shop-empty">
        <span class="td-shop-empty__icon" aria-hidden="true">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/></svg>
        </span>
        <h2 class="td-shop-empty__title">Your cart is empty</h2>
        <p class="td-shop-empty__lede">{{ ss.empty_lede }}</p>
        <div class="td-shop-empty__actions">
          <a href="/collections/tires" class="td-shop-btn td-shop-btn--primary">Shop Tires</a>
          <a href="/collections/wheels" class="td-shop-btn td-shop-btn--outline">Shop Wheels</a>
        </div>
      </div>
    {%- else -%}
      <form action="{{ routes.cart_url }}" method="post" id="td-cart-form-{{ sid }}" class="td-cart__grid" data-td-cart-form novalidate>
        <section aria-label="Cart items" class="td-cart__items">
          <ul class="td-cart__lines" role="list">
            {%- for item in cart.items -%}
              {%- liquid
                capture td_specs
                  render 'td-product-specs', product: item.product, variant: item.variant
                endcapture
                assign td_spec = td_specs | split: '~~'
                assign kind = td_spec[0] | strip
                assign name = td_spec[1] | strip
                assign size = td_spec[2] | strip
                if name == ''
                  assign name = item.product_title
                endif
                assign qid = 'td-qty-' | append: sid | append: '-' | append: forloop.index
              -%}
              <li class="td-cart__line">
                <a href="{{ item.url }}" class="td-cart__thumb" tabindex="-1" aria-hidden="true">
                  {%- if item.image -%}
                    <img src="{{ item.image | image_url: width: 220 }}" alt="" width="104" height="104" loading="lazy">
                  {%- else -%}
                    {%- render 'td-product-art', kind: kind, size: 88 -%}
                  {%- endif -%}
                </a>
                <div class="td-cart__info">
                  <div class="td-cart__top">
                    <div class="td-cart__name">
                      {%- if item.vendor != blank -%}<p class="td-cart__brand">{{ item.vendor }}</p>{%- endif -%}
                      <h2 class="td-shop-h3 td-cart__title"><a href="{{ item.url }}">{{ name }}</a></h2>
                      {%- if size != '' -%}
                        <p class="td-cart__size">Size <span>{{ size }}</span></p>
                      {%- elsif item.variant_title != blank and item.product.has_only_default_variant == false -%}
                        <p class="td-cart__size">{{ item.variant_title }}</p>
                      {%- endif -%}
                      {%- for p in item.properties -%}
                        {%- assign first_char = p.first | slice: 0 -%}
                        {%- if p.last != blank and first_char != '_' -%}<p class="td-cart__size">{{ p.first }}: <span>{{ p.last }}</span></p>{%- endif -%}
                      {%- endfor -%}
                    </div>
                    <div class="td-cart__price tnum">
                      <p class="td-cart__linetotal">{{ item.final_line_price | money }}</p>
                      {%- if item.original_line_price > item.final_line_price -%}
                        <p class="td-cart__each"><s>{{ item.original_line_price | money }}</s></p>
                      {%- endif -%}
                      <p class="td-cart__each">{{ item.final_price | money }} each</p>
                    </div>
                  </div>

                  <div class="td-cart__controls">
                    <div class="td-cart__qty">
                      <label for="{{ qid }}" class="td-shop-label">Qty</label>
                      <div class="td-cart__stepper">
                        <button type="button" class="td-cart__step" data-td-step="-1" data-target="{{ qid }}" aria-label="Decrease quantity of {{ item.product_title | escape }}"{% if item.quantity <= 1 %} disabled{% endif %}>
                          <svg aria-hidden="true" focusable="false" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14"/></svg>
                        </button>
                        <input id="{{ qid }}" class="td-cart__qtyinput tnum" type="number" name="updates[]" value="{{ item.quantity }}" min="0" max="99" inputmode="numeric" data-td-qty>
                        <button type="button" class="td-cart__step" data-td-step="1" data-target="{{ qid }}" aria-label="Increase quantity of {{ item.product_title | escape }}">
                          <svg aria-hidden="true" focusable="false" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M12 5v14"/></svg>
                        </button>
                      </div>
                    </div>
                    <a href="{{ item.url_to_remove }}" class="td-cart__remove" aria-label="Remove {{ item.product_title | escape }}">
                      <svg aria-hidden="true" focusable="false" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
                      Remove
                    </a>
                  </div>
                </div>
              </li>
            {%- endfor -%}
          </ul>

          <div class="td-cart__update">
            <button type="submit" name="update" class="td-shop-btn td-shop-btn--outline td-shop-btn--sm" data-td-update>Update quantities</button>
          </div>

          <fieldset class="td-cart__delivery">
            <legend class="td-shop-label">Delivery</legend>
            <div class="td-cart__options">
              <label class="td-cart__option" for="td-del-ship-{{ sid }}">
                <input type="radio" id="td-del-ship-{{ sid }}" name="attributes[Delivery]" value="{{ ss.ship_value | escape }}"{% if delivery != ss.store_value %} checked{% endif %} data-td-delivery>
                <span>
                  <span class="td-cart__optitle">{{ ss.ship_title }}</span>
                  <span class="td-cart__optcopy">{{ ss.ship_copy }}</span>
                </span>
              </label>
              <label class="td-cart__option" for="td-del-store-{{ sid }}">
                <input type="radio" id="td-del-store-{{ sid }}" name="attributes[Delivery]" value="{{ ss.store_value | escape }}"{% if delivery == ss.store_value %} checked{% endif %} data-td-delivery>
                <span>
                  <span class="td-cart__optitle">{{ ss.store_title }} <span class="td-cart__local">South Florida only</span></span>
                  <span class="td-cart__optcopy">{{ ss.store_copy }}</span>
                </span>
              </label>
            </div>
          </fieldset>

          <div class="td-cart__after">
            <a href="/collections/tires" class="td-shop-btn td-shop-btn--outline td-shop-btn--sm">Keep Shopping</a>
            <a href="{{ ss.install_link | default: '/pages/install' }}" class="td-cart__howlink">How ship-to-store install works</a>
          </div>

          <div class="td-cart__trust">
            {%- for block in section.blocks -%}
              <div class="td-shop-card td-cart__trustcard" {{ block.shopify_attributes }}>
                {%- case block.settings.icon -%}
                  {%- when 'shield' -%}
                    <svg aria-hidden="true" focusable="false" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>
                  {%- when 'phone' -%}
                    <svg aria-hidden="true" focusable="false" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                  {%- else -%}
                    <svg aria-hidden="true" focusable="false" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.62l-3.48-4.35A1 1 0 0 0 17.52 8H14"/><circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/></svg>
                {%- endcase -%}
                <p class="td-cart__trusttitle">{{ block.settings.title }}</p>
                <p class="td-cart__trustcopy">{{ block.settings.copy }}</p>
              </div>
            {%- endfor -%}
          </div>
        </section>

        <aside aria-label="Order summary" class="td-cart__aside">
          <div class="td-shop-card td-cart__summary">
            <h2 class="td-shop-h3">Order Summary</h2>
            <dl class="td-cart__totals tnum">
              <div>
                <dt>Tires &amp; wheels</dt>
                <dd>{{ cart.items_subtotal_price | money }}</dd>
              </div>
              {%- if cart.cart_level_discount_applications.size > 0 -%}
                {%- for d in cart.cart_level_discount_applications -%}
                  <div><dt>{{ d.title | escape }}</dt><dd>− {{ d.total_allocated_amount | money }}</dd></div>
                {%- endfor -%}
              {%- endif -%}
              <div>
                <dt>Shipping</dt>
                <dd><span class="td-shop-badge td-shop-badge--amber">Free</span></dd>
              </div>
              <div>
                <dt>Taxes</dt>
                <dd class="td-cart__muted">Calculated at checkout</dd>
              </div>
            </dl>
            <div class="td-cart__grand">
              <span>Estimated total</span>
              <span class="tnum td-cart__grandval">{{ cart.total_price | money }}</span>
            </div>
            <button type="submit" name="checkout" class="td-shop-btn td-shop-btn--primary td-shop-btn--block td-cart__checkout">Checkout</button>
            <p class="td-cart__fine">{{ ss.checkout_note }}</p>
            <div class="td-cart__help">
              <svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
              <p>Questions on fitment or load rating? Call <a href="{{ phone_href }}">{{ phone }}</a> and talk to a tech before you check out.</p>
            </div>
          </div>
        </aside>
      </form>
    {%- endif -%}
  </div>
</div>

<style>
  .td-cart__page { padding-top: 2.5rem; padding-bottom: 2.5rem; }
  .td-cart__head { margin-bottom: 2rem; }
  .td-cart__head .td-shop-eyebrow { margin-bottom: .5rem !important; }
  .td-cart__lede { margin-top: .75rem !important; max-width: 42rem; }
  @media (min-width: 768px) {
    .td-cart__page { padding-top: 3.5rem; padding-bottom: 3.5rem; }
    .td-cart__head { margin-bottom: 2.5rem; }
  }
  .td-cart__grid { display: grid; gap: 2.5rem; margin: 0; }
  @media (min-width: 1024px) { .td-cart__grid { grid-template-columns: minmax(0,1fr) 380px; gap: 3rem; align-items: start; } }
  .td-cart__items, .td-cart__aside { min-width: 0; }
  .td-cart__lines { list-style: none; margin: 0; padding: 0; border-top: 1px solid rgba(7,14,26,.1); border-bottom: 1px solid rgba(7,14,26,.1); }
  .td-cart__line { display: grid; grid-template-columns: 72px minmax(0,1fr); gap: 1rem; padding: 1.5rem 0; }
  .td-cart__line + .td-cart__line { border-top: 1px solid rgba(7,14,26,.1); }
  @media (min-width: 640px) { .td-cart__line { grid-template-columns: 104px minmax(0,1fr); gap: 1.5rem; } }
  .td-cart__thumb { display: flex; align-items: center; justify-content: center; aspect-ratio: 1 / 1; overflow: hidden; border-radius: 6px; background: var(--td-fog); padding: .5rem; }
  .td-cart__thumb img, .td-cart__thumb svg { width: 100%; height: 100%; object-fit: contain; }
  .td-cart__top { display: flex; flex-wrap: wrap; align-items: flex-start; justify-content: space-between; gap: .5rem 1.5rem; }
  .td-cart__name { min-width: 0; }
  .td-cart__brand { font-family: var(--td-display); font-size: 12px; text-transform: uppercase; letter-spacing: .09em; color: var(--td-smoke); }
  .td-cart__title { margin-top: .125rem !important; overflow-wrap: anywhere; }
  .td-cart__title a { text-decoration: none; }
  .td-cart__title a:hover { color: var(--td-drop); }
  .td-cart__size { margin-top: .25rem !important; font-size: 14px; color: var(--td-smoke); }
  .td-cart__size span { color: var(--td-ink); }
  .td-cart__price { text-align: right; }
  .td-cart__linetotal { font-family: var(--td-display); font-size: 1.5rem; line-height: 1; letter-spacing: -.025em; }
  .td-cart__each { margin-top: .25rem !important; font-size: 12px; color: var(--td-smoke); }
  .td-cart__controls { margin-top: 1rem; display: flex; flex-wrap: wrap; align-items: center; gap: .75rem 1.25rem; }
  .td-cart__qty { display: flex; align-items: center; gap: .5rem; }
  .td-cart__qty .td-shop-label { margin: 0; }
  .td-cart__stepper { display: flex; align-items: center; border: 1px solid rgba(7,14,26,.15); border-radius: 6px; background: #FFFFFF; }
  .td-cart__step { display: grid; place-items: center; width: 44px; height: 44px; border: 0; background: transparent; color: var(--td-ink); cursor: pointer; }
  .td-cart__step:hover { background: var(--td-fog); }
  .td-cart__step:disabled { opacity: .35; cursor: default; }
  .td-cart__qtyinput { width: 3rem; height: 44px; border: 0; border-left: 1px solid rgba(7,14,26,.15); border-right: 1px solid rgba(7,14,26,.15); text-align: center; font-family: var(--td-display); font-size: 1rem; color: var(--td-ink); background: #FFFFFF; -moz-appearance: textfield; }
  .td-cart__qtyinput::-webkit-inner-spin-button, .td-cart__qtyinput::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }
  .td-cart__remove { display: inline-flex; align-items: center; gap: .375rem; min-height: 44px; font-size: 14px; color: var(--td-smoke) !important; text-decoration: none; }
  .td-cart__remove:hover { color: var(--td-drop) !important; }
  .td-cart__update { margin-top: 1rem; }
  .js-td .td-cart__update { display: none; }

  .td-cart__delivery { margin: 1.5rem 0 0; padding: 0; border: 0; min-width: 0; }
  .td-cart__delivery legend { padding: 0; }
  .td-cart__options { display: grid; gap: .75rem; }
  @media (min-width: 768px) { .td-cart__options { grid-template-columns: repeat(2, minmax(0,1fr)); } }
  .td-cart__option { display: flex; align-items: flex-start; gap: .75rem; padding: 1rem; border: 1px solid rgba(7,14,26,.15); border-radius: 6px; background: #FFFFFF; cursor: pointer; }
  .td-cart__option:has(input:checked) { border-color: var(--td-drop); background: rgba(0,104,232,.05); }
  .td-cart__option input { margin-top: -2px; }
  .td-cart__optitle { display: block; font-family: var(--td-display); font-size: 1rem; font-weight: 700; line-height: 1.3; }
  .td-cart__local { display: inline-block; margin-left: .25rem; font-family: var(--td-body); font-size: 12px; font-weight: 500; color: var(--td-drop); white-space: nowrap; }
  .td-cart__optcopy { display: block; margin-top: .25rem; font-size: 13px; line-height: 1.5; color: var(--td-smoke); }

  .td-cart__after { margin-top: 1.5rem; display: flex; flex-wrap: wrap; align-items: center; gap: .75rem; }
  .td-cart__howlink { display: inline-flex; align-items: center; min-height: 44px; font-size: 14px; color: var(--td-smoke) !important; text-underline-offset: 4px; }
  .td-cart__howlink:hover { color: var(--td-drop) !important; }
  .td-cart__trust { margin-top: 2.5rem; display: grid; gap: 1rem; }
  @media (min-width: 640px) { .td-cart__trust { grid-template-columns: repeat(3, minmax(0,1fr)); } }
  .td-cart__trustcard { padding: 1rem; }
  .td-cart__trustcard svg { color: var(--td-drop); }
  .td-cart__trusttitle { margin-top: .75rem !important; font-family: var(--td-display); font-size: 1rem; font-weight: 700; line-height: 1.25; }
  .td-cart__trustcopy { margin-top: .25rem !important; font-size: 12px; line-height: 1.625; color: var(--td-smoke); }

  .td-cart__summary { padding: 1.5rem; }
  @media (min-width: 1024px) { .td-cart__summary { position: sticky; top: calc(var(--header-height, 0px) + 1.5rem); } }
  .td-cart__totals { margin: 1.25rem 0 0; font-size: 14px; }
  .td-cart__totals > div { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; }
  .td-cart__totals > div + div { margin-top: .75rem; }
  .td-cart__totals dt { color: var(--td-smoke); }
  .td-cart__totals dd { margin: 0; font-family: var(--td-display); font-size: 1rem; }
  .td-cart__totals dd.td-cart__muted { font-family: var(--td-body); font-size: 14px; color: var(--td-smoke); }
  .td-cart__grand { margin-top: 1.25rem; padding-top: 1.25rem; border-top: 1px solid rgba(7,14,26,.1); display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; font-family: var(--td-display); font-size: 1.125rem; font-weight: 700; }
  .td-cart__grandval { font-size: 1.875rem; font-weight: 400; line-height: 1; letter-spacing: -.025em; }
  .td-cart__checkout { margin-top: 1.25rem; min-height: 48px; }
  .td-cart__fine { margin-top: .75rem !important; text-align: center; font-size: 12px; line-height: 1.625; color: var(--td-smoke); }
  .td-cart__help { margin-top: 1.5rem; padding-top: 1.25rem; border-top: 1px solid rgba(7,14,26,.1); display: flex; align-items: flex-start; gap: .625rem; }
  .td-cart__help svg { flex-shrink: 0; margin-top: 2px; color: var(--td-smoke); }
  .td-cart__help p { font-size: 12px; line-height: 1.625; color: var(--td-smoke); }
  .td-cart__help a { color: var(--td-ink); }
</style>

<script>
  (function () {
    var root = document.getElementById("td-cart-{{ sid }}");
    var form = root && root.querySelector("[data-td-cart-form]");
    if (!form) return;
    root.classList.add("js-td");
    var update = form.querySelector("[data-td-update]");
    var submitUpdate = function () {
      if (form.requestSubmit) form.requestSubmit(update); else update.click();
    };
    form.querySelectorAll("[data-td-step]").forEach(function (b) {
      b.addEventListener("click", function () {
        var input = document.getElementById(b.dataset.target);
        input.value = Math.max(1, Math.min(99, (parseInt(input.value, 10) || 1) + Number(b.dataset.tdStep)));
        submitUpdate();
      });
    });
    form.querySelectorAll("[data-td-qty]").forEach(function (input) {
      input.addEventListener("change", function () {
        var n = parseInt(input.value, 10);
        input.value = isNaN(n) ? 1 : Math.max(0, Math.min(99, n));
        submitUpdate();
      });
    });
    // Saves the delivery choice straight away, so it survives a reload; the
    // same field also posts with the checkout button.
    form.querySelectorAll("[data-td-delivery]").forEach(function (r) {
      r.addEventListener("change", function () {
        fetch({{ routes.cart_update_url | append: '.js' | json }}, {
          method: "POST",
          headers: { "Content-Type": "application/json", Accept: "application/json" },
          body: JSON.stringify({ attributes: { Delivery: r.value } }),
        }).catch(function () {});
      });
    });
  })();
</script>

{% schema %}
{
  "name": "TireDrop cart",
  "tag": "section",
  "class": "td-section-cart",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Tires shipped. Or installed." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your Cart" },
    { "type": "text", "id": "lede_suffix", "label": "Intro after the item count", "default": "Local to South Florida? Choose free ship-to-store below and we'll fit them for you." },
    { "type": "textarea", "id": "empty_lede", "label": "Empty cart text", "default": "Pick a set of tires or a new set of wheels and we'll ship them anywhere in the continental US." },
    { "type": "header", "content": "Delivery choice (cart attribute \"Delivery\")" },
    { "type": "text", "id": "ship_value", "label": "Ship-to-me value", "default": "Ship to my address" },
    { "type": "text", "id": "ship_title", "label": "Ship-to-me title", "default": "Ship it to me" },
