{% comment %}
  Ship to store & install — the Shopify port of src/pages/InstallPage.jsx.

  React's "Book an install" buttons go to its /schedule booking flow, which is
  not part of the Shopify theme. Here they go to the contact page with
  ?topic=install (the booking_url setting), and the phone is always offered
  beside them. Dark bands pin their text to white.
{% endcomment %}
{%- liquid
  assign ss = section.settings
  assign phone = ss.phone | default: '(954) 773-1896'
  assign phone_digits = phone | remove: '(' | remove: ')' | remove: ' ' | remove: '-' | remove: '.'
  assign phone_href = 'tel:+1' | append: phone_digits
  assign booking_url = ss.booking_url | default: '/pages/contact?topic=install'
-%}
{%- render 'td-pg-kit' -%}

<div class="td-pg td-pg-inst" id="td-pg-{{ section.id }}">
  <nav class="td-pg-crumbs" aria-label="Breadcrumb">
    <ol class="td-pg-wrap">
      <li><a href="{{ routes.root_url }}">Home</a></li>
      {%- if ss.crumb_parent != blank -%}
        <li>{% render 'td-pg-icon', name: 'chevron-right', size: 13 %}<a href="{{ ss.crumb_parent_link | default: '/pages/shipping' }}">{{ ss.crumb_parent }}</a></li>
      {%- endif -%}
      <li>{% render 'td-pg-icon', name: 'chevron-right', size: 13 %}<span aria-current="page">{{ ss.crumb | default: 'Ship to store & install' }}</span></li>
    </ol>
  </nav>

  <header class="td-pg-hero">
    <div class="td-pg-wrap td-pg-hero__inner">
      {%- if ss.hero_eyebrow != blank -%}<p class="td-pg-eyebrow">{{ ss.hero_eyebrow }}</p>{%- endif -%}
      <h1>{{ ss.hero_heading }}</h1>
      {%- if ss.hero_lede != blank -%}<p class="td-pg-hero__lede">{{ ss.hero_lede }}</p>{%- endif -%}
      <div class="td-pg-hero__extra">
        <div class="td-pg-btns">
          {%- if ss.hero_cta_label != blank -%}
            <a class="td-pg-btn td-pg-btn--primary" href="{{ booking_url }}">{{ ss.hero_cta_label }}{% render 'td-pg-icon', name: 'arrow-right', size: 18 %}</a>
          {%- endif -%}
          <a class="td-pg-btn td-pg-btn--ghost" href="{{ phone_href }}">{% render 'td-pg-icon', name: 'phone', size: 18 %}Call {{ phone }}</a>
        </div>
        {%- assign checks = ss.hero_checks | newline_to_br | split: '<br />' -%}
        <ul class="td-pg-checks">
          {%- for c in checks -%}{%- assign c = c | strip -%}{%- if c != blank -%}
            <li>{% render 'td-pg-icon', name: 'check', size: 14 %}{{ c }}</li>
          {%- endif -%}{%- endfor -%}
        </ul>
      </div>
    </div>
  </header>

  {%- if ss.notice_lead != blank or ss.notice_text != blank -%}
    <div class="td-pg-notice">
      <div class="td-pg-wrap">
        {% render 'td-pg-icon', name: 'map-pin', size: 18 %}
        <p><strong>{{ ss.notice_lead }}</strong> {{ ss.notice_text }}{% if ss.notice_link_label != blank %} <a href="{{ ss.notice_link | default: '/pages/shipping' }}">{{ ss.notice_link_label }}</a>.{% endif %}</p>
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} ---------- How it works ---------- {%- endcomment -%}
  <section class="td-pg-sec td-pg-sec--bone" aria-labelledby="td-pg-{{ section.id }}-steps">
    <div class="td-pg-wrap">
      <div class="td-pg-head"><div class="td-pg-head__text">
        {%- if ss.steps_eyebrow != blank -%}<p class="td-pg-eyebrow">{{ ss.steps_eyebrow }}</p>{%- endif -%}
        <h2 class="td-pg-h2" id="td-pg-{{ section.id }}-steps">{{ ss.steps_heading }}</h2>
        {%- if ss.steps_lede != blank -%}<p class="td-pg-lede">{{ ss.steps_lede }}</p>{%- endif -%}
      </div></div>
      <ol class="td-pg-grid td-pg-grid--4">
        {%- assign n = 0 -%}
        {%- for block in section.blocks -%}{%- if block.type == 'step' -%}
          {%- assign n = n | plus: 1 -%}
          <li class="td-pg-card td-pg-card--pad td-pg-card--hover td-pg-card--flex td-pg-step" {{ block.shopify_attributes }}>
            <div class="td-pg-step__top">
              <span class="td-pg-step__icon">{% render 'td-pg-icon', name: block.settings.icon, size: 20 %}</span>
              <span class="td-pg-step__num" aria-hidden="true">{% if n < 10 %}0{% endif %}{{ n }}</span>
            </div>
            <h3 class="td-pg-h3">{{ block.settings.title }}</h3>
            <p class="td-pg-body td-pg-mt1">{{ block.settings.body }}</p>
          </li>
        {%- endif -%}{%- endfor -%}
      </ol>
      {%- if ss.price_lead != blank -%}
        <div class="td-pg-card td-pg-callout">
          <p class="td-pg-body"><strong class="td-pg-inst__lead">{{ ss.price_lead }}</strong> {{ ss.price_text }}</p>
          {%- if ss.price_cta_label != blank -%}
            <a class="td-pg-btn td-pg-btn--outline td-pg-btn--sm" href="{{ ss.price_cta_link | default: '/pages/auto-service#tire-installation' }}">{{ ss.price_cta_label }}{% render 'td-pg-icon', name: 'arrow-right', size: 16 %}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </section>

  {%- comment -%} ---------- Why ship to store ---------- {%- endcomment -%}
  <section class="td-pg-sec td-pg-sec--fog" aria-labelledby="td-pg-{{ section.id }}-why">
    <div class="td-pg-wrap">
      <div class="td-pg-head"><div class="td-pg-head__text">
        {%- if ss.why_eyebrow != blank -%}<p class="td-pg-eyebrow">{{ ss.why_eyebrow }}</p>{%- endif -%}
        <h2 class="td-pg-h2" id="td-pg-{{ section.id }}-why">{{ ss.why_heading }}</h2>
        {%- if ss.why_lede != blank -%}<p class="td-pg-lede">{{ ss.why_lede }}</p>{%- endif -%}
      </div></div>
      <div class="td-pg-grid td-pg-grid--4">
        {%- for block in section.blocks -%}{%- if block.type == 'reason' -%}
          <div class="td-pg-card td-pg-card--pad" {{ block.shopify_attributes }}>
            {% render 'td-pg-icon', name: block.settings.icon, size: 22, cls: 'td-pg-icon--lead' %}
            <h3 class="td-pg-h3">{{ block.settings.title }}</h3>
            <p class="td-pg-body td-pg-mt1">{{ block.settings.body }}</p>
          </div>
        {%- endif -%}{%- endfor -%}
      </div>

      <div class="td-pg-grid td-pg-grid--2 td-pg-inst__vs">
        <div class="td-pg-card">
          <div class="td-pg-vs__head td-pg-vs__head--us">{% render 'td-pg-icon', name: 'store', size: 18 %}<h3>{{ ss.vs_us_heading | default: 'Ship to the store' }}</h3></div>
          <ul class="td-pg-vs td-pg-vs--us">
            {%- for block in section.blocks -%}{%- if block.type == 'compare' and block.settings.us != blank -%}
              <li {{ block.shopify_attributes }}>{% render 'td-pg-icon', name: 'check', size: 18 %}<span>{{ block.settings.us }}</span></li>
            {%- endif -%}{%- endfor -%}
          </ul>
        </div>
        <div class="td-pg-card">
          <div class="td-pg-vs__head td-pg-vs__head--them">{% render 'td-pg-icon', name: 'home', size: 18 %}<h3>{{ ss.vs_them_heading | default: 'Ship to your house' }}</h3></div>
          <ul class="td-pg-vs td-pg-vs--them">
            {%- for block in section.blocks -%}{%- if block.type == 'compare' and block.settings.them != blank -%}
              {%- comment -%} TD-FIX: a right-hand item that is also a selling point (them_positive) gets the check icon, not the ✕. {%- endcomment -%}
              {%- if block.settings.them_positive -%}
                <li class="td-pg-vs__pro">{% render 'td-pg-icon', name: 'check', size: 18 %}<span>{{ block.settings.them }}</span></li>
              {%- else -%}
                <li>{% render 'td-pg-icon', name: 'x', size: 18 %}<span>{{ block.settings.them }}</span></li>
              {%- endif -%}
            {%- endif -%}{%- endfor -%}
          </ul>
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} ---------- Install area ---------- {%- endcomment -%}
  <section class="td-pg-sec td-pg-sec--bone" aria-labelledby="td-pg-{{ section.id }}-area">
    <div class="td-pg-wrap">
      <div class="td-pg-head"><div class="td-pg-head__text">
        {%- if ss.area_eyebrow != blank -%}<p class="td-pg-eyebrow">{{ ss.area_eyebrow }}</p>{%- endif -%}
        <h2 class="td-pg-h2" id="td-pg-{{ section.id }}-area">{{ ss.area_heading }}</h2>
        {%- if ss.area_lede != blank -%}<p class="td-pg-lede">{{ ss.area_lede }}</p>{%- endif -%}
      </div></div>
      {%- assign cities = ss.cities | newline_to_br | split: '<br />' -%}
      <ul class="td-pg-chips">
        {%- for city in cities -%}{%- assign city = city | strip -%}{%- if city != blank -%}
          <li>{% render 'td-pg-icon', name: 'map-pin', size: 14 %}{{ city }}</li>
        {%- endif -%}{%- endfor -%}
      </ul>
      {%- if ss.mobile_lead != blank -%}
        <div class="td-pg-card td-pg-callout">
          <p class="td-pg-body"><strong class="td-pg-inst__lead">{{ ss.mobile_lead }}</strong> {{ ss.mobile_text }}</p>
          <a class="td-pg-btn td-pg-btn--dark td-pg-btn--sm" href="{{ ss.mobile_link | default: '/pages/mobile-service' }}">{% render 'td-pg-icon', name: 'truck', size: 16 %}{{ ss.mobile_label | default: 'Mobile install' }}</a>
        </div>
      {%- endif -%}
    </div>
  </section>

  {%- comment -%} ---------- The shop (dark) ---------- {%- endcomment -%}
  <section class="td-pg-sec td-pg-sec--ink" aria-labelledby="td-pg-{{ section.id }}-shop">
    <div class="td-pg-wrap">
      <div class="td-pg-head"><div class="td-pg-head__text">
        {%- if ss.shop_eyebrow != blank -%}<p class="td-pg-eyebrow td-pg-eyebrow--plain">{{ ss.shop_eyebrow }}</p>{%- endif -%}
        <h2 class="td-pg-h2" id="td-pg-{{ section.id }}-shop">{{ ss.shop_heading }}</h2>
        {%- if ss.shop_lede != blank -%}<p class="td-pg-lede td-pg-inst__shop-lede">{{ ss.shop_lede }}</p>{%- endif -%}
      </div></div>
      <div class="td-pg-grid td-pg-grid--3-lg">
        <div class="td-pg-panel">
          {% render 'td-pg-icon', name: 'map-pin', size: 22, cls: 'td-pg-icon--lead' %}
          <h3 class="td-pg-h3">Address</h3>
          <address>{{ ss.address | newline_to_br }}</address>
          {%- if ss.maps_url != blank -%}
            <a class="td-pg-link" href="{{ ss.maps_url }}" target="_blank" rel="noopener">{% render 'td-pg-icon', name: 'map-pin', size: 15 %}Get directions<span class="td-pg-sr"> (opens in a new tab)</span></a>
          {%- endif -%}
        </div>
        <div class="td-pg-panel">
          {% render 'td-pg-icon', name: 'clock', size: 22, cls: 'td-pg-icon--lead' %}
          <h3 class="td-pg-h3">Hours</h3>
          {%- assign rows = ss.hours | newline_to_br | split: '<br />' -%}
          <dl class="td-pg-hours">
            {%- for row in rows -%}{%- assign parts = row | strip | split: '|' -%}{%- if parts.size > 1 -%}
              <div><dt>{{ parts[0] | strip }}</dt><dd>{{ parts[1] | strip }}</dd></div>
            {%- endif -%}{%- endfor -%}
          </dl>
        </div>
        <div class="td-pg-panel td-pg-inst__book">
          {% render 'td-pg-icon', name: 'calendar-check', size: 22, cls: 'td-pg-icon--lead' %}
          <h3 class="td-pg-h3">{{ ss.book_heading | default: 'Book your fitting' }}</h3>
          <p class="td-pg-body td-pg-mt1 td-pg-inst__grow">{{ ss.book_text }}</p>
          <div class="td-pg-inst__book-btns">
            <a class="td-pg-btn td-pg-btn--primary td-pg-btn--sm" href="{{ booking_url }}">{{ ss.book_label | default: 'Book an install' }}{% render 'td-pg-icon', name: 'arrow-right', size: 16 %}</a>
            <a class="td-pg-btn td-pg-btn--ghost td-pg-btn--sm" href="{{ phone_href }}">{% render 'td-pg-icon', name: 'phone', size: 16 %}{{ phone }}</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} ---------- FAQ ---------- {%- endcomment -%}
  <section class="td-pg-sec td-pg-sec--fog" aria-labelledby="td-pg-{{ section.id }}-faq">
    <div class="td-pg-wrap">
      <div class="td-pg-head td-pg-head--center"><div class="td-pg-head__text">
        {%- if ss.faq_eyebrow != blank -%}<p class="td-pg-eyebrow">{{ ss.faq_eyebrow }}</p>{%- endif -%}
        <h2 class="td-pg-h2" id="td-pg-{{ section.id }}-faq">{{ ss.faq_heading }}</h2>
        {%- if ss.faq_lede != blank -%}<p class="td-pg-lede">{{ ss.faq_lede }}</p>{%- endif -%}
      </div></div>
      <div class="td-pg-faq">
        {%- for block in section.blocks -%}{%- if block.type == 'faq' -%}
          <details {{ block.shopify_attributes }}>
            <summary>{{ block.settings.question }}{% render 'td-pg-icon', name: 'chevron-right', size: 18 %}</summary>
            <p>{{ block.settings.answer | replace: '[phone]', phone }}</p>
          </details>
        {%- endif -%}{%- endfor -%}
      </div>
    </div>
  </section>

  {%- comment -%} ---------- Closing CTA ---------- {%- endcomment -%}
  <section class="td-pg-sec td-pg-sec--steel" aria-labelledby="td-pg-{{ section.id }}-cta">
    <div class="td-pg-wrap td-pg-cta">
      <div class="td-pg-cta__text">
        <p class="td-pg-eyebrow td-pg-eyebrow--plain">
          {%- if ss.cta_badge != blank -%}<span class="td-pg-badge td-pg-badge--drop">{{ ss.cta_badge }}</span>{%- endif -%}
          {%- if ss.cta_eyebrow != blank -%}<span class="td-pg-inst__cta-eyebrow">{{ ss.cta_eyebrow }}</span>{%- endif -%}
        </p>
        <h2 class="td-pg-h2" id="td-pg-{{ section.id }}-cta">{{ ss.cta_heading }}</h2>
        {%- if ss.cta_lede != blank -%}<p class="td-pg-lede">{{ ss.cta_lede }}</p>{%- endif -%}
      </div>
      <div class="td-pg-btns">
        {%- if ss.cta1_label != blank -%}
          <a class="td-pg-btn td-pg-btn--primary" href="{{ ss.cta1_link | default: routes.all_products_collection_url }}">{{ ss.cta1_label }}{% render 'td-pg-icon', name: 'arrow-right', size: 18 %}</a>
        {%- endif -%}
        {%- if ss.cta2_label != blank -%}
          <a class="td-pg-btn td-pg-btn--ghost" href="{{ booking_url }}">{% render 'td-pg-icon', name: 'calendar-check', size: 18 %}{{ ss.cta2_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </section>
</div>

<style>
  /* ---- Install page only ---- */
  .td-pg-inst__lead { font-family: var(--font-heading--family, inherit); font-size: 1rem; font-weight: 700; color: #070E1A; }
  .td-pg-inst__vs { margin-top: 2.5rem; }
  .td-pg-inst__shop-lede { margin-top: .75rem !important; }
  .td-pg-inst__book { display: flex; flex-direction: column; }
  .td-pg-inst__grow { flex: 1; }
  .td-pg-inst__book-btns { display: flex; flex-direction: column; gap: .75rem; margin-top: 1.5rem; }
  .td-pg-inst__cta-eyebrow { margin-left: .5rem; }
  /* TD-FIX: positive item in the "Ship to your house" list reads like the pros column (blue check, ink text). */
  .td-pg-inst .td-pg-vs--them .td-pg-vs__pro { color: #070E1A; }
  .td-pg-inst .td-pg-vs--them .td-pg-vs__pro .td-pg-icon { color: #0068E8; }
  /* TD-FIX: town chips in balanced rows of at most five on desktop (equal-width columns sized to the
     longest name, left-aligned with the section head); phones keep the natural flex wrap. */
  @media (min-width: 1024px) {
    .td-pg-inst .td-pg-chips { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); width: max-content; max-width: 100%; }
  }
</style>

{% schema %}
{
  "name": "TireDrop install page",
  "tag": "div",
  "class": "td-pg-section",
  "settings": [
    { "type": "text", "id": "phone", "label": "Phone number", "default": "(954) 773-1896", "info": "Written anywhere copy says [phone], and dialled by the call buttons." },
    { "type": "text", "id": "booking_url", "label": "Booking link", "default": "/pages/contact?topic=install", "info": "Where every 'Book an install' button goes." },
    { "type": "text", "id": "crumb_parent", "label": "Breadcrumb parent", "default": "How shipping works" },
    { "type": "url", "id": "crumb_parent_link", "label": "Breadcrumb parent link" },
    { "type": "text", "id": "crumb", "label": "Breadcrumb label", "default": "Ship to store & install" },
    { "type": "header", "content": "Hero" },
    { "type": "text", "id": "hero_eyebrow", "label": "Eyebrow", "default": "South Florida only" },
    { "type": "text", "id": "hero_heading", "label": "Heading", "default": "Ship them to the shop. We'll fit them." },
    { "type": "textarea", "id": "hero_lede", "label": "Lede" },
    { "type": "text", "id": "hero_cta_label", "label": "Booking button", "default": "Book an install" },
    { "type": "textarea", "id": "hero_checks", "label": "Check marks (one per line)", "default": "Free ship-to-store\nOld tires recycled\nPowered by Extreme Tires" },
    { "type": "header", "content": "Local notice" },
    { "type": "text", "id": "notice_lead", "label": "Bold lead", "default": "This one is local." },
    { "type": "textarea", "id": "notice_text", "label": "Text" },
    { "type": "text", "id": "notice_link_label", "label": "Link text", "default": "your order ships to your address" },
    { "type": "url", "id": "notice_link", "label": "Link" },
    { "type": "header", "content": "How it works" },
    { "type": "text", "id": "steps_eyebrow", "label": "Eyebrow", "default": "How it works" },
    { "type": "text", "id": "steps_heading", "label": "Heading", "default": "Four steps, one address" },
    { "type": "textarea", "id": "steps_lede", "label": "Lede" },
    { "type": "text", "id": "price_lead", "label": "Price callout lead", "default": "Installation from $25 per tire." },
    { "type": "textarea", "id": "price_text", "label": "Price callout text" },
    { "type": "text", "id": "price_cta_label", "label": "Price callout button", "default": "What's included" },
    { "type": "text", "id": "price_cta_link", "label": "Price callout link", "default": "/pages/auto-service#tire-installation" },
    { "type": "header", "content": "Why ship to store" },
    { "type": "text", "id": "why_eyebrow", "label": "Eyebrow", "default": "Why bother" },
    { "type": "text", "id": "why_heading", "label": "Heading", "default": "Better than a stack of tires in your garage" },
    { "type": "textarea", "id": "why_lede", "label": "Lede" },
    { "type": "text", "id": "vs_us_heading", "label": "Comparison: left heading", "default": "Ship to the store" },
    { "type": "text", "id": "vs_them_heading", "label": "Comparison: right heading", "default": "Ship to your house" },
    { "type": "header", "content": "Install area" },
    { "type": "text", "id": "area_eyebrow", "label": "Eyebrow", "default": "Install area" },
    { "type": "text", "id": "area_heading", "label": "Heading", "default": "Where installing is on the table" },
    { "type": "textarea", "id": "area_lede", "label": "Lede" },
    { "type": "textarea", "id": "cities", "label": "Cities (one per line)", "default": "Sunrise\nPlantation\nFort Lauderdale\nDavie\nWeston\nCoral Springs\nTamarac\nLauderhill\nPembroke Pines\nMiramar" },
    { "type": "text", "id": "mobile_lead", "label": "Mobile callout lead", "default": "Rather not come in at all?" },
    { "type": "textarea", "id": "mobile_text", "label": "Mobile callout text" },
    { "type": "text", "id": "mobile_label", "label": "Mobile callout button", "default": "Mobile install" },
    { "type": "url", "id": "mobile_link", "label": "Mobile callout link" },
    { "type": "header", "content": "The shop" },
    { "type": "text", "id": "shop_eyebrow", "label": "Eyebrow", "default": "The shop" },
    { "type": "text", "id": "shop_heading", "label": "Heading", "default": "Extreme Tires — Sunrise" },
    { "type": "textarea", "id": "shop_lede", "label": "Lede" },
    { "type": "textarea", "id": "address", "label": "Address", "default": "7712 West Oakland Park Blvd\nSunrise, FL 33351" },
    { "type": "text", "id": "maps_url", "label": "Directions link", "default": "https://www.google.com/maps/search/?api=1&query=7712+West+Oakland+Park+Blvd+Sunrise+FL+33351" },
    { "type": "textarea", "id": "hours", "label": "Hours (Days | Time, one per line)", "default": "Mon – Fri | 8:00 AM – 6:30 PM\nSaturday | 8:00 AM – 4:00 PM\nSunday | Closed" },
    { "type": "text", "id": "book_heading", "label": "Booking panel heading", "default": "Book your fitting" },
    { "type": "textarea", "id": "book_text", "label": "Booking panel text" },
    { "type": "text", "id": "book_label", "label": "Booking panel button", "default": "Book an install" },
    { "type": "header", "content": "FAQ" },
    { "type": "text", "id": "faq_eyebrow", "label": "Eyebrow", "default": "Questions, answered" },
    { "type": "text", "id": "faq_heading", "label": "Heading", "default": "Before you choose ship to store" },
    { "type": "textarea", "id": "faq_lede", "label": "Lede" },
    { "type": "header", "content": "Closing band" },
    { "type": "text", "id": "cta_badge", "label": "Badge", "default": "Free" },
    { "type": "text", "id": "cta_eyebrow", "label": "Eyebrow", "default": "Ship to store" },
    { "type": "text", "id": "cta_heading", "label": "Heading", "default": "Buy them here. Fit them here." },
    { "type": "textarea", "id": "cta_lede", "label": "Lede" },
    { "type": "text", "id": "cta1_label", "label": "Primary button", "default": "Shop tires" },
    { "type": "url", "id": "cta1_link", "label": "Primary link" },
    { "type": "text", "id": "cta2_label", "label": "Booking button", "default": "Book an install" }
  ],
