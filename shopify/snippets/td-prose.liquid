{%- comment -%}
  Long-form typography for page bodies (page.content), matching the React
  legal pages: 15px/1.75 muted body copy, heavy display headings at the
  React `.h3` size, drop-coloured dot bullets and underlined drop links.

  Usage: {% render 'td-prose' %} once, then wrap the body in
    <div class="td-prose rte">{{ page.content }}</div>
  Keep the `rte` class: snippets/td-table-stack.liquid (rendered from the
  layout) targets `.rte table` to stack 3+ column tables under 750px.

  Selectors use a doubled `.td-prose.td-prose` class on purpose. Horizon's
  own `.rte` rules reach specificity (0,1,3) — `.rte :is(ul, ol):not(...)`,
  `.rte :is(p, ul, ol, table):not(.h1...) a` and friends — and would
  otherwise win over a single class. Nothing here is global: every rule is
  scoped to `.td-prose`.
{%- endcomment -%}
<style>
  .td-prose.td-prose {
    max-width: 43.25rem; /* React's 68ch article measure */
    color: #586274;
    font-family: var(--font-body--family, inherit);
    font-size: 15px;
    line-height: 1.75;
    overflow-wrap: break-word;
  }
  .td-prose.td-prose > :first-child { margin-top: 0; }
  .td-prose.td-prose > :last-child { margin-bottom: 0; }

  .td-prose.td-prose p { margin: 0 0 1rem; font-size: inherit; line-height: inherit; color: inherit; }
  .td-prose.td-prose strong, .td-prose.td-prose b { color: #070E1A; font-weight: 600; }

  .td-prose.td-prose :is(h2, h3, h4, h5, h6) {
    font-family: var(--font-heading--family, inherit);
    font-style: normal;
    font-weight: 800;
    letter-spacing: -.018em;
    text-transform: none;
    color: #070E1A;
    text-wrap: balance;
    scroll-margin-top: calc(var(--header-height, 0px) + 1.5rem);
  }
  .td-prose.td-prose h2 { font-size: 1.2rem; line-height: 1.15; margin: 3rem 0 1rem; }
  .td-prose.td-prose h3 { font-size: 1.0625rem; line-height: 1.25; margin: 2rem 0 .75rem; }
  .td-prose.td-prose :is(h4, h5, h6) { font-size: 1rem; line-height: 1.3; margin: 1.5rem 0 .5rem; }
  .td-prose.td-prose > :is(h2, h3, h4):first-child { margin-top: 0; }

  /* Links: the React legal copy uses drop blue, underlined, never colour alone. */
  .td-prose.td-prose a:not(.td-btn) {
    color: #0068E8;
    text-decoration: underline;
    text-decoration-color: currentcolor;
    text-decoration-thickness: 1px;
    text-underline-offset: .15em;
  }
  .td-prose.td-prose a:not(.td-btn):hover { color: #0053C4; text-decoration-color: currentcolor; }

  /* Bullets: 6px drop dots, 12px between items (React `space-y-3`). */
  .td-prose.td-prose ul { list-style: none; margin: 0 0 1rem; padding: 0; }
  .td-prose.td-prose ul > li { position: relative; margin: 0; padding-left: 1rem; }
  .td-prose.td-prose ul > li + li { margin-top: .75rem; }
  .td-prose.td-prose ul > li::before {
    content: ""; position: absolute; left: 0; top: .625rem;
    width: 6px; height: 6px; border-radius: 999px; background: #0068E8;
  }
  .td-prose.td-prose ol { margin: 0 0 1rem; padding: 0 0 0 1.25rem; list-style: decimal; }
  .td-prose.td-prose ol > li { padding-left: .25rem; margin: 0; }
  .td-prose.td-prose ol > li + li { margin-top: .75rem; }
  .td-prose.td-prose ol > li::marker { color: #0068E8; font-weight: 700; }
  .td-prose.td-prose li > :is(ul, ol) { margin: .75rem 0 0; }

  .td-prose.td-prose blockquote {
    margin: 1.5rem 0; padding: .25rem 0 .25rem 1rem;
    border-left: 4px solid #0068E8; color: #070E1A; font-style: normal; font-weight: 400;
  }
  .td-prose.td-prose hr { border: 0; border-top: 1px solid rgba(7,14,26,.1); margin: 3rem 0; }
  .td-prose.td-prose img { max-width: 100%; height: auto; border-radius: 12px; }

  /* Tables: React's spec-table treatment (14px, hairline row dividers, no
     uppercase shout). Under 750px td-table-stack takes over for 3+ columns. */
  .td-prose.td-prose table {
    width: 100%; margin: 0 0 1.5rem; border-collapse: collapse;
    font-size: 14px; line-height: 1.5; font-variant-numeric: tabular-nums;
    border-top: 1px solid rgba(7,14,26,.1); border-bottom: 1px solid rgba(7,14,26,.1);
  }
  .td-prose.td-prose :is(thead, tr) { background: none; font-weight: inherit; text-transform: none; }
  .td-prose.td-prose tr { border-bottom: 1px solid rgba(7,14,26,.1); }
  .td-prose.td-prose :is(th, td) { padding: .75rem 1rem .75rem 0; text-align: left; vertical-align: top; }
  .td-prose.td-prose :is(th, td):last-child { padding-right: 0; }
  .td-prose.td-prose thead th {
    font-family: var(--font-heading--family, inherit);
    font-size: 11px; font-weight: 700; letter-spacing: .07em; text-transform: uppercase; color: #586274;
  }
  .td-prose.td-prose tbody th { font-weight: 600; color: #070E1A; }
  .td-prose.td-prose td { color: #070E1A; }
  .td-prose.td-prose caption { caption-side: top; text-align: left; font-size: 13px; color: #586274; padding-bottom: .5rem; }

  /* Once td-table-stack has turned rows into cards, the cards carry their own borders. */
  @media screen and (max-width: 749px) {
    .td-prose.td-prose table.td-stack { border: 0; }
  }

  @media (min-width: 768px) {
    .td-prose.td-prose h2 { font-size: 1.45rem; }
    .td-prose.td-prose h3 { font-size: 1.125rem; }
  }
</style>
