{
  "id": "/",
  "name": "TireDrop",
  "short_name": "TireDrop",
  "description": "Tires and wheels shipped free to the 48 contiguous states and DC, or delivered free to our Sunrise, FL shop and installed for you.",
  "lang": "en-US",
  "dir": "ltr",
  "start_url": "/?source=app",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "background_color": "#070E1A",
  "theme_color": "#070E1A",
  "categories": ["shopping", "automotive"],
  "icons": [
    { "src": "/brand/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/brand/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    {
      "src": "/brand/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/brand/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Shop tires",
      "short_name": "Shop",
      "description": "Browse tires",
      "url": "/tires?source=app",
      "icons": [{ "src": "/brand/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Find my size",
      "short_name": "Size",
      "description": "Scan or look up your tire size",
      "url": "/tire-size-finder?source=app",
      "icons": [{ "src": "/brand/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "My orders",
      "short_name": "Orders",
      "description": "Check on an order",
      "url": "/track?source=app",
      "icons": [{ "src": "/brand/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Call the shop",
      "short_name": "Call",
      "description": "Phone number and hours",
      "url": "/contact?source=app",
      "icons": [{ "src": "/brand/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
